<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/margin_xl">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/margin_lg"
            android:paddingTop="@dimen/margin_xl"
            android:background="@drawable/bg_gradient_header"
            android:elevation="@dimen/card_elevation">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_bluetooth"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/margin_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_header"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_subtitle"
                    android:textColor="#B3D4FC"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- 连接状态卡片 -->
        <LinearLayout
            android:id="@+id/card_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_md"
            android:padding="@dimen/padding_md"
            android:background="@drawable/bg_status_connecting"
            android:elevation="@dimen/card_elevation">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_status_dot_connecting" />

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_sm"
                android:text="@string/connecting"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="88dp"
                android:text="@string/reconnect"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_caption"
                android:background="@drawable/bg_btn_connect"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="4dp"
                android:paddingStart="@dimen/margin_sm"
                android:paddingEnd="@dimen/margin_sm" />
        </LinearLayout>

        <!-- 文件树卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_md"
            android:padding="@dimen/padding_lg"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/card_elevation">

            <!-- 标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_folder"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/file_tree_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_refresh_tree"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_icon"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawableTint="@color/text_secondary"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />

                <TextView
                    android:id="@+id/tv_tree_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/tree_not_connected"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_sm"
                android:layout_marginBottom="@dimen/margin_sm"
                android:background="@drawable/bg_section_divider" />

            <!-- 文件树滚动区域 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/tree_height"
                android:background="@drawable/bg_tree_area"
                android:fillViewport="true"
                android:padding="2dp">

                <LinearLayout
                    android:id="@+id/lv_tree_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="240dp"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_sm" />
            </ScrollView>

            <!-- 操作按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/margin_sm"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_new_folder"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/new_folder"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_caption"
                    android:background="@drawable/bg_btn_folder"
                    android:drawableStart="@drawable/ic_folder"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="4dp"
                    android:paddingStart="@dimen/margin_sm"
                    android:paddingEnd="@dimen/margin_sm"
                    android:elevation="1dp" />

                <Button
                    android:id="@+id/btn_rename"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/rename"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_caption"
                    android:background="@drawable/bg_btn_folder"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="4dp"
                    android:paddingStart="@dimen/margin_sm"
                    android:paddingEnd="@dimen/margin_sm"
                    android:elevation="1dp" />

                <Button
                    android:id="@+id/btn_delete_node"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/delete_selected"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_caption"
                    android:background="@drawable/bg_btn_red"
                    android:drawableStart="@drawable/ic_delete"
                    android:drawableTint="@color/text_white"
                    android:drawablePadding="4dp"
                    android:paddingStart="@dimen/margin_sm"
                    android:paddingEnd="@dimen/margin_sm"
                    android:elevation="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 文件选择卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_md"
            android:padding="@dimen/padding_lg"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_file"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/file_select_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_sm"
                android:layout_marginBottom="@dimen/margin_sm"
                android:background="@drawable/bg_section_divider" />

            <TextView
                android:id="@+id/tv_selected_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_file_selected"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_body"
                android:padding="@dimen/padding_md"
                android:maxLines="2"
                android:ellipsize="middle"
                android:background="@drawable/bg_file_empty" />

            <Button
                android:id="@+id/btn_select_file"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="@dimen/margin_sm"
                android:text="@string/select_txt"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body"
                android:background="@drawable/bg_btn_outline"
                android:drawableStart="@drawable/ic_upload"
                android:drawablePadding="@dimen/margin_xs"
                android:elevation="1dp" />
        </LinearLayout>

        <!-- 目标文件夹提示 -->
        <TextView
            android:id="@+id/tv_target_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/upload_to_root"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:gravity="center"
            android:padding="@dimen/margin_sm"
            android:background="@drawable/bg_btn_folder" />

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btn_send"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_lg"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_sm"
            android:text="@string/send_to_watch"
            android:textColor="@color/text_white"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:background="@drawable/bg_send_button"
            android:drawableStart="@drawable/ic_send"
            android:drawablePadding="@dimen/margin_xs"
            android:enabled="false"
            android:elevation="3dp" />

        <!-- 传输进度卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/margin_md"
            android:layout_marginEnd="@dimen/margin_md"
            android:layout_marginTop="@dimen/margin_md"
            android:padding="@dimen/padding_lg"
            android:background="@drawable/bg_card_modern"
            android:elevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_sm"
                    android:text="@string/history_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_sm"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <!-- 传输历史列表容器 -->
            <LinearLayout
                android:id="@+id/lv_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_sm" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
