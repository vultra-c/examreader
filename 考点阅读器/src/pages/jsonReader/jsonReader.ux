<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 加载占位 -->
    <div if="{{!loaded}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="font-size: 26px; color: rgba(255,255,255,0.5);">{{ loadError || '加载中...' }}</text>
    </div>

    <!-- ============ 视图1：科目列表（闪念小抄 knowledge 页逻辑） ============ -->
    <list class="jr-list" if="{{loaded && viewMode === 'subjects'}}">
      <list-item for="{{subjects}}" tid="name" class="jr-subject-item" type="subject" @click="onSubjectClick($item)">
        <div class="jr-subject-main">
          <text class="jr-subject-name">{{$item.name}}</text>
          <text class="jr-subject-count">{{$item.count}} 条</text>
        </div>
        <img static src="/common/images/enter.png" class="jr-arrow" />
      </list-item>
    </list>

    <!-- ============ 视图2：知识点列表（条目标题 + 描述摘要） ============ -->
    <list class="jr-list" if="{{loaded && viewMode === 'list'}}">
      <list-item for="{{items}}" tid="title" class="jr-item" type="item" @click="onItemClick($item)">
        <div class="jr-item-main">
          <text class="jr-item-title">{{$item.title}}</text>
          <text class="jr-item-desc" if="{{$item.desc}}">{{$item.desc}}</text>
        </div>
        <img static src="/common/images/enter.png" class="jr-arrow" />
      </list-item>
    </list>

    <!-- ============ 视图3：详情（闪念小抄 content 页逻辑：标题/描述/原文/要点） ============ -->
    <scroll class="jr-detail-scroll" if="{{loaded && viewMode === 'detail'}}" scroll-y="{{true}}" @click="onDetailClick">
      <div style="position: absolute; width: 336px; flex-direction: column; padding: 0 20px 60px 20px;">

        <!-- 知识点头部：科目徽标 + 标题 + 描述 + 分隔线 -->
        <div class="jr-header">
          <div class="jr-subject-badge">
            <text class="jr-subject-badge-text">{{curSubject}}</text>
          </div>
          <text class="jr-title">{{curTitle}}</text>
          <text class="jr-desc" if="{{curDesc}}">{{curDesc}}</text>
          <div class="jr-divider"></div>
        </div>

        <!-- 原文（特殊标注，按字数分页） -->
        <div class="jr-raw" if="{{rawVisible}}">
          <text class="jr-raw-label" static>原文</text>
          <div class="jr-raw-paragraphs">
            <text class="jr-raw-para" for="{{visibleRawParagraphs}}">{{$item}}</text>
          </div>
          <div class="jr-raw-pager" if="{{rawTotalPages > 1}}">
            <div class="jr-pager-btn {{rawPage <= 1 ? 'jr-pager-btn--disabled' : ''}}" @click="prevRawPage">
              <text class="jr-pager-text">上一页</text>
            </div>
            <text class="jr-pager-info">第 {{rawPage}} / {{rawTotalPages}} 页</text>
            <div class="jr-pager-btn {{rawPage >= rawTotalPages ? 'jr-pager-btn--disabled' : ''}}" @click="nextRawPage">
              <text class="jr-pager-text">下一页</text>
            </div>
          </div>
        </div>

        <!-- 要点列表（编号） -->
        <div class="jr-point" for="{{curPoints}}" if="{{curPoints.length > 0}}">
          <div class="jr-point-index">
            <text class="jr-point-index-text">{{$idx + 1}}</text>
          </div>
          <text class="jr-point-text">{{$item}}</text>
        </div>

        <!-- 公式（文本形式展示） -->
        <div class="jr-formula" if="{{curFormulas.length > 0}}">
          <text class="jr-raw-label" static>公式</text>
          <text class="jr-formula-text" for="{{curFormulas}}">{{$item}}</text>
        </div>

        <!-- 空状态 -->
        <div class="jr-empty" if="{{curPoints.length === 0 && !rawVisible}}">
          <text class="jr-empty-text" static>暂无内容</text>
        </div>

      </div>
    </scroll>

    <!-- 顶部栏（与 subfolder 页一致） -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <text static style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageTitle}}</text>

  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { parseKnowledgeJson, getItems } from '../../common/utils/jsonParser.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'

// 原文分页参数（与闪念小抄 content.ux 一致：每页 320 字，按段累加不拆段）
const RAW_PAGE_CHAR_LIMIT = 320

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    loaded: false,
    loadError: '',
    // 视图状态：subjects → list → detail
    viewMode: 'subjects',
    pageTitle: '知识点',
    // 解析结果
    parsedData: null,
    subjects: [],
    // 当前科目下的条目
    items: [],
    curSubject: '',
    // 详情状态
    curTitle: '',
    curDesc: '',
    curPoints: [],
    curFormulas: [],
    rawParagraphs: [],
    visibleRawParagraphs: [],
    rawPage: 1,
    rawTotalPages: 1,
    rawVisible: false
  },
  protected: {
    path: ''
  },

  onInit() {
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    }, 60000)
    this.loadTimeFormat()
    this.loadJson()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) this.timeFormat = data
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      },
      fail: () => {}
    })
  },

  async loadJson() {
    // 读取存储的 JSON 正文（分块存储自动拼接）
    const content = await dataManager.getBluetoothFileContent(this.path)
    if (!this.$valid) return

    if (!content || content.length === 0) {
      this.loadError = '内容为空'
      this.loaded = true
      return
    }

    const result = parseKnowledgeJson(content)
    if (!this.$valid) return
    if (!result.ok) {
      const errMap = {
        'parse-fail': 'JSON 解析失败',
        'bad-structure': 'JSON 结构无效',
        'no-valid-items': '无有效知识点',
        'empty': '内容为空'
      }
      this.loadError = errMap[result.error] || '解析失败'
      this.loaded = true
      return
    }

    this.parsedData = result.data
    this.subjects = result.subjects

    // 文件名（去掉 .json 后缀）作为页面标题
    const name = dataManager.getNodeName(this.path) || '知识点'
    this.pageTitle = name.replace(/\.json$/i, '')

    // 仅一个科目时直接进入条目列表（小屏少一层点击）
    if (this.subjects.length === 1) {
      this.enterSubject(this.subjects[0].name)
    } else {
      this.viewMode = 'subjects'
      this.pageTitle = this.pageTitle + ' · 科目'
    }
    this.loaded = true
  },

  enterSubject(subjectName) {
    this.curSubject = subjectName
    this.items = getItems(this.parsedData, subjectName)
    this.viewMode = 'list'
    this.pageTitle = subjectName
  },

  // ==================== 视图1：科目列表 ====================
  onSubjectClick(item) {
    this.enterSubject(item.name)
  },

  // ==================== 视图2：知识点列表 ====================
  onItemClick(item) {
    this.openDetail(item)
  },

  // ==================== 视图3：详情 ====================
  openDetail(item) {
    this.curTitle = item.title
    this.curDesc = item.desc || ''
    this.curPoints = item.points || []
    this.curFormulas = item.formulas || []

    // 原文按 \n 切段，再按字数分页（与闪念小抄 content 页一致）
    const raw = item.raw || ''
    this.rawVisible = raw.length > 0
    this.rawParagraphs = raw.length > 0 ? raw.split('\n') : []
    this.rawPage = 1
    this._paginateRaw()

    this.viewMode = 'detail'
    this.pageTitle = this.curSubject
  },

  _paginateRaw() {
    const limit = RAW_PAGE_CHAR_LIMIT
    const pages = []
    let current = []
    let count = 0
    for (let i = 0; i < this.rawParagraphs.length; i++) {
      const para = this.rawParagraphs[i]
      // 不满一段不拆段：整段放入当前页（超长单段独占一页）
      if (count >= limit && current.length > 0) {
        pages.push(current)
        current = []
        count = 0
      }
      current.push(para)
      count += para.length
    }
    if (current.length > 0) pages.push(current)
    this.rawTotalPages = pages.length > 0 ? pages.length : 1
    this.visibleRawParagraphs = pages[this.rawPage - 1] || []
  },

  prevRawPage() {
    if (this.rawPage > 1) {
      this.rawPage--
      this._paginateRaw()
    }
  },

  nextRawPage() {
    if (this.rawPage < this.rawTotalPages) {
      this.rawPage++
      this._paginateRaw()
    }
  },

  // 详情页单击：收起/显示顶栏（与 reader 页一致的交互习惯）
  onDetailClick() {
    // 预留：详情页保持顶栏常显，点击不动作
  },

  goBack() {
    // 层级返回：detail → list → subjects → 上一页
    if (this.viewMode === 'detail') {
      this.viewMode = 'list'
      this.pageTitle = this.curSubject
      return
    }
    if (this.viewMode === 'list') {
      if (this.subjects.length === 1) {
        // 单科目文件：直接返回上一页
        router.back()
        return
      }
      this.viewMode = 'subjects'
      const name = dataManager.getNodeName(this.path) || '知识点'
      this.pageTitle = name.replace(/\.json$/i, '') + ' · 科目'
      return
    }
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      this.goBack()
    }
  },

  onBackPress() {
    this.goBack()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';

  .jr-list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }

  /* ===== 视图1：科目列表（闪念小抄 knowledge 页卡片风格） ===== */
  .jr-subject-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    margin-bottom: 10px;
    padding: 0 20px;
    background-color: #18181A;
    border-radius: 20px;
  }
  .jr-subject-main {
    flex-direction: column;
    justify-content: center;
  }
  .jr-subject-name {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: bold;
    lines: 1;
    text-overflow: ellipsis;
  }
  .jr-subject-count {
    color: #98989E;
    font-size: 20px;
    margin-top: 4px;
  }
  .jr-arrow {
    width: 36px;
    height: 36px;
  }

  /* ===== 视图2：知识点列表 ===== */
  .jr-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    margin-bottom: 10px;
    background-color: #18181A;
    border-radius: 20px;
  }
  .jr-item-main {
    flex-direction: column;
    justify-content: center;
  }
  .jr-item-title {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: bold;
    lines: 1;
    text-overflow: ellipsis;
  }
  .jr-item-desc {
    color: #98989E;
    font-size: 20px;
    margin-top: 6px;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* ===== 视图3：详情（闪念小抄 content 页风格） ===== */
  .jr-detail-scroll {
    position: absolute;
    left: 0px;
    top: 10px;
    width: 336px;
    height: 460px;
  }
  .jr-header {
    flex-direction: column;
    margin-top: 110px;
  }
  .jr-subject-badge {
    background-color: rgba(120, 153, 187, 0.16);
    border-radius: 8px;
    padding: 2px 12px;
    margin-bottom: 10px;
  }
  .jr-subject-badge-text {
    color: #7899BB;
    font-size: 20px;
    font-weight: bold;
  }
  .jr-title {
    color: #FFFFFF;
    font-size: 34px;
    font-weight: bold;
    lines: 2;
    text-overflow: ellipsis;
  }
  .jr-desc {
    color: #98989E;
    font-size: 22px;
    margin-top: 8px;
  }
  .jr-divider {
    width: 296px;
    height: 1px;
    background-color: #2A2A2E;
    margin: 14px 0 8px 0;
  }

  /* 原文区块 */
  .jr-raw {
    flex-direction: column;
    margin-top: 8px;
  }
  .jr-raw-label {
    color: #C9A86A;
    font-size: 20px;
    font-weight: bold;
    padding: 4px 12px;
    margin-bottom: 12px;
    background-color: rgba(201, 168, 106, 0.12);
    border-radius: 8px;
  }
  .jr-raw-paragraphs {
    flex-direction: column;
    width: 296px;
  }
  .jr-raw-para {
    color: #E8E8EC;
    font-size: 26px;
    line-height: 38px;
    text-align: left;
    margin-bottom: 14px;
  }
  .jr-raw-pager {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 296px;
    margin: 6px 0 16px 0;
  }
  .jr-pager-btn {
    background-color: rgba(120, 153, 187, 0.2);
    border-radius: 10px;
    padding: 6px 16px;
  }
  .jr-pager-btn--disabled {
    opacity: 0.35;
  }
  .jr-pager-text {
    color: #7899BB;
    font-size: 22px;
    font-weight: bold;
  }
  .jr-pager-info {
    color: #98989E;
    font-size: 20px;
  }

  /* 要点列表 */
  .jr-point {
    flex-direction: row;
    align-items: flex-start;
    width: 296px;
    padding: 10px 0;
  }
  .jr-point-index {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(120, 153, 187, 0.2);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
  }
  .jr-point-index-text {
    color: #7899BB;
    font-size: 22px;
    font-weight: bold;
    text-align: center;
    line-height: 40px;
  }
  .jr-point-text {
    color: #FFFFFF;
    font-size: 26px;
    flex: 1;
    line-height: 38px;
  }

  /* 公式区块 */
  .jr-formula {
    flex-direction: column;
    margin-top: 8px;
  }
  .jr-formula-text {
    color: #E8E8EC;
    font-size: 24px;
    line-height: 36px;
    margin-bottom: 10px;
  }

  /* 空状态 */
  .jr-empty {
    align-items: center;
    justify-content: center;
    padding: 40px 0;
  }
  .jr-empty-text {
    color: #98989E;
    font-size: 24px;
  }
</style>
