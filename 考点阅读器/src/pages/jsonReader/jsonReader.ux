<!--
  考点阅读器 - JSON 知识点阅读器（闪念小抄结构）
  基于 Snapnotes-band 的 content.ux 显示逻辑。
  
  v26.8.30: 新增公式图显示 + 缩放控件
-->
<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 加载占位 -->
    <div if="{{!loaded}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="font-size: 26px; color: rgba(255,255,255,0.5);">{{ loadError || '加载中...' }}</text>
    </div>

    <!-- ============ 视图1：科目列表 ============ -->
    <list class="list" if="{{loaded && viewMode === 'subjects'}}">
      <list-item for="{{subjectRows}}" tid="id" class="item" type="folder" @click="onSubjectClick($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
    </list>

    <!-- ============ 视图2：知识点条目列表 ============ -->
    <list class="list" if="{{loaded && viewMode === 'list'}}">
      <div if="{{entryRows.length === 0}}" style="position: absolute; left: 0px; top: 102px; width: 336px; height: 240px; flex-direction: column; justify-content: center; align-items: center;">
        <text static style="line-height: 36px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.4); text-align: center;">该科目暂无条目</text>
      </div>
      <list-item for="{{entryRows}}" tid="id" class="item" type="folder" @click="onItemClick($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.title}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
    </list>

    <!-- ============ 视图3：详情 ============ -->
    <scroll class="jr-detail-scroll" if="{{loaded && viewMode === 'detail'}}" scroll-y="{{true}}" @click="onDetailClick">
      <div style="position: absolute; width: 336px; flex-direction: column; padding: 0 20px 60px 20px;">

        <!-- 知识点头部 -->
        <div class="jr-header">
          <div class="jr-subject-badge">
            <text class="jr-subject-badge-text">{{curSubject}}</text>
          </div>
          <text class="jr-title">{{curTitle}}</text>
          <text class="jr-desc" if="{{curDesc}}">{{curDesc}}</text>
          <div class="jr-divider"></div>
        </div>

        <!-- 原文 -->
        <div class="jr-raw" if="{{rawVisible}}">
          <text class="jr-raw-label" static>原文</text>
          <div class="jr-raw-paragraphs">
            <text class="jr-raw-para" for="{{visibleRawParagraphs}}" style="font-size: {{fontSize}}px; line-height: {{paraLineHeight}}px;">{{$item}}</text>
          </div>
          <div class="jr-raw-pager" if="{{rawTotalPages > 1}}">
            <div class="jr-pager-btn {{rawPage <= 1 ? 'jr-pager-btn--disabled' : ''}}" @click="prevRawPage">
              <text class="jr-pager-text">上一页</text>
            </div>
            <text class="jr-pager-info">第 {{rawPage}} / {{rawTotalPages}} 页</text>
            <div class="jr-pager-btn {{rawPage >= rawTotalPages ? 'jr-pager-btn--disabled' : ''}}" @click="nextRawPage">
              <text class="jr-pager-text">下一页</text>
            </div>
          </div>
        </div>

        <!-- 要点列表 -->
        <div class="jr-point" for="{{curPoints}}" if="{{curPoints.length > 0}}">
          <div class="jr-point-index">
            <text class="jr-point-index-text">{{$idx + 1}}</text>
          </div>
          <text class="jr-point-text" style="font-size: {{fontSize}}px;">{{$item}}</text>
        </div>

        <!-- 公式文本 -->
        <div class="jr-formula" if="{{curFormulas.length > 0}}">
          <text class="jr-raw-label" static>公式</text>
          <text class="jr-formula-text" for="{{curFormulas}}">{{$item}}</text>
        </div>

        <!-- 公式图片（如有）+ 缩放控件 -->
        <div class="jr-formula-img-wrap" if="{{formulaImgSrc}}">
          <text class="jr-raw-label" static>公式图</text>
          <div class="jr-formula-img-box">
            <img class="jr-formula-img" src="{{formulaImgSrc}}" style="width: {{formulaImgW}}px; height: {{formulaImgH}}px;" />
          </div>
          <!-- 缩放控件：放大 / 缩小 / 还原 -->
          <div class="jr-zoom-controls">
            <div class="jr-zoom-btn" @click="formulaZoomIn">
              <text class="jr-zoom-btn-text">＋</text>
            </div>
            <div class="jr-zoom-btn" @click="formulaZoomReset">
              <text class="jr-zoom-btn-text">1:1</text>
            </div>
            <div class="jr-zoom-btn" @click="formulaZoomOut">
              <text class="jr-zoom-btn-text">－</text>
            </div>
          </div>
        </div>

        <!-- 空状态 -->
        <div class="jr-empty" if="{{curPoints.length === 0 && !rawVisible && !formulaImgSrc}}">
          <text class="jr-empty-text" static>暂无内容</text>
        </div>

      </div>
    </scroll>

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text static style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageTitle}}</text>

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'
import brightness from '@system.brightness'
import file from '@system.file'
import dataManager from '../../common/utils/dataManager.js'
import { getSubjects } from '../../common/utils/jsonParser.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

const RAW_PAGE_CHAR_LIMIT = 320
// 公式图默认尺寸
const FORMULA_BASE_W = 260
const FORMULA_BASE_H = 200
const ZOOM_STEP = 0.25
const ZOOM_MIN = 0.5
const ZOOM_MAX = 3.0

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    fontSize: 26,
    lineHeight: 30,
    paraLineHeight: 40,
    loaded: false,
    loadError: '',
    viewMode: 'subjects',
    pageTitle: '知识点',
    parsedData: null,
    subjectRows: [],
    entryRows: [],
    curSubject: '',
    curTitle: '',
    curDesc: '',
    curPoints: [],
    curFormulas: [],
    rawParagraphs: [],
    visibleRawParagraphs: [],
    rawPage: 1,
    rawTotalPages: 1,
    rawVisible: false,
    // 公式图
    formulaImgSrc: '',
    formulaImgW: FORMULA_BASE_W,
    formulaImgH: FORMULA_BASE_H,
    formulaZoom: 1.0,
    formulaFilePath: ''
  },
  protected: {
    path: '',
    jumpSubject: '',
    jumpIndex: -1
  },

  onInit() {
    this.nowTime = getFormattedTimeNow(this.timeFormat)
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    }, 60000)
    this.loadTimeFormat()
    this.loadDisplaySettings()
    this.loadJson()
  },

  onShow() {
    if (!this.$valid) return
    if (appState.refreshReader) {
      appState.refreshReader = false
      router.back()
      return
    }
    // 百分比跳转（jsonReaderSettings → percentJump 回跳链路）
    if (appState.jumpToPercent != null && appState.jumpToPercent !== undefined) {
      const percent = parseInt(appState.jumpToPercent)
      appState.jumpToPercent = null
      if (this.loaded) {
        this.applyJsonPercentJump(percent)
      } else {
        this._pendingPercent = percent
      }
    }
    this.loadDisplaySettings()
  },

  loadDisplaySettings() {
    storage.get({
      key: 'KD_FONT_SIZE',
      success: (data) => {
        if (!this.$valid) return
        let fs = data ? parseInt(data) : 26
        if (isNaN(fs) || fs < 20) fs = 20
        if (fs > 36) fs = 36
        this.fontSize = fs
      },
      fail: () => {
        if (!this.$valid) return
        this.fontSize = 26
      }
    })
    storage.get({
      key: 'KD_LINE_HEIGHT',
      success: (data) => {
        if (!this.$valid) return
        let lh = data ? parseInt(data) : 30
        if (isNaN(lh) || lh < 20) lh = 30
        if (lh > 50) lh = 50
        this.lineHeight = lh
        this.paraLineHeight = lh + 10
      },
      fail: () => {
        if (!this.$valid) return
        this.lineHeight = 30
        this.paraLineHeight = 40
      }
    })
    storage.get({
      key: 'KD_KEEP_SCREEN_ON',
      success: (data) => {
        if (!this.$valid) return
        brightness.setKeepScreenOn({ keepScreenOn: data === 'true' })
      },
      fail: () => {
        if (!this.$valid) return
        brightness.setKeepScreenOn({ keepScreenOn: false })
      }
    })
  },

  goSettings() {
    router.push({
      uri: '/pages/jsonReaderSettings',
      params: { path: this.path }
    })
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) this.timeFormat = data
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      },
      fail: () => {
        if (!this.$valid) return
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    })
  },

  async loadJson() {
    // 解析结果走 dataManager FIFO 缓存：重复打开/搜索共享，避免大文件反复 JSON.parse
    const result = await dataManager.getParsedKnowledge(this.path)
    if (!this.$valid) return

    if (!result || !result.ok) {
      const errMap = {
        'parse-fail': 'JSON 解析失败',
        'bad-structure': 'JSON 结构无效',
        'no-valid-items': '无有效知识点',
        'empty': '内容为空'
      }
      this.loadError = errMap[result && result.error] || '解析失败'
      this.loaded = true
      return
    }

    // parsedData/entryItems 存为非响应式实例属性：
    // 全书 JSON 结构与含全文 raw 的条目不进入框架观察，
    // 列表行只保留 {id,title,subtitle,idx} 轻量字段，点击时按 idx 回取。
    this._parsedData = result.data

    const rows = []
    const subs = result.subjects
    for (let i = 0; i < subs.length; i++) {
      rows.push({
        id: 'subj_' + i + '_' + subs[i].name,
        name: subs[i].name,
        subtitle: subs[i].count + ' 条'
      })
    }
    this.subjectRows = rows

    const name = dataManager.getNodeName(this.path) || '知识点'
    this.pageTitle = name.replace(/\.json$/i, '')

    // 搜索定位跳转：直接打开指定 科目 → 条目
    if (this.jumpSubject) {
      const js = this.jumpSubject
      const ji = (this.jumpIndex != null && this.jumpIndex !== undefined) ? this.jumpIndex : -1
      this.jumpSubject = ''
      this.jumpIndex = -1
      this.openLocatedEntry(js, ji)
    } else if (rows.length === 1) {
      this.enterSubject(rows[0].name)
    } else {
      this.viewMode = 'subjects'
      this.pageTitle = this.pageTitle + ' · 科目'
    }
    this.loaded = true

    // 页面加载完成前到达的百分比跳转请求
    if (this._pendingPercent != null && this._pendingPercent !== undefined) {
      const percent = this._pendingPercent
      this._pendingPercent = null
      this.applyJsonPercentJump(percent)
    }
  },

  enterSubject(subjectName) {
    this.curSubject = subjectName
    // parseKnowledgeJson 已完成条目清洗，直接取用，避免每次进科目重复 cleanItem
    const items = (this._parsedData && Array.isArray(this._parsedData[subjectName]))
      ? this._parsedData[subjectName]
      : []
    this._entryItems = items
    const rows = []
    for (let i = 0; i < items.length; i++) {
      rows.push({
        id: 'entry_' + i + '_' + items[i].id,
        title: items[i].title,
        subtitle: items[i].desc || '查看详情',
        idx: i
      })
    }
    this.entryRows = rows
    this.viewMode = 'list'
    this.pageTitle = subjectName
  },

  onSubjectClick(row) {
    this.enterSubject(row.name)
  },

  onItemClick(row) {
    this.openDetail(this._entryItems[row.idx])
  },

  /** 搜索结果定位：打开指定科目的指定条目 */
  openLocatedEntry(subject, idx) {
    this.enterSubject(subject)
    const items = this._entryItems || []
    if (idx >= 0 && idx < items.length) {
      this.openDetail(items[idx])
    }
  },

  /** 百分比跳转：全部条目按科目顺序展开为一维进度，跳到对应条目 */
  applyJsonPercentJump(percent) {
    if (!this._parsedData) return
    if (isNaN(percent)) percent = 0
    if (percent < 0) percent = 0
    if (percent > 100) percent = 100
    const subs = getSubjects(this._parsedData)
    let total = 0
    for (let i = 0; i < subs.length; i++) total += subs[i].count
    if (total <= 0) return
    let idx = Math.round(percent / 100 * (total - 1))
    for (let i = 0; i < subs.length; i++) {
      if (idx < subs[i].count) {
        this.enterSubject(subs[i].name)
        const items = this._entryItems || []
        if (items.length > 0) {
          this.openDetail(items[Math.min(idx, items.length - 1)])
        }
        prompt.showToast({ message: '已跳转到 ' + percent + '%', duration: 1000 })
        return
      }
      idx -= subs[i].count
    }
  },

  openDetail(item) {
    if (!item) return
    this.curTitle = item.title
    this.curDesc = item.desc || ''
    this.curPoints = item.points || []
    this.curFormulas = item.formulas || []

    // 记录一维阅读位置（percentJump 用它显示当前进度）
    const items = this._entryItems || []
    const idx = items.indexOf(item)
    if (idx >= 0) {
      const subs = getSubjects(this._parsedData)
      let base = 0
      let total = 0
      for (let i = 0; i < subs.length; i++) {
        if (subs[i].name === this.curSubject) {
          base = total
        }
        total += subs[i].count
      }
      appState.jsonIndex = base + idx
      appState.jsonTotal = total
    }

    const raw = item.raw || ''
    this.rawVisible = raw.length > 0
    this.rawParagraphs = raw.length > 0 ? raw.split('\n') : []
    this.rawPage = 1
    this._paginateRaw()

    // 重置公式图缩放
    this.formulaZoom = 1.0
    this.formulaImgW = FORMULA_BASE_W
    this.formulaImgH = FORMULA_BASE_H
    this.formulaImgSrc = ''

    // 尝试加载公式图
    this._loadFormulaImage(item)

    this.viewMode = 'detail'
    this.pageTitle = this.curSubject
  },

  /**
   * 尝试加载公式图：根据科目名和条目ID构造文件名，
   * 检查 internal://files/formulas/ 下是否有对应图片。
   * 命名规则：{subject}_{id}.png
   */
  _loadFormulaImage(item) {
    if (!item || !item.id) return
    const subject = this.curSubject || ''
    const id = item.id
    // 常见文件名模式
    const candidates = [
      subject + '_' + id + '.png',
      subject + '_' + id + '.jpg',
      id + '.png',
      id + '.jpg'
    ]
    this._tryFormulaFile(candidates, 0)
  },

  _tryFormulaFile(candidates, index) {
    if (index >= candidates.length) return
    const fileName = candidates[index]
    const fileUri = 'internal://files/formulas/' + fileName
    file.get({
      uri: fileUri,
      success: () => {
        // 文件存在
        if (!this.$valid) return
        this.formulaFilePath = fileUri
        this.formulaImgSrc = fileUri
        // 按屏幕宽度适配
        this.formulaImgW = FORMULA_BASE_W
        this.formulaImgH = FORMULA_BASE_H
        this.formulaZoom = 1.0
      },
      fail: () => {
        // 文件不存在，尝试下一个候选名
        this._tryFormulaFile(candidates, index + 1)
      }
    })
  },

  // ==================== 公式图缩放 ====================

  formulaZoomIn() {
    if (this.formulaZoom < ZOOM_MAX) {
      this.formulaZoom = Math.min(ZOOM_MAX, this.formulaZoom + ZOOM_STEP)
      this.formulaImgW = Math.round(FORMULA_BASE_W * this.formulaZoom)
      this.formulaImgH = Math.round(FORMULA_BASE_H * this.formulaZoom)
    }
  },

  formulaZoomOut() {
    if (this.formulaZoom > ZOOM_MIN) {
      this.formulaZoom = Math.max(ZOOM_MIN, this.formulaZoom - ZOOM_STEP)
      this.formulaImgW = Math.round(FORMULA_BASE_W * this.formulaZoom)
      this.formulaImgH = Math.round(FORMULA_BASE_H * this.formulaZoom)
    }
  },

  formulaZoomReset() {
    this.formulaZoom = 1.0
    this.formulaImgW = FORMULA_BASE_W
    this.formulaImgH = FORMULA_BASE_H
  },

  // ==================== 原文分页 ====================

  _paginateRaw() {
    const limit = RAW_PAGE_CHAR_LIMIT
    const pages = []
    let current = []
    let count = 0
    for (let i = 0; i < this.rawParagraphs.length; i++) {
      const para = this.rawParagraphs[i]
      if (count >= limit && current.length > 0) {
        pages.push(current)
        current = []
        count = 0
      }
      current.push(para)
      count += para.length
    }
    if (current.length > 0) pages.push(current)
    this.rawTotalPages = pages.length > 0 ? pages.length : 1
    this.visibleRawParagraphs = pages[this.rawPage - 1] || []
  },

  prevRawPage() {
    if (this.rawPage > 1) {
      this.rawPage--
      this._paginateRaw()
    }
  },

  nextRawPage() {
    if (this.rawPage < this.rawTotalPages) {
      this.rawPage++
      this._paginateRaw()
    }
  },

  onDetailClick() {
    // 预留
  },

  goBack() {
    if (this.viewMode === 'detail') {
      this.viewMode = 'list'
      this.pageTitle = this.curSubject
      return
    }
    if (this.viewMode === 'list') {
      if (this.subjectRows.length === 1) {
        router.back()
        return
      }
      this.viewMode = 'subjects'
      const name = dataManager.getNodeName(this.path) || '知识点'
      this.pageTitle = name.replace(/\.json$/i, '') + ' · 科目'
      return
    }
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      this.goBack()
    }
  },

  onBackPress() {
    this.goBack()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';

  .jr-detail-scroll {
    position: absolute;
    left: 0px;
    top: 10px;
    width: 336px;
    height: 460px;
  }
  .jr-header {
    flex-direction: column;
    margin-top: 86px;
  }
  .jr-subject-badge {
    background-color: rgba(120, 153, 187, 0.16);
    border-radius: 8px;
    padding: 2px 12px;
    margin-bottom: 10px;
  }
  .jr-subject-badge-text {
    color: #7899BB;
    font-size: 20px;
    font-weight: bold;
  }
  .jr-title {
    color: #FFFFFF;
    font-size: 34px;
    font-weight: bold;
    lines: 2;
    text-overflow: ellipsis;
  }
  .jr-desc {
    color: #98989E;
    font-size: 22px;
    line-height: 32px;
    margin-top: 8px;
    lines: 3;
    text-overflow: ellipsis;
  }
  .jr-divider {
    width: 296px;
    height: 1px;
    background-color: #2A2A2E;
    margin: 14px 0 8px 0;
  }

  .jr-raw {
    flex-direction: column;
    margin-top: 8px;
    width: 296px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .jr-raw-label {
    color: #C9A86A;
    font-size: 20px;
    font-weight: bold;
    padding: 4px 12px;
    margin-bottom: 12px;
    background-color: rgba(201, 168, 106, 0.12);
    border-radius: 8px;
  }
  .jr-raw-paragraphs {
    flex-direction: column;
  }
  .jr-raw-para {
    color: #E8E8EC;
    font-size: 26px;
    line-height: 38px;
    text-align: left;
    margin-bottom: 14px;
  }
  .jr-raw-pager {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0 4px 0;
  }
  .jr-pager-btn {
    background-color: rgba(120, 153, 187, 0.2);
    border-radius: 12px;
    width: 110px;
    height: 56px;
    align-items: center;
    justify-content: center;
  }
  .jr-pager-btn--disabled {
    opacity: 0.35;
  }
  .jr-pager-text {
    color: #7899BB;
    font-size: 22px;
    font-weight: bold;
    text-align: center;
  }
  .jr-pager-info {
    color: #98989E;
    font-size: 20px;
  }

  .jr-point {
    flex-direction: row;
    align-items: flex-start;
    width: 296px;
    padding: 10px 0;
  }
  .jr-point-index {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(120, 153, 187, 0.2);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
  }
  .jr-point-index-text {
    color: #7899BB;
    font-size: 22px;
    font-weight: bold;
    text-align: center;
    line-height: 40px;
  }
  .jr-point-text {
    color: #FFFFFF;
    font-size: 26px;
    flex: 1;
    line-height: 38px;
  }

  .jr-formula {
    flex-direction: column;
    margin-top: 12px;
    width: 296px;
