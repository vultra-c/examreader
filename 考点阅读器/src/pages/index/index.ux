<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态 -->
    <div if="{{allItems.length == 0 && !loading}}" style="position: absolute; left: 0px; top: 102px; width: 336px; height: 240px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 96px; height: 96px;" />
      <text static style="line-height: 36px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.4); text-align: center; margin-top: 16px;">没有文件</text>
    </div>

    <!-- 加载中 -->
    <div if="{{loading}}" style="position: absolute; left: 0px; top: 102px; width: 336px; height: 240px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="line-height: 36px; font-size: 22px; color: rgba(255,255,255,0.4); text-align: center;">加载中...</text>
    </div>

    <!-- 文件夹列表（分块渲染） -->
    <list class="list" id="homeList" if="{{visibleItems.length > 0}}" onscrollbottom="onReachBottom">
      <!-- 最近阅读分区标签（列表最顶部） -->
      <list-item if="{{recentItem && !sortMode}}" class="item" type="recent" @click="onRecentClick">
        <div class="item-content">
          <text class="itemtext">{{recentItem.name}}</text>
          <text class="itemtext2">{{recentItem.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <list-item if="{{recentItem && !sortMode}}" class="item" style="padding: 7px 16px; height: 50px;" type="section">
        <text class="section-title" static>全部文件</text>
      </list-item>


      <list-item for="{{visibleItems}}" tid="id" class="item {{sortMode ? 'item--sort' : ''}}" type="folder" @click="onItemClick($item)" @longpress="onLongPress($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2" if="{{!sortMode}}">{{$item.subtitle}}</text>
        </div>
        <!-- 排序模式：↑↓ 按钮放大占满行高，右半边整块可点 -->
        <div if="{{sortMode}}" class="sort-btn-col" @click="moveItem($item, -1)">
          <text class="sort-btn-text" static>↑</text>
        </div>
        <div if="{{sortMode}}" class="sort-btn-col sort-btn-col--divider" @click="moveItem($item, 1)">
          <text class="sort-btn-text" static>↓</text>
        </div>
        <img if="{{!sortMode}}" static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <!-- 加载更多指示 -->
      <list-item if="{{hasMore}}" type="more" class="item" @click="loadMore">
        <div class="item-content">
          <text class="itemtext2">▼ 加载更多 ({{allItems.length - visibleItems.length}})</text>
        </div>
      </list-item>
    </list>

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="onBackAction" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">主页</text>

    <!-- 右下角全局搜索图标 -->
    <img if="{{!sortMode}}" static src="/common/images/search.png" @click="goSearch" style="position: absolute; left: 258px; top: 402px; width: 72px; height: 72px;" />

  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'
import jumpBus from '../../common/utils/jumpBus.js'

// 分块渲染参数：首屏 20 条，滚动加载更多
const CHUNK_SIZE = 20
// 最近阅读记录键
const KEY_RECENT = 'KD_RECENT_READ'
// 阅读进度键（与 reader 共用 KD_READING_PROGRESS，此处仅读）

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    allItems: [],
    visibleItems: [],
    hasMore: false,
    loading: true,
    isNavigating: false,
    longPressTriggered: false,
    renderPos: 0,
    // 最近阅读
    recentItem: null,
    // 排序模式
    sortMode: false
  },

  onInit() {
    this.loadTimeFormat()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    }, 60000)
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
        }
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      },
      fail: () => {
        if (!this.$valid) return
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.longPressTriggered = false
    if (appState.needRefreshList) {
      appState.needRefreshList = false
    }
    this.loadData()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  async loadData() {
    this.loading = true
    // 并发：顶层文件夹列表 + 蓝牙 meta（最近阅读复用）
    const [folders, meta] = await Promise.all([
      dataManager.getTopLevelFolders(),
      dataManager.getBluetoothMeta()
    ])
    if (!this.$valid) return

    const items = []
    if (folders) {
      for (let i = 0; i < folders.length; i++) {
        const folder = folders[i]
        const isJson = folder.fmt === 'json'
        const subtitle = folder.type === 'folder' ? '文件夹' : (isJson ? '知识点 JSON' : '考点')
        items.push({
          id: folder.id,
          name: folder.name,
          subtitle: subtitle,
          type: folder.type || 'content',
          fmt: folder.fmt || '',
          path: folder.id
        })
      }
    }

    this.allItems = items
    this.renderPos = 0
    this.visibleItems = []
    this.loading = false
    this.appendVisibleChunk()
    this.loadRecent(meta)
  },

  /** 读取最近阅读，meta 传入可复用 loadData 的并发结果，避免重复 storage 读 */
  async loadRecent(metaHint) {
    const rec = await new Promise((resolve) => {
      storage.get({
        key: KEY_RECENT,
        success: (d) => {
          if (!d) { resolve(null); return }
          try { resolve(JSON.parse(d)) } catch (e) { resolve(null) }
        },
        fail: () => resolve(null)
      })
    })
    if (!this.$valid) return
    if (!rec || !rec.path) {
      this.recentItem = null
      return
    }
    // 优先用 loadData 传入的 meta 缓存；缺失才现场拉
    let meta = metaHint
    if (!meta) {
      meta = await dataManager.getBluetoothMeta()
      if (!this.$valid) return
    }
    let name = rec.name || ''
    let fmt = rec.fmt || ''
    if (meta) {
      for (let i = 0; i < meta.length; i++) {
        if (meta[i].id === rec.path) {
          name = meta[i].name
          fmt = meta[i].fmt || ''
          break
        }
      }
    }
    // 读取进度（txt / json 共用），存起来给 onRecentClick 跳转用
    let subtitle = fmt === 'json' ? '知识点 JSON · 继续上次' : '继续上次阅读'
    let progress = null
    if (fmt !== 'json') {
      progress = await dataManager.getReadingProgress(rec.path)
      if (!this.$valid) return
      if (typeof progress === 'number' && progress > 0) {
        subtitle = '读到第 ' + (progress + 1) + ' 页 · 点击继续'
      } else if (progress && typeof progress === 'object' && progress.mode === 'seam') {
        subtitle = '无缝模式 · 继续上次位置'
      }
    } else {
      progress = await dataManager.getReadingProgress(rec.path)
      if (!this.$valid) return
      if (progress && typeof progress === 'object' && progress.mode === 'json') {
        const subj = progress.subject || ''
        const idx = (typeof progress.idx === 'number') ? progress.idx : -1
        if (subj && idx >= 0) {
          subtitle = subj + ' · 第 ' + (idx + 1) + ' 条 · 点击继续'
        }
      }
    }
    this.recentItem = { path: rec.path, name: name || '上次阅读', subtitle: subtitle, fmt: fmt, progress: progress }
  },

  onRecentClick() {
    if (!this.recentItem) return
    const path = this.recentItem.path
    const fmt = this.recentItem.fmt
    const progress = this.recentItem.progress
    // 先把跳转请求写入邮箱（reader/jsonReader.onShow 或 pagesLoaded 后消费），再跳转
    if (fmt === 'json') {
      if (progress && typeof progress === 'object' && progress.mode === 'json') {
        const idx = (typeof progress.idx === 'number') ? progress.idx : -1
        if (progress.subject && idx >= 0) {
          jumpBus.requestJump({
            type: 'json',
            subject: progress.subject,
            index: idx,
            path: path
          })
        }
      }
      router.push({ uri: '/pages/jsonReader', params: { path: path } })
    } else {
      // txt: 页码 / 无缝字符偏移（用 percent 即可近似；页码精确）
      if (typeof progress === 'number' && progress >= 0) {
        jumpBus.requestJump({ type: 'page', value: progress, path: path })
      } else if (progress && typeof progress === 'object' && progress.mode === 'seam') {
        const offset = progress.offset || 0
        jumpBus.requestJump({ type: 'char', value: offset, path: path })
      }
      router.push({ uri: '/pages/reader', params: { path: path } })
    }
  },

  appendVisibleChunk() {
    const start = this.renderPos
    const end = Math.min(start + CHUNK_SIZE, this.allItems.length)
    const newItems = this.allItems.slice(start, end)
    if (newItems.length > 0) {
      this.visibleItems = this.visibleItems.concat(newItems)
      this.renderPos = end
    }
    this.hasMore = this.renderPos < this.allItems.length
  },

  onReachBottom() {
    if (this.hasMore) {
      this.appendVisibleChunk()
    }
  },

  loadMore() {
    this.appendVisibleChunk()
  },

  onItemClick(item) {
    if (this.isNavigating) return
    if (this.longPressTriggered) {
      this.longPressTriggered = false
      return
    }
    // 排序模式下点击条目不开详情（↑/↓ 按钮冒泡过来的 click 也走这里被拦）
    if (this.sortMode) return
    this.isNavigating = true
    setTimeout(() => { if (this.$valid) this.isNavigating = false }, 2000)

    if (item.type === 'folder') {
      router.push({
        uri: '/pages/subfolder',
        params: { path: item.id }
      })
    } else if (item.fmt === 'json') {
      router.push({
        uri: '/pages/jsonReader',
        params: { path: item.id }
      })
    } else {
      router.push({
        uri: '/pages/reader',
        params: { path: item.id }
      })
    }
  },

  /** 长按：
   *  - 正常模式 → 进入排序模式
   *  - 排序模式 → 删除该条目（替代旧版长按删除入口）
   */
  onLongPress(item) {
    if (this.isNavigating) return
    this.longPressTriggered = true
    this.isNavigating = true
    setTimeout(() => { if (this.$valid) this.isNavigating = false }, 2000)
    if (this.sortMode) {
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
          path: item.id,
          name: item.name
        }
      })
      return
    }
    // 长按进入排序模式
    this.sortMode = true
  },

  /** 排序模式：上移/下移。加 150ms 节流防连点，持久化 seq 后原位交换数组元素 */
  async moveItem(item, delta) {
    if (this._moving) return
    this._moving = true
    setTimeout(() => { this._moving = false }, 150)
    const ok = await dataManager.moveBluetoothNode(item.id, delta)
    if (!this.$valid) return
    if (ok) {
      const idx = this.allItems.indexOf(item)
      const target = idx + delta
      if (target >= 0 && target < this.allItems.length) {
        const t = this.allItems[target]
        this.allItems.splice(target, 1, item)
        this.allItems.splice(idx, 1, t)
        // 重建可见列表清空 setData 触发区域（原数组引用保持）
        this.renderPos = 0
        this.visibleItems = []
        this.appendVisibleChunk()
      }
    }
  },

  /** 顶栏返回：排序模式先退出排序 */
  onBackAction() {
    if (this.sortMode) {
      this.sortMode = false
      return
    }
    app.terminate()
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  goSearch() {
    router.push({ uri: '/pages/search', params: { scope: 'global' } })
  },

  exitApp() {
    app.terminate()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      if (this.sortMode) {
        this.sortMode = false
        return
      }
      app.terminate()
    }
  },

  onBackPress() {
    if (this.sortMode) {
      this.sortMode = false
      return true
    }
    app.terminate()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
  /* 排序模式 item：更高（让 100% 高度按钮更宽更好点），不显示 subtitle 给按钮腾位 */
  .item--sort {
    height: 116px;
  }
  /* ↑↓ 按钮列：占满行高，宽度 76px，背景与 item 同款蓝色 22% 透明度，右侧分割线区分两个按钮 */
  .sort-btn-col {
    width: 76px;
    height: 100%;
    background-color: rgba(13, 110, 255, 0.22);
    justify-content: center;
    align-items: center;
  }
  .sort-btn-col--divider {
    background-color: rgba(13, 110, 255, 0.32);
  }
  .sort-btn-text {
    font-size: 36px;
    font-weight: bold;
    color: #4DA3FF;
    text-align: center;
  }
</style>
