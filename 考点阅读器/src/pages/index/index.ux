<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态 -->
    <div if="{{allItems.length == 0}}" style="position: absolute; left: 0px; top: 102px; width: 336px; height: 240px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 96px; height: 96px;" />
      <text static style="line-height: 36px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.4); text-align: center; margin-top: 16px;">没有文件</text>
    </div>

    <!-- 文件夹列表 -->
    <list class="list" id="homeList" if="{{allItems.length > 0}}">
      <list-item for="{{visibleItems}}" tid="id" class="item" type="folder" @click="onItemClick($item)" @longpress="onLongPress($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
    </list>

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="exitApp" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">主页</text>

  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'
import dataManager from '../../common/utils/dataManager.js'
import { getNowTime } from '../../common/utils/timeUtil.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    allItems: [],
    visibleItems: [],
    currentPage: 0,
    totalPages: 1,
    totalItems: 0,
    pageSize: 3,
    isNavigating: false,
    longPressTriggered: false
  },

  onInit() {
    this.nowTime = getNowTime()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getNowTime()
      }
    }, 60000)
  },

  onShow() {
    this.isNavigating = false
    this.longPressTriggered = false
    this.currentPage = 0
    this.loadData()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  async loadData() {
    const folders = await dataManager.getTopLevelFolders()
    if (!this.$valid) return

    // 构建列表项
    const items = []

    // 添加知识树文件夹
    if (folders) {
      folders.forEach((folder, index) => {
        items.push({
          id: folder.id,
          name: folder.name,
          subtitle: folder.id === 'bt_folder' ? '蓝牙传输' : '文件夹',
          type: 'folder',
          path: folder.id === 'bt_folder' ? 'bt' : index.toString()
        })
      })
    }

    this.allItems = items
    this.totalItems = this.allItems.length
    this.loadPage(this.currentPage)
  },

  loadPage(page) {
    this.totalPages = Math.ceil(this.allItems.length / this.pageSize) || 1
    let safePage = Math.max(0, Math.min(page, this.totalPages - 1))
    const start = safePage * this.pageSize
    this.visibleItems = this.allItems.slice(start, start + this.pageSize)
    this.currentPage = safePage
  },

  onItemClick(item) {
    if (this.isNavigating) return
    // 如果长按刚刚触发，阻止click事件
    if (this.longPressTriggered) {
      this.longPressTriggered = false
      return
    }
    this.isNavigating = true

    router.push({
      uri: '/pages/subfolder',
      params: { path: item.path }
    })
  },

  onLongPress(item) {
    if (this.isNavigating) return
    // 标记长按已触发，阻止后续click事件
    this.longPressTriggered = true
    this.isNavigating = true
    router.push({
      uri: '/pages/deleteConfirm',
      params: { action: 'deleteFolder', path: item.path, name: item.name }
    })
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  exitApp() {
    app.terminate()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      app.terminate()
    }
  },

  onBackPress() {
    app.terminate()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
</style>
