<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- 空状态：文件夹为空 -->
    <div if="{{allItems.length == 0 && !loading}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <img static src="/common/images/empty_state.png" style="width: 128px; height: 128px;" />
      <text static style="line-height: 42px; font-weight: bold; font-size: 28px; color: rgba(255,255,255,0.6); text-align: center; margin-top: 24px;">没有文件</text>
    </div>

    <!-- 加载中 -->
    <div if="{{loading}}" style="position: absolute; width: 336px; height: 480px; flex-direction: column; justify-content: center; align-items: center;">
      <text static style="line-height: 42px; font-size: 22px; color: rgba(255,255,255,0.4); text-align: center;">加载中...</text>
    </div>

    <!-- 文件夹/考点列表（分块渲染） -->
    <list class="list" if="{{visibleItems.length > 0}}" id="subList" onscrollbottom="onReachBottom">
      <list-item for="{{visibleItems}}" tid="id" class="item" type="item" @click="onItemClick($item)" @longpress="onLongPress($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.name}}</text>
          <text class="itemtext2">{{$item.subtitle}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
      <list-item if="{{hasMore}}" type="more" class="item" @click="loadMore">
        <div class="item-content">
          <text class="itemtext2">▼ 加载更多 ({{allItems.length - visibleItems.length}})</text>
        </div>
      </list-item>
    </list>

    <!-- 右下角搜索图标 -->
    <img static src="/common/images/search.png" @click="goSearch" style="position: absolute; left: 258px; top: 402px; width: 72px; height: 72px;" />

    <!-- 顶部栏 -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <img static src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 6px; width: 180px; line-height: 30px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text style="position: absolute; left: 78px; top: 36px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'

const CHUNK_SIZE = 20

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    pageName: '',
    allItems: [],
    visibleItems: [],
    hasMore: false,
    loading: true,
    renderPos: 0,
    isNavigating: false,
    longPressTriggered: false
  },
  protected: {
    path: ''
  },

  onInit() {
    this.loadTimeFormat()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    }, 60000)
    this.pageName = dataManager.getNodeName(this.path) || '文件夹'
  },

  loadTimeFormat() {
    storage.get({
      key: 'KD_TIME_FORMAT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.timeFormat = data
        }
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      },
      fail: () => {
        if (!this.$valid) return
        this.nowTime = getFormattedTimeNow(this.timeFormat)
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.longPressTriggered = false
    this.loadData()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  async loadData() {
    this.loading = true
    const children = await dataManager.getVisibleChildren(this.path)
    if (!this.$valid) return
    const items = children || []
    for (let i = 0; i < items.length; i++) {
      const it = items[i]
      it.subtitle = it.type === 'folder' ? '文件夹' : (it.fmt === 'json' ? '知识点 JSON' : '考点')
    }
    this.allItems = items
    this.renderPos = 0
    this.visibleItems = []
    this.loading = false
    this.appendVisibleChunk()
  },

  appendVisibleChunk() {
    const start = this.renderPos
    const end = Math.min(start + CHUNK_SIZE, this.allItems.length)
    const newItems = this.allItems.slice(start, end)
    if (newItems.length > 0) {
      this.visibleItems = this.visibleItems.concat(newItems)
      this.renderPos = end
    }
    this.hasMore = this.renderPos < this.allItems.length
  },

  onReachBottom() {
    if (this.hasMore) {
      this.appendVisibleChunk()
    }
  },

  loadMore() {
    this.appendVisibleChunk()
  },

  onItemClick(item) {
    if (this.isNavigating) return
    if (this.longPressTriggered) {
      this.longPressTriggered = false
      return
    }
    this.isNavigating = true

    setTimeout(() => { if (this.$valid) this.isNavigating = false }, 2000)

    if (this.path && this.path.startsWith('bt_')) {
      if (item.type === 'folder') {
        router.push({ uri: '/pages/subfolder', params: { path: item.id } })
      } else if (item.fmt === 'json') {
        router.push({ uri: '/pages/jsonReader', params: { path: item.id } })
      } else {
        router.push({ uri: '/pages/reader', params: { path: item.id } })
      }
      return
    }

    if (this.path === 'builtin') {
      router.push({ uri: '/pages/reader', params: { path: item.id } })
      return
    }

    const index = this.allItems.indexOf(item)
    const childPath = this.path + ',' + index

    if (item.type === 'folder') {
      router.push({
        uri: '/pages/subfolder',
        params: { path: childPath }
      })
    } else {
      router.push({
        uri: '/pages/reader',
        params: { path: childPath }
      })
    }
  },

  goSettings() {
    router.push({ uri: '/pages/globalSettings' })
  },

  goSearch() {
    router.push({
      uri: '/pages/search',
      params: { scope: 'folder', searchPath: this.path }
    })
  },

  onLongPress(item) {
    if (this.isNavigating) return

    if (this.path === 'builtin') {
      return
    }

    this.longPressTriggered = true
    this.isNavigating = true

    setTimeout(() => { if (this.$valid) this.isNavigating = false }, 2000)

    if (this.path && this.path.startsWith('bt_')) {
      router.push({
        uri: '/pages/deleteConfirm',
        params: {
          action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
          path: item.id,
          name: item.name
        }
      })
      return
    }

    const index = this.allItems.indexOf(item)
    const childPath = this.path + ',' + index
    router.push({
      uri: '/pages/deleteConfirm',
      params: {
        action: item.type === 'folder' ? 'deleteFolder' : 'deleteContent',
        path: childPath,
        name: item.name
      }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
  .list {
    height: 394px;
    top: 86px;
    padding: 0px 6px;
  }
</style>
