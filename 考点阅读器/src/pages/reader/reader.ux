<template>
  <div class="page">

    <!-- 无缝模式（V26.8.3 回归全量渲染）：
         本固件在滚动中动态换段/追加内容不可靠（多次验证均为「只渲染首段、无法继续滚动」），
         V26.5 全量渲染实测正常。这里全文切成渲染块全量渲染，超长段按 400 字切块
         避免单 text 节点过大，DOM 与文件行数成正比，滚动稳定不卡顿不叠字。 -->
    <scroll
      id="seamlessScroll"
      if="{{modesLoaded && readingMode === 'seamless'}}"
      style="position: absolute; width: 336px; height: 460px; top: 10px;"
      scroll-y="{{true}}"
      scroll-top="{{seamlessScrollTopValue}}"
      @scroll="onScroll"
      @scrollbottom="onReachBottom"
      @click="onTxtClick"
    >
      <div id="seamlessContainer" style="position: absolute; width: 336px; flex-direction: column;">
        <div for="{{seamlessBlocks}}" style="width: 336px; flex-direction: column;">
          <text style="width: 336px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px; padding-left: 20px; padding-right: 20px;">{{$item}}</text>
        </div>
        <div style="width: 336px; height: 40px;"></div>
      </div>
    </scroll>

    <!-- 分页模式：scroll + text（仅渲染当前页内容） -->
    <scroll if="{{modesLoaded && readingMode !== 'seamless'}}"
            id="contentScroll" scroll-y="{{true}}"
            @click="onTxtClick"
            @scroll="onScroll"
            @scrollbottom="onReachBottom"
            style="position: absolute; left: 0px; top: 10px; width: 336px; height: 460px;">
      <div style="position: absolute; width: 336px; flex-direction: column; padding-left: 20px; padding-right: 20px; padding-bottom: 40px;">
        <text style="width: 296px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px;">{{currentPageContent}}</text>
      </div>
    </scroll>

    <!-- 顶部遮罩栏 — show 控制（复刻弦电子书 detail.ux showSetting 模式）
         注意：不能使用 static 属性，否则 show 不会动态更新
         @swipe 放在遮罩栏上，仅在 UI 显示时生效，不干扰 scroll 的垂直滑动 -->
    <img show="{{showSetting}}" src="/common/images/hd.png" @swipe="onSwipe" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />

    <!-- 返回按钮 -->
    <img show="{{showSetting}}" src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />

    <!-- 更多按钮 -->
    <img show="{{showSetting}}" src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />

    <!-- 时间和文件名（居中显示，宽度 180px 与其他页面一致） -->
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

    <!-- 底部遮罩栏（复刻弦电子书 detail.ux 底部栏）
         @swipe 放在底部遮罩栏上，仅在 UI 显示时生效 -->
    <img show="{{showSetting}}" src="/common/images/bt.png" @swipe="onSwipe" style="position: absolute; left: 0px; top: 378px; width: 336px; height: 102px;" />

    <!-- 底部翻页信息（仅分页模式；modesLoaded 前不渲染，避免打开时闪现阅读进度） -->
    <div show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated'}}" style="position: absolute; top: 402px; left: 78px; width: 180px; height: 72px; flex-direction: column; justify-content: flex-start; align-items: center;">
      <text style="line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">{{currentPage + 1}} / {{totalPages}}</text>
    </div>

    <!-- 底部上一页按钮（仅分页模式） -->
    <img show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated' && currentPage > 0}}" src="/common/images/pre.png" @click="prevPage" style="position: absolute; left: 6px; top: 402px; width: 72px; height: 72px;" />

    <!-- 底部下一页按钮（仅分页模式） -->
    <img show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated' && currentPage < totalPages - 1}}" src="/common/images/next.png" @click="nextPage" style="position: absolute; left: 258px; top: 402px; width: 72px; height: 72px;" />

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'
import brightness from '@system.brightness'
import dataManager from '../../common/utils/dataManager.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    pageName: '全文',
    pages: [],
    currentPageContent: '',
    currentPage: 0,
    totalPages: 1,
    showSetting: true,
    atScrollBottom: false,
    fontSize: 26,
    lineHeight: 30,
    contentName: '',
    pendingJump: null,
    pagesLoaded: false,
    // 无缝模式相关（V26.8.3 回归全量渲染：本固件滚动中动态换段不可靠，全量渲染实测稳定）
    modesLoaded: false,
    readingMode: '',
    fullContent: '',
    readingPercent: 0,
    modeChanged: false,
    seamlessBlocks: [],
    seamlessScrollTopValue: 0,
    seamlessScrollTop: 0,
    seamlessMaxScroll: 1
  },
  protected: {
    path: '',
    targetPage: -1
  },

  onInit() {
    // 同步先给正确时间（避免设置栏唤出后短暂显示 00:00）
    this.nowTime = getFormattedTimeNow(this.timeFormat)
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
        // 无缝模式定期保存滚动进度
        if (this.readingMode === 'seamless') {
          this.saveProgress()
        }
      }
    }, 60000)
    this.initReader()
  },

  async initReader() {
    await this.loadSettingsBatch()
    if (!this.$valid) return
    await this.loadContent()
    if (!this.$valid) return

    // 搜索结果跳转：直接跳到指定页码
    if (this.targetPage != null && this.targetPage >= 0 && this.targetPage < this.totalPages) {
      this.currentPage = this.targetPage
      this.targetPage = -1
      this.updatePageContent()
      this.saveProgress()
      return
    }

    await this.loadReadingProgress()
  },

  async onShow() {
    if (!this.$valid) return
    // 删除内容后自动返回上级
    if (appState.refreshReader) {
      appState.refreshReader = false
      router.back()
      return
    }
    // initReader 还没完成（异步），第一次 onShow 直接跳过
    // initReader 会完成所有初始化（包括搜索跳转）
    if (!this.pagesLoaded) return

    // 以下逻辑仅在页面已加载后再次 onShow 时执行（如从 readerSettings 返回）
    const fontChanged = await this.loadSettingsBatch()
    if (!this.$valid) return

    // 阅读模式变化：重新加载内容
    if (this.modeChanged) {
      this.modeChanged = false
      await this.loadContent()
      if (!this.$valid) return

      await this.loadReadingProgress()
      this.applyJumpToPage()
      return
    }

    // 字号变化：分页模式动态重新分页；无缝模式重算索引与分段并保持当前进度
    if (fontChanged && this.pagesLoaded) {
      if (this.readingMode === 'paginated') {
        await this.loadContent()
        if (!this.$valid) return
        this.saveProgress()
      } else if (this.readingMode === 'seamless' && this.seamlessBlocks.length > 0) {
        // 字号变化：重算总滚动范围，保持当前位置
        this.seamlessMaxScroll = this.estimateMaxScroll(this.fullContent)
        this.updateSeamlessPercent(this.seamlessScrollTop || 0)
        this.saveProgress()
      }
    }
    // 处理跳页请求（pageJump / percentJump）
    this.applyJumpToPage()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    this.saveProgress()
  },

  storageGet(key) {
    return new Promise((resolve) => {
      storage.get({
        key: key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      })
    })
  },

  async loadSettingsBatch() {
    // 合并多次 storage 读取为并发批量读取
    const results = await Promise.all([
      this.storageGet('KD_FONT_SIZE'),
      this.storageGet('KD_LINE_HEIGHT'),
      this.storageGet('KD_KEEP_SCREEN_ON'),
      this.storageGet('KD_TIME_FORMAT'),
      this.storageGet('KD_READING_MODE')
    ])
    if (!this.$valid) return false

    const fontSizeStr = results[0]
    const lineHeightStr = results[1]
    const keepOnStr = results[2]
    const timeFormatStr = results[3]
    const readingModeStr = results[4]

    let fontSize = fontSizeStr ? parseInt(fontSizeStr) : 26
    if (isNaN(fontSize)) fontSize = 26
    if (fontSize < 20) fontSize = 20
    if (fontSize > 36) fontSize = 36

    let lineHeight = lineHeightStr ? parseInt(lineHeightStr) : Math.round(fontSize * 1.15)
    if (isNaN(lineHeight) || lineHeight < 20) lineHeight = Math.round(fontSize * 1.15)
    if (lineHeight > 50) lineHeight = 50

    const fontChanged = (this.fontSize !== fontSize)
    const wasLoaded = this.modesLoaded
    this.fontSize = fontSize
    this.lineHeight = lineHeight
    this.modesLoaded = true
    // 缓存到 appState，避免其它页面重复读取
    appState.fontSize = fontSize
    appState.lineHeight = lineHeight

    // 阅读模式检测变化（首次加载不触发 modeChanged，避免二次重载）
    const newMode = readingModeStr === 'seamless' ? 'seamless' : 'paginated'
    if (this.readingMode !== newMode) {
      if (wasLoaded) {
        this.modeChanged = true
      }
      this.readingMode = newMode
      appState.readingMode = newMode
    }

    const keepOn = keepOnStr === 'true'
    brightness.setKeepScreenOn({ keepScreenOn: keepOn })

    this.timeFormat = timeFormatStr || '24h'
    this.nowTime = getFormattedTimeNow(this.timeFormat)
    return fontChanged
  },

  async loadReadingProgress() {
    try {
      const progress = await dataManager.getReadingProgress(this.path)
      if (!this.$valid) return
      if (this.readingMode === 'seamless') {
        // 无缝模式：progress 是滚动偏移量（像素）
        if (progress != null && progress !== undefined && progress >= 0) {
          this.seamlessScrollTopValue = progress
          this.seamlessScrollTop = progress
          this.updateSeamlessPercent(progress)
        }
      } else {
        // 分页模式：progress 是页码
        if (progress != null && progress !== undefined && progress >= 0 && progress < this.totalPages) {
          this.currentPage = progress
          this.updatePageContent()
        }
      }
    } catch (e) {
      // 读取进度失败时忽略
    }
  },

  saveProgress() {
    try {
      if (this.path) {
        if (this.readingMode === 'seamless') {
          // 无缝模式：保存滚动偏移量
          dataManager.saveReadingProgress(this.path, this.seamlessScrollTop || 0)
        } else {
          // 分页模式：保存页码
          dataManager.saveReadingProgress(this.path, this.currentPage)
        }
      }
    } catch (e) {
      // 保存进度失败时忽略
    }
  },

  applyJumpToPage() {
    // 无缝模式：百分比跳转 → 全局行号 → 定位段
    if (appState.jumpToPercent != null && appState.jumpToPercent !== undefined) {
      const percent = parseInt(appState.jumpToPercent)
      appState.jumpToPercent = null
      if (this.readingMode === 'seamless' && this.pagesLoaded) {
        if (percent < 0) percent = 0
        if (percent > 100) percent = 100
        const targetScroll = Math.round(percent / 100 * Math.max(1, this.seamlessMaxScroll))
        this.seamlessScrollTop = targetScroll
        this.seamlessScrollTopValue = targetScroll
        this.updateSeamlessPercent(targetScroll)
        this.saveProgress()
        prompt.showToast({ message: '已跳转到 ' + percent + '%', duration: 1000 })
        return
      }
    }

    // 分页模式：页码跳转
    if (appState.jumpToPage == null || appState.jumpToPage === undefined) return
    const target = parseInt(appState.jumpToPage)
    if (this.pagesLoaded && target >= 0 && target < this.totalPages) {
      this.currentPage = target
      appState.jumpToPage = null
      this.pendingJump = null
      this.updatePageContent()
      this.saveProgress()
      prompt.showToast({ message: '已跳转到第 ' + (target + 1) + ' 页', duration: 1000 })
    } else if (!this.pagesLoaded) {
      this.pendingJump = target
      appState.jumpToPage = null
    } else {
      appState.jumpToPage = null
    }
  },

  async loadContent() {
    this.pagesLoaded = false

    // 无缝模式：加载全文并按行分块，使用 scroll + 多个 text 元素渲染
    // 套用弦电子书 detail.ux 的 scroll 结构，避免长文本一次性渲染导致卡顿
    if (this.readingMode === 'seamless') {
      const fullContent = await dataManager.getReaderFullContent(this.path)
      if (!this.$valid) return
      this.fullContent = fullContent

      const name = dataManager.getUnifiedNodeName(this.path)
      if (name) {
        this.contentName = name
        this.pageName = name
      }

      // 全文切成渲染块（段落分行 + 超长段 400 字切块），全量渲染
      this.seamlessBlocks = this.splitContentToBlocks(fullContent)
      this.seamlessMaxScroll = this.estimateMaxScroll(fullContent)
      this.readingPercent = 0
      this.seamlessScrollTop = 0
      this.seamlessScrollTopValue = 0
      this.pagesLoaded = true
      // 清理分页缓存数据释放内存
      this.pages = []
      this.currentPageContent = ''
      this.totalPages = 1
      appState.totalPages = 1
      return
    }

    // 分页模式：原有逻辑
    const oldPage = this.currentPage
    const oldTotal = this.totalPages

    let pages
    if (this.path && this.path.startsWith('builtin_')) {
      // 内置示例使用预计算缓存
      pages = await dataManager.getReaderPagesUnified(this.path)
    } else {
      // 传入字号，由 dataManager 按字号动态分页
      pages = await dataManager.getReaderPages(this.path, this.fontSize)
    }
    if (!this.$valid) return

    this.pages = pages
    this.totalPages = pages.length
    // 同步总页数到 appState，供 pageJump / percentJump 复用
    appState.totalPages = this.totalPages

    const name = dataManager.getUnifiedNodeName(this.path)
    if (name) {
      this.contentName = name
      this.pageName = name
    }

    // 总页数变化时（如字号改变），按比例保持在最接近的页
    if (oldTotal > 1 && this.totalPages > 1 && this.totalPages !== oldTotal) {
      const ratio = oldPage / (oldTotal - 1)
      this.currentPage = Math.round(ratio * (this.totalPages - 1))
    }
    // 钳制到有效范围
    if (this.currentPage >= this.totalPages) {
      this.currentPage = this.totalPages - 1
    }
    if (this.currentPage < 0) {
      this.currentPage = 0
    }

    this.pagesLoaded = true

    // 处理待跳转
    if (this.pendingJump != null) {
      const target = this.pendingJump
      this.pendingJump = null
      appState.jumpToPage = null
      if (target >= 0 && target < this.totalPages) {
        this.currentPage = target
      }
    }

    this.updatePageContent()
  },

  updatePageContent() {
    this.currentPageContent = this.pages[this.currentPage] || '无内容'
    this.atScrollBottom = false
    this.$nextTick(() => {
      if (!this.$valid) return
      const scroll = this.$element('contentScroll')
      if (scroll) {
        scroll.scrollTo({ top: 0 })
      }
      if (this.totalPages <= 1) {
        this.atScrollBottom = true
      }
    })
  },

  onScroll(e) {
    if (this.readingMode === 'seamless') {
      // 无缝模式：跟踪滚动位置（scrollTop / scrollY 兼容，进度用）
      const st = (e && (e.scrollTop || e.scrollY)) || (e && e.detail && e.detail.scrollTop) || 0
      this.seamlessScrollTop = st
      this.updateSeamlessPercent(st)
    } else if (this.atScrollBottom) {
      // 分页模式：页面内容不超一屏，仅复位底部标记
      this.atScrollBottom = false
    }
  },

  onReachBottom() {
    if (this.readingMode === 'seamless') {
      // 无缝模式滚动到底部：进度 100%
      this.readingPercent = 100
    } else {
      this.atScrollBottom = true
    }
  },

  /**
   * 无缝模式：全文切成渲染块——按段落分行，超长段按 400 字切块，
   * 避免单个 text 节点过大（引擎折行开销集中在超长段上会卡顿）。
   */
  splitContentToBlocks(content) {
    const raw = (content || '').split('\n')
    const blocks = []
    for (let i = 0; i < raw.length; i++) {
      let p = raw[i]
      if (p.length === 0) {
        blocks.push(' ')
        continue
      }
      while (p.length > 400) {
        blocks.push(p.substring(0, 400))
        p = p.substring(400)
      }
      blocks.push(p)
    }
    return blocks
  },

  /**
   * 无缝模式：估算内容总可滚动高度（用于百分比进度与跳转，cpl 与分页同款算法）。
   */
  estimateMaxScroll(content) {
    if (!content || content.length === 0) return 1
    const cpl = Math.max(1, Math.floor(296 / this.fontSize))
    const blocks = this.splitContentToBlocks(content)
    let totalLines = 0
    for (let i = 0; i < blocks.length; i++) {
      totalLines += Math.max(1, Math.ceil(blocks[i].length / cpl))
    }
    return Math.max(1, totalLines * this.lineHeight)
  },

  updateSeamlessPercent(scrollTop) {
    const max = this.seamlessMaxScroll || 1
    const pct = Math.min(100, Math.max(0, Math.round(scrollTop / max * 100)))
    if (Math.abs(pct - this.readingPercent) >= 1) {
      this.readingPercent = pct
    }
  },



  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--
      this.updatePageContent()
      this.saveProgress()
    }
  },

  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++
      this.updatePageContent()
      this.saveProgress()
    }
  },

  /**
   * 单击切换 UI 显示/隐藏 — 复刻弦电子书 detail.ux onTxtClick
   *
   * 弦电子书逻辑（gestureMode='single', swipeSideClickEnabled=false 默认）：
   *   showSetting=true  → 单击隐藏（showSetting=false），只剩文字
   *   showSetting=false → 单击显示（showSetting=true），恢复遮罩和按钮
   *
   * 隐藏时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部隐藏
   * 显示时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部显示
   */
  onTxtClick() {
    this.showSetting = !this.showSetting
    // 无缝模式：切换 UI 时保存滚动进度
    if (this.readingMode === 'seamless') {
      this.saveProgress()
    }
  },

  goSettings() {
    appState.readerPath = this.path
    appState.readerPage = this.currentPage
    appState.contentName = this.contentName
    router.push({
      uri: '/pages/readerSettings',
      params: { path: this.path }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      if (!this.showSetting) {
        this.showSetting = true
        return
      }
      router.back()
    }
  },

  onBackPress() {
    if (!this.showSetting) {
      this.showSetting = true
      return true
    }
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
</style>
