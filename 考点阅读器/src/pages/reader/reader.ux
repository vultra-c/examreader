<template>
  <div class="page">

    <!-- 无缝模式（V26.8.4 复刻弦电子书 detail.ux 两段式无缝阅读）：
         只渲染 page1 + page2 两个段落块（每段约 400 字），滚动由引擎自然撑开；
         滚到底 @scrollbottom → 加载下一段并整体前移，滚到顶 @scrolltop → 回退上一段，
         换段时用 getBoundingClientRect 实测被移除段高度补偿 scroll-top，视觉无跳变。
         DOM 恒定几十个节点，长文不卡顿、不叠字、可一直滚动到底。 -->
    <scroll
      id="seamlessScroll"
      if="{{modesLoaded && readingMode === 'seamless'}}"
      style="position: absolute; width: 336px; height: 460px; top: 10px;"
      scroll-y="{{true}}"
      scroll-top="{{seamScrollTopValue}}"
      @scroll="onScroll"
      @scrolltop="onSeamScrollTop"
      @scrollbottom="onSeamScrollBottom"
      @click="onTxtClick"
    >
      <div id="seamContainer" style="position: absolute; width: 336px; flex-direction: column;">
        <div id="seamPage1" style="flex-direction: column; width: 100%; flex-shrink: 0;">
          <div for="{{seamPage1.blocks}}" style="width: 336px; flex-direction: column;">
            <text style="width: 336px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px; padding-left: 20px; padding-right: 20px;">{{$item}}</text>
          </div>
        </div>
        <div id="seamPage2" if="{{seamPage2}}" style="flex-direction: column; width: 100%; flex-shrink: 0;">
          <div for="{{seamPage2.blocks}}" style="width: 336px; flex-direction: column;">
            <text style="width: 336px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px; padding-left: 20px; padding-right: 20px;">{{$item}}</text>
          </div>
        </div>
      </div>
    </scroll>

    <!-- 分页模式：scroll + text（仅渲染当前页内容） -->
    <scroll if="{{modesLoaded && readingMode !== 'seamless'}}"
            id="contentScroll" scroll-y="{{true}}"
            @click="onTxtClick"
            @scroll="onScroll"
            @scrollbottom="onReachBottom"
            style="position: absolute; left: 0px; top: 10px; width: 336px; height: 460px;">
      <div style="position: absolute; width: 336px; flex-direction: column; padding-left: 20px; padding-right: 20px; padding-bottom: 40px;">
        <text style="width: 296px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px;">{{currentPageContent}}</text>
      </div>
    </scroll>

    <!-- 顶部遮罩栏 — show 控制（复刻弦电子书 detail.ux showSetting 模式）
         注意：不能使用 static 属性，否则 show 不会动态更新
         @swipe 放在遮罩栏上，仅在 UI 显示时生效，不干扰 scroll 的垂直滑动 -->
    <img show="{{showSetting}}" src="/common/images/hd.png" @swipe="onSwipe" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />

    <!-- 返回按钮 -->
    <img show="{{showSetting}}" src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />

    <!-- 更多按钮 -->
    <img show="{{showSetting}}" src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />

    <!-- 时间和文件名（居中显示，宽度 180px 与其他页面一致） -->
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

    <!-- 底部遮罩栏（复刻弦电子书 detail.ux 底部栏）
         @swipe 放在底部遮罩栏上，仅在 UI 显示时生效 -->
    <img show="{{showSetting}}" src="/common/images/bt.png" @swipe="onSwipe" style="position: absolute; left: 0px; top: 378px; width: 336px; height: 102px;" />

    <!-- 底部翻页信息（仅分页模式；modesLoaded 前不渲染，避免打开时闪现阅读进度） -->
    <div show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated'}}" style="position: absolute; top: 402px; left: 78px; width: 180px; height: 72px; flex-direction: column; justify-content: flex-start; align-items: center;">
      <text style="line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">{{currentPage + 1}} / {{totalPages}}</text>
    </div>

    <!-- 底部上一页按钮（仅分页模式） -->
    <img show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated' && currentPage > 0}}" src="/common/images/pre.png" @click="prevPage" style="position: absolute; left: 6px; top: 402px; width: 72px; height: 72px;" />

    <!-- 底部下一页按钮（仅分页模式） -->
    <img show="{{showSetting}}" if="{{modesLoaded && readingMode === 'paginated' && currentPage < totalPages - 1}}" src="/common/images/next.png" @click="nextPage" style="position: absolute; left: 258px; top: 402px; width: 72px; height: 72px;" />

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'
import brightness from '@system.brightness'
import dataManager from '../../common/utils/dataManager.js'
import { getFormattedTimeNow } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    timeFormat: '24h',
    pageName: '全文',
    // pages 数组移至 this._pages（非响应式），避免大数组进框架观察
    currentPageContent: '',
    currentPage: 0,
    totalPages: 1,
    showSetting: true,
    atScrollBottom: false,
    fontSize: 26,
    lineHeight: 30,
    contentName: '',
    pendingJump: null,
    pagesLoaded: false,
    // 无缝模式相关（V26.8.4 复刻弦电子书 detail.ux 两段式无缝阅读）
    modesLoaded: false,
    readingMode: '',
    fullContent: '',
    readingPercent: 0,
    modeChanged: false,
    rawProgress: null,
    seamAllSize: 0,
    seamFileOffset: 0,
    seamSavedScrollOffset: 0,
    seamScrollTopValue: 0,
    seamScrollTop: 0,
    seamWait: false,
    seamLoadingNext: false,
    seamLoadingPrev: false,
    seamPage1: { text: '加载中...', offset: 0, length: 0, blocks: ['加载中...'] },
    seamPage2: null,
    seamPrevLineHeight: 0
  },
  protected: {
    path: '',
    targetPage: -1
  },

  onInit() {
    // 同步先给正确时间（避免设置栏唤出后短暂显示 00:00）
    this.nowTime = getFormattedTimeNow(this.timeFormat)
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getFormattedTimeNow(this.timeFormat)
        // 无缝模式定期保存滚动进度
        if (this.readingMode === 'seamless') {
          this.saveProgress()
        }
      }
    }, 60000)
    this.initReader()
  },

  async initReader() {
    await this.loadSettingsBatch()
    if (!this.$valid) return
    // 先读进度：无缝模式需要用起始字符偏移来初始化分段
    this.rawProgress = await dataManager.getReadingProgress(this.path)
    if (!this.$valid) return
    await this.loadContent()
    if (!this.$valid) return

    // 搜索结果跳转：直接跳到指定页码
    if (this.targetPage != null && this.targetPage >= 0 && this.targetPage < this.totalPages) {
      this.currentPage = this.targetPage
      this.targetPage = -1
      this.updatePageContent()
      this.saveProgress()
      return
    }

    await this.loadReadingProgress()
  },

  async onShow() {
    if (!this.$valid) return
    // 删除内容后自动返回上级
    if (appState.refreshReader) {
      appState.refreshReader = false
      router.back()
      return
    }
    // initReader 还没完成（异步），第一次 onShow 直接跳过
    // initReader 会完成所有初始化（包括搜索跳转）
    if (!this.pagesLoaded) return

    // 以下逻辑仅在页面已加载后再次 onShow 时执行（如从 readerSettings 返回）
    const fontChanged = await this.loadSettingsBatch()
    if (!this.$valid) return

    // 阅读模式变化：重新加载内容
    if (this.modeChanged) {
      this.modeChanged = false
      await this.loadContent()
      if (!this.$valid) return

      await this.loadReadingProgress()
      this.applyJumpToPage()
      return
    }

    // 字号变化：分页模式动态重新分页；无缝模式按行高比例平移滚动位置
    if (fontChanged && this.pagesLoaded) {
      if (this.readingMode === 'paginated') {
        await this.loadContent()
        if (!this.$valid) return
        this.saveProgress()
      } else if (this.readingMode === 'seamless') {
        // 行高比例缩放滚动位置，保持大致相同的阅读位置（复刻弦电子书 fontSizeRatio 处理）
        const ratio = this.seamPrevLineHeight > 0 ? this.lineHeight / this.seamPrevLineHeight : 1
        if (ratio !== 1 && this.seamScrollTop > 0) {
          const newTop = Math.max(0, Math.round(this.seamScrollTop * ratio))
          this.seamScrollTopValue = newTop
          this.seamScrollTop = newTop
          this.seamSavedScrollOffset = newTop
        }
        this.seamPrevLineHeight = this.lineHeight
        this.updateSeamPercentFromScroll()
        this.saveProgress()
      }
    }
    // 处理跳页请求（pageJump / percentJump）
    this.applyJumpToPage()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
    this.saveProgress()
  },

  storageGet(key) {
    return new Promise((resolve) => {
      storage.get({
        key: key,
        success: (data) => resolve(data),
        fail: () => resolve(null)
      })
    })
  },

  async loadSettingsBatch() {
    // 合并多次 storage 读取为并发批量读取
    const results = await Promise.all([
      this.storageGet('KD_FONT_SIZE'),
      this.storageGet('KD_LINE_HEIGHT'),
      this.storageGet('KD_KEEP_SCREEN_ON'),
      this.storageGet('KD_TIME_FORMAT'),
      this.storageGet('KD_READING_MODE')
    ])
    if (!this.$valid) return false

    const fontSizeStr = results[0]
    const lineHeightStr = results[1]
    const keepOnStr = results[2]
    const timeFormatStr = results[3]
    const readingModeStr = results[4]

    let fontSize = fontSizeStr ? parseInt(fontSizeStr) : 26
    if (isNaN(fontSize)) fontSize = 26
    if (fontSize < 20) fontSize = 20
    if (fontSize > 36) fontSize = 36

    let lineHeight = lineHeightStr ? parseInt(lineHeightStr) : Math.round(fontSize * 1.15)
    if (isNaN(lineHeight) || lineHeight < 20) lineHeight = Math.round(fontSize * 1.15)
    if (lineHeight > 50) lineHeight = 50

    const fontChanged = (this.fontSize !== fontSize)
    const wasLoaded = this.modesLoaded
    this.fontSize = fontSize
    this.lineHeight = lineHeight
    this.modesLoaded = true
    // 缓存到 appState，避免其它页面重复读取
    appState.fontSize = fontSize
    appState.lineHeight = lineHeight

    // 阅读模式检测变化（首次加载不触发 modeChanged，避免二次重载）
    const newMode = readingModeStr === 'seamless' ? 'seamless' : 'paginated'
    if (this.readingMode !== newMode) {
      if (wasLoaded) {
        this.modeChanged = true
      }
      this.readingMode = newMode
      appState.readingMode = newMode
    }

    const keepOn = keepOnStr === 'true'
    brightness.setKeepScreenOn({ keepScreenOn: keepOn })

    this.timeFormat = timeFormatStr || '24h'
    this.nowTime = getFormattedTimeNow(this.timeFormat)
    return fontChanged
  },

  async loadReadingProgress() {
    try {
      // 分页模式：progress 是页码（无缝模式进度已在 loadContent 内恢复）
      const progress = await dataManager.getReadingProgress(this.path)
      if (!this.$valid) return
      if (this.readingMode !== 'seamless') {
        if (typeof progress === 'number' && progress >= 0 && progress < this.totalPages) {
          this.currentPage = progress
          this.updatePageContent()
        }
      }
    } catch (e) {
      // 读取进度失败时忽略
    }
  },

  saveProgress() {
    try {
      if (this.path) {
        if (this.readingMode === 'seamless') {
          // 无缝模式：保存 起始字符偏移 + 段内滚动像素
          dataManager.saveReadingProgress(this.path, {
            mode: 'seam',
            offset: this.seamFileOffset || 0,
            scroll: this.seamScrollTop || 0
          })
        } else {
          // 分页模式：保存页码
          dataManager.saveReadingProgress(this.path, this.currentPage)
        }
      }
    } catch (e) {
      // 保存进度失败时忽略
    }
  },

  applyJumpToPage() {
    // 无缝模式：百分比跳转 → 全局行号 → 定位段
    if (appState.jumpToPercent != null && appState.jumpToPercent !== undefined) {
      const percent = parseInt(appState.jumpToPercent)
      appState.jumpToPercent = null
      if (this.readingMode === 'seamless' && this.pagesLoaded) {
        if (percent < 0) percent = 0
        if (percent > 100) percent = 100
        // 目标字符偏移 → page1 从目标前 200 字开始，段内滚动精确定位（同弦电子书 estimateScrollTopByOffset）
        const targetChars = Math.round(percent / 100 * Math.max(1, this.seamAllSize))
        this.seamFileOffset = Math.max(0, targetChars - 200)
        this.seamSavedScrollOffset = this.estimateSeamScrollTopByOffset(targetChars - this.seamFileOffset)
        this.loadSeamInitial()
        this.saveProgress()
        prompt.showToast({ message: '已跳转到 ' + percent + '%', duration: 1000 })
        return
      }
    }

    // 分页模式：页码跳转
    if (appState.jumpToPage == null || appState.jumpToPage === undefined) return
    const target = parseInt(appState.jumpToPage)
    if (this.pagesLoaded && target >= 0 && target < this.totalPages) {
      this.currentPage = target
      appState.jumpToPage = null
      this.pendingJump = null
      this.updatePageContent()
      this.saveProgress()
      prompt.showToast({ message: '已跳转到第 ' + (target + 1) + ' 页', duration: 1000 })
    } else if (!this.pagesLoaded) {
      this.pendingJump = target
      appState.jumpToPage = null
    } else {
      appState.jumpToPage = null
    }
  },

  async loadContent() {
    this.pagesLoaded = false

    // 无缝模式：加载全文并按行分块，使用 scroll + 多个 text 元素渲染
    // 套用弦电子书 detail.ux 的 scroll 结构，避免长文本一次性渲染导致卡顿
    if (this.readingMode === 'seamless') {
      const fullContent = await dataManager.getReaderFullContent(this.path)
      if (!this.$valid) return
      this.fullContent = fullContent
      this.seamAllSize = fullContent ? fullContent.length : 0

      const name = dataManager.getUnifiedNodeName(this.path)
      if (name) {
        this.contentName = name
        this.pageName = name
      }

      // 从保存的进度恢复起始位置（旧版数字进度按像素估算字符偏移，兼容）
      let startOffset = 0
      let scrollOffset = 0
      const progress = this.rawProgress
      if (progress && typeof progress === 'object' && progress.mode === 'seam') {
        startOffset = Math.max(0, progress.offset || 0)
        scrollOffset = Math.max(0, progress.scroll || 0)
      } else if (typeof progress === 'number' && progress > 0) {
        const cpl = this.estimateSeamCharsPerLine()
        startOffset = Math.max(0, Math.round(progress / Math.max(1, this.lineHeight)) * cpl - 200)
      }
      if (startOffset >= this.seamAllSize) {
        startOffset = Math.max(0, this.seamAllSize - 1)
      }
      this.seamFileOffset = startOffset
      this.seamSavedScrollOffset = scrollOffset
      this.seamScrollTopValue = 0
      this.seamScrollTop = 0
      this.readingPercent = 0
      this.seamPrevLineHeight = this.lineHeight

      // 两段式初始化：page1 = 起始段，page2 = 下一段，再恢复滚动位置
      this.loadSeamInitial()

      this.pagesLoaded = true
      // 清理分页缓存数据释放内存
      this._pages = []
      this.currentPageContent = ''
      this.totalPages = 1
      appState.totalPages = 1
      return
    }

    // 分页模式：原有逻辑
    const oldPage = this.currentPage
    const oldTotal = this.totalPages

    let pages
    if (this.path && this.path.startsWith('builtin_')) {
      // 内置示例使用预计算缓存
      pages = await dataManager.getReaderPagesUnified(this.path)
    } else {
      // 传入字号，由 dataManager 按字号动态分页
      pages = await dataManager.getReaderPages(this.path, this.fontSize)
    }
    if (!this.$valid) return

    this._pages = pages
    this.totalPages = pages.length
    // 同步总页数到 appState，供 pageJump / percentJump 复用
    appState.totalPages = this.totalPages

    const name = dataManager.getUnifiedNodeName(this.path)
    if (name) {
      this.contentName = name
      this.pageName = name
    }

    // 总页数变化时（如字号改变），按比例保持在最接近的页
    if (oldTotal > 1 && this.totalPages > 1 && this.totalPages !== oldTotal) {
      const ratio = oldPage / (oldTotal - 1)
      this.currentPage = Math.round(ratio * (this.totalPages - 1))
    }
    // 钳制到有效范围
    if (this.currentPage >= this.totalPages) {
      this.currentPage = this.totalPages - 1
    }
    if (this.currentPage < 0) {
      this.currentPage = 0
    }

    this.pagesLoaded = true

    // 处理待跳转
    if (this.pendingJump != null) {
      const target = this.pendingJump
      this.pendingJump = null
      appState.jumpToPage = null
      if (target >= 0 && target < this.totalPages) {
        this.currentPage = target
      }
    }

    this.updatePageContent()
  },

  updatePageContent() {
    // _pages 为非响应式实例属性：整本书分页数组不进框架观察，
    // 避免大数组 setData 的 diff 开销与内存双引用
    this.currentPageContent = (this._pages && this._pages[this.currentPage]) || '无内容'
    this.atScrollBottom = false
    this.$nextTick(() => {
      if (!this.$valid) return
      const scroll = this.$element('contentScroll')
      if (scroll) {
        scroll.scrollTo({ top: 0 })
      }
      if (this.totalPages <= 1) {
        this.atScrollBottom = true
      }
    })
  },

  onScroll(e) {
    if (this.readingMode === 'seamless') {
      // 无缝模式：跟踪滚动位置（scrollTop / scrollY 兼容），换段时以此为准做高度补偿
      if (this.seamWait) return
      const st = (e && (e.scrollTop || e.scrollY)) || (e && e.detail && e.detail.scrollTop) || 0
      // 每帧只记两个标量：
      // - 不回写 seamScrollTopValue（受控属性「事件→写回」循环，多一次属性更新检查；滚动位置的变更由换段路径显式赋值）
      // - 不调用 updateSeamPercentFromScroll（readingPercent 无 UI 消费，且内部每次都要拼接两段文本估算高度；需要它的换段路径已自行调用）
      this.seamScrollTop = st
      this.seamSavedScrollOffset = st
    } else if (this.atScrollBottom) {
      // 分页模式：页面内容不超一屏，仅复位底部标记
      this.atScrollBottom = false
    }
  },

  onSeamScrollTop() {
    // 复刻弦电子书 detail.ux onScrollTop：滚到已加载内容顶部时回退上一段
    if (this.seamWait || this.seamFileOffset <= 0 || this.seamLoadingPrev) return
    this.seamLoadingPrev = true
    this.loadSeamPrev()
  },

  onSeamScrollBottom() {
    // 复刻弦电子书 detail.ux onScrollBottom：滚到底时加载并切换下一段
    if (this.seamWait || this.seamLoadingNext) return
    this.seamLoadingNext = true
    this.loadSeamNext()
  },

  onReachBottom() {
    // 仅分页模式使用：页面内容不超一屏时标记已到底
    this.atScrollBottom = true
  },

  // ==================== 无缝模式：复刻弦电子书 detail.ux 两段式无缝阅读 ====================

  /**
   * 段落块切分：按换行分行；超长段按 120 字切块，
   * 避免单个 text 节点过大导致引擎折行卡顿。
   */
  buildSeamBlocks(text) {
    const blocks = []
    const raw = (text || '').split('\n')
    for (let i = 0; i < raw.length; i++) {
      let p = raw[i]
      if (p.length === 0) {
        blocks.push(' ')
        continue
      }
      while (p.length > 120) {
        blocks.push(p.substring(0, 120))
        p = p.substring(120)
      }
      blocks.push(p)
    }
    if (blocks.length === 0) blocks.push(' ')
    return blocks
  },

  /** 构建段数据（对应弦电子书 buildSegmentData） */
  buildSeamSegmentData(text, offset, length) {
    return {
      text: text || '',
      offset: offset || 0,
      length: length || 0,
      blocks: this.buildSeamBlocks(text)
    }
  },

  /** 估算每行字符数（对应弦电子书 estimateCharsPerLine） */
  estimateSeamCharsPerLine() {
    return Math.max(1, Math.floor(296 / (this.fontSize * 0.6)))
  },

  /** 按文本估算渲染高度（对应弦电子书 estimateTextHeightByText） */
  estimateSeamHeightByText(text) {
    if (!text) return 0
    const charsPerLine = this.estimateSeamCharsPerLine()
    const lines = Math.ceil(text.length / charsPerLine)
    return Math.max(this.lineHeight, lines * this.lineHeight)
  },

  /** 字符偏移 → 滚动位置（对应弦电子书 estimateScrollTopByOffset） */
  estimateSeamScrollTopByOffset(offset) {
    const charsPerLine = this.estimateSeamCharsPerLine()
    const charsBefore = Math.max(0, offset)
    const lines = Math.ceil(charsBefore / charsPerLine)
    return Math.max(0, lines * this.lineHeight)
  },

  /**
   * 从全文按字符偏移读取一段（对应弦电子书 readFileText；
   * 我们没有文件流，全文已在内存，直接 substring，每段 400 字符）。
   */
  readSeamText(readOffset, cb) {
    if (readOffset >= this.seamAllSize) { cb('', 0); return }
    const start = Math.max(0, readOffset)
    const len = Math.min(400, this.seamAllSize - start)
    const str = this.fullContent ? this.fullContent.substring(start, start + len) : ''
    cb(str, str.length)
  },

  /** 初始加载：page1 = 起始段，再加载 page2（对应 loadInitialSegments） */
  loadSeamInitial() {
    this.seamWait = true
    this.readSeamText(this.seamFileOffset, (str, bytesRead) => {
      this.seamPage1 = this.buildSeamSegmentData(str, this.seamFileOffset, bytesRead)
      this.loadSeamNextNoScroll()
    })
  },

  /** 不滚动的段尾续接：加载 page2（对应 loadNextSegmentNoScroll） */
  loadSeamNextNoScroll() {
    const newOffset = this.seamPage1.offset + this.seamPage1.length
    if (newOffset >= this.seamAllSize) {
      this.seamPage2 = null
      this.restoreSeamScroll()
      return
    }
    this.readSeamText(newOffset, (str, bytesRead) => {
      this.seamPage2 = str ? this.buildSeamSegmentData(str, newOffset, bytesRead) : null
      this.restoreSeamScroll()
      this.updateSeamPercentFromScroll()
    })
  },

  /** 恢复滚动位置（对应 restoreScrollPosition） */
  restoreSeamScroll() {
    setTimeout(() => {
      if (this.seamFileOffset === 0 && this.seamSavedScrollOffset === 0) {
        this.seamScrollTopValue = 0
        this.seamScrollTop = 0
        this.seamWait = false
        return
      }
      this.seamScrollTopValue = Math.max(0, Math.floor(this.seamSavedScrollOffset))
      this.seamScrollTop = this.seamScrollTopValue
      this.seamWait = false
    }, 60)
  },

  /** 滚到底：加载下一段（对应 loadNextSegment） */
  loadSeamNext() {
    this.seamWait = true
    const lastSeg = this.seamPage2 || this.seamPage1
    const newOffset = lastSeg.offset + lastSeg.length
    if (newOffset >= this.seamAllSize) {
      this.seamLoadingNext = false
      this.seamWait = false
      this.updateSeamPercentFromScroll()
      return
    }
    this.readSeamText(newOffset, (str, bytesRead) => {
      this.seamLoadingNext = false
      if (str) {
        setTimeout(() => {
          this.shiftSeamForward(this.buildSeamSegmentData(str, newOffset, bytesRead))
        }, 30)
      } else {
        this.seamWait = false
        this.updateSeamPercentFromScroll()
      }
    })
  },

  /** 前移一段：page1 ← page2，page2 ← 新段，滚动位置减去被移除段高度（对应 shiftPagesForward） */
  shiftSeamForward(nextPageData) {
    const scrollPosBeforeLoad = this.seamScrollTop
    const page1El = this.$element('seamPage1')

    const applyShift = (removeHeight) => {
      this.seamPage1 = this.seamPage2
      this.seamPage2 = nextPageData
      const safeRemoveHeight = Math.max(0, Math.floor(removeHeight || 0))
      const newScrollPos = Math.max(0, scrollPosBeforeLoad - safeRemoveHeight)
      this.seamScrollTopValue = newScrollPos
      this.seamScrollTop = newScrollPos
      this.seamSavedScrollOffset = newScrollPos
      this.seamFileOffset = this.seamPage1.offset
      this.updateSeamPercentFromScroll()
      this.saveProgress()
      this.seamWait = false
    }

    if (!page1El) {
      applyShift(this.estimateSeamHeightByText(this.seamPage1 ? this.seamPage1.text : ''))
      return
    }
    page1El.getBoundingClientRect({
      success: (rect) => applyShift(rect.height),
      fail: () => {
        applyShift(this.estimateSeamHeightByText(this.seamPage1 ? this.seamPage1.text : ''))
      }
    })
  },

  /** 滚到顶：回退上一段（对应 loadPrevSegment） */
  loadSeamPrev() {
    this.seamWait = true
    if (this.seamPage1.offset <= 0) {
      this.seamWait = false
      this.seamLoadingPrev = false
      return
    }
    const oldPage1 = this.seamPage1
    const newOffset = Math.max(0, this.seamPage1.offset - 400)
    this.readSeamText(newOffset, (str, bytesRead) => {
      this.seamLoadingPrev = false
      if (str) {
        const prevPageData = this.buildSeamSegmentData(str, newOffset, bytesRead)
        const applyShift = (addHeight) => {
          this.seamPage2 = oldPage1
          this.seamPage1 = prevPageData
          const safeAddHeight = Math.max(0, Math.floor(addHeight || 0))
          const newScrollPos = Math.max(0, this.seamScrollTop + safeAddHeight)
          this.seamScrollTopValue = newScrollPos
          this.seamScrollTop = newScrollPos
          this.seamSavedScrollOffset = newScrollPos
          this.seamFileOffset = this.seamPage1.offset
          this.updateSeamPercentFromScroll()
          this.saveProgress()
          this.seamWait = false
        }

        const oldPage1El = this.$element('seamPage1')
        if (!oldPage1El) {
          applyShift(this.estimateSeamHeightByText(oldPage1 ? oldPage1.text : ''))
          return
        }
        oldPage1El.getBoundingClientRect({
          success: (rect) => applyShift(rect.height),
          fail: () => {
            applyShift(this.estimateSeamHeightByText(oldPage1 ? oldPage1.text : ''))
          }
        })
      } else {
        this.seamWait = false
      }
    })
  },

  /** 全局阅读百分比 = 已加载字符 + 段内滚动折算字符（对应 calculateDisplayProgress） */
  updateSeamPercentFromScroll() {
    if (!this.seamAllSize || this.seamAllSize <= 0) {
      this.readingPercent = 0
      return
    }
    let totalChars = this.seamFileOffset
    const segLen = (this.seamPage1 ? this.seamPage1.length : 0) + (this.seamPage2 ? this.seamPage2.length : 0)
    const segHeight = this.estimateSeamHeightByText(
      (this.seamPage1 ? this.seamPage1.text : '') + (this.seamPage2 ? this.seamPage2.text : '')
    )
    if (segHeight > 0 && segLen > 0) {
      totalChars += Math.floor(this.seamScrollTop * segLen / segHeight)
    }
    const pct = Math.min(100, Math.max(0, Math.round(totalChars / this.seamAllSize * 100)))
    if (Math.abs(pct - this.readingPercent) >= 1) {
      this.readingPercent = pct
    }
  },



  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--
      this.updatePageContent()
      this.saveProgress()
    }
  },

  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++
      this.updatePageContent()
      this.saveProgress()
    }
  },

  /**
   * 单击切换 UI 显示/隐藏 — 复刻弦电子书 detail.ux onTxtClick
   *
   * 弦电子书逻辑（gestureMode='single', swipeSideClickEnabled=false 默认）：
   *   showSetting=true  → 单击隐藏（showSetting=false），只剩文字
   *   showSetting=false → 单击显示（showSetting=true），恢复遮罩和按钮
   *
   * 隐藏时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部隐藏
   * 显示时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部显示
   */
  onTxtClick() {
    this.showSetting = !this.showSetting
    // 无缝模式：切换 UI 时保存滚动进度
    if (this.readingMode === 'seamless') {
      this.saveProgress()
    }
  },

  goSettings() {
    appState.readerPath = this.path
    appState.readerPage = this.currentPage
    appState.contentName = this.contentName
    router.push({
      uri: '/pages/readerSettings',
      params: { path: this.path }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      if (!this.showSetting) {
        this.showSetting = true
        return
      }
      router.back()
    }
  },

  onBackPress() {
    if (!this.showSetting) {
      this.showSetting = true
      return true
    }
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
</style>
