<template>
  <div class="page" @swipe="onSwipe">

    <!-- 考点内容（全屏滚动区域，复刻弦电子书 detail.ux 布局）
         scroll 覆盖全屏，文字始终铺满全屏
         顶部/底部遮罩栏叠加在文字上方（半透明渐变）
         padding 固定不变，无论 showSetting 状态如何，文字位置始终一致
         注意：text 必须加 lines: -1 否则内容会被截断 -->
    <scroll id="contentScroll" scroll-y="{{true}}"
            @click="onTxtClick"
            @scroll="onScroll"
            @scrollbottom="onReachBottom"
            style="position: absolute; left: 0px; top: 0px; width: 336px; height: 480px;">
      <div style="width: 336px; flex-direction: column; padding-top: 10px; padding-bottom: 10px;">
        <text style="width: 296px; margin-left: 20px; text-align: left; color: #FFFFFF; font-size: {{fontSize}}px; font-weight: bold; line-height: {{lineHeight}}px; lines: -1;">{{currentPageContent}}</text>
      </div>
    </scroll>

    <!-- 顶部遮罩栏 — show 控制（复刻弦电子书 detail.ux showSetting 模式）
         注意：不能使用 static 属性，否则 show 不会动态更新 -->
    <img show="{{showSetting}}" src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />

    <!-- 返回按钮 -->
    <img show="{{showSetting}}" src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />

    <!-- 更多按钮 -->
    <img show="{{showSetting}}" src="/common/images/more.png" @click="goSettings" style="position: absolute; left: 258px; top: 6px; width: 72px; height: 72px;" />

    <!-- 时间和文件名 -->
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text show="{{showSetting}}" style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center; lines: 1; text-overflow: ellipsis;">{{pageName}}</text>

    <!-- 底部遮罩栏（复刻弦电子书 detail.ux 底部栏） -->
    <img show="{{showSetting}}" src="/common/images/bt.png" style="position: absolute; left: 0px; top: 378px; width: 336px; height: 102px;" />

    <!-- 底部翻页信息 -->
    <div show="{{showSetting}}" style="position: absolute; top: 402px; left: 78px; width: 180px; height: 72px; flex-direction: column; justify-content: flex-start; align-items: center;">
      <text style="line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">{{currentPage + 1}} / {{totalPages}}</text>
      <text static style="line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">阅读进度</text>
    </div>

    <!-- 底部上一页按钮 -->
    <img show="{{showSetting}}" if="{{currentPage > 0}}" src="/common/images/pre.png" @click="prevPage" style="position: absolute; left: 6px; top: 402px; width: 72px; height: 72px;" />

    <!-- 底部下一页按钮 -->
    <img show="{{showSetting}}" if="{{currentPage < totalPages - 1}}" src="/common/images/next.png" @click="nextPage" style="position: absolute; left: 258px; top: 402px; width: 72px; height: 72px;" />

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'
import brightness from '@system.brightness'
import dataManager from '../../common/utils/dataManager.js'
import { getNowTime } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    pageName: '全文',
    pages: [],
    currentPageContent: '',
    currentPage: 0,
    totalPages: 1,
    showSetting: true,
    atScrollBottom: false,
    fontSize: 26,
    lineHeight: 30,
    contentName: '',
    pendingJump: null,
    pagesLoaded: false
  },
  protected: {
    path: ''
  },

  onInit() {
    this.nowTime = getNowTime()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getNowTime()
      }
    }, 60000)
    this.loadSettings()
    this.loadContent()
  },

  onShow() {
    if (appState.jumpToPage != null && appState.jumpToPage !== undefined) {
      const target = parseInt(appState.jumpToPage)
      if (this.pagesLoaded && target >= 0 && target < this.totalPages) {
        this.currentPage = target
        appState.jumpToPage = null
        this.pendingJump = null
        this.updatePageContent()
        prompt.showToast({ message: '已跳转到第 ' + (target + 1) + ' 页', duration: 1000 })
      } else if (!this.pagesLoaded) {
        this.pendingJump = target
      } else {
        appState.jumpToPage = null
      }
    }
    if (appState.refreshReader) {
      appState.refreshReader = false
      router.back()
      return
    }
    if (this.$valid) {
      this.loadSettings()
      this.applyKeepScreenOn()
    }
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  async loadContent() {
    this.pagesLoaded = false
    this.pages = await dataManager.getReaderPages(this.path)
    if (!this.$valid) return
    this.totalPages = this.pages.length
    const name = dataManager.getNodeName(this.path)
    if (name) {
      this.contentName = name
      this.pageName = name
    }
    if (this.currentPage >= this.totalPages) {
      this.currentPage = this.totalPages - 1
    }
    if (this.currentPage < 0) {
      this.currentPage = 0
    }
    this.pagesLoaded = true

    if (this.pendingJump != null) {
      const target = this.pendingJump
      this.pendingJump = null
      appState.jumpToPage = null
      if (target >= 0 && target < this.totalPages) {
        this.currentPage = target
      }
    }

    this.updatePageContent()
  },

  updatePageContent() {
    this.currentPageContent = this.pages[this.currentPage] || '无内容'
    this.atScrollBottom = false
    this.$nextTick(() => {
      if (!this.$valid) return
      const scroll = this.$element('contentScroll')
      if (scroll) {
        scroll.scrollTo({ top: 0 })
      }
      if (this.totalPages <= 1) {
        this.atScrollBottom = true
      }
    })
  },

  loadSettings() {
    storage.get({
      key: 'KD_FONT_SIZE',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.fontSize = parseInt(data)
        }
      },
      fail: () => {
        if (!this.$valid) return
        this.fontSize = 26
      }
    })
    storage.get({
      key: 'KD_LINE_HEIGHT',
      success: (data) => {
        if (!this.$valid) return
        if (data) {
          this.lineHeight = parseInt(data)
        } else {
          this.lineHeight = Math.round(this.fontSize * 1.15)
        }
      },
      fail: () => {
        if (!this.$valid) return
        this.lineHeight = Math.round(this.fontSize * 1.15)
      }
    })
  },

  applyKeepScreenOn() {
    storage.get({
      key: 'KD_KEEP_SCREEN_ON',
      success: (data) => {
        if (!this.$valid) return
        const keepOn = data === 'true'
        brightness.setKeepScreenOn({ keepScreenOn: keepOn })
      },
      fail: () => {
        if (!this.$valid) return
        brightness.setKeepScreenOn({ keepScreenOn: false })
      }
    })
  },

  onScroll(e) {
    if (this.atScrollBottom) {
      this.atScrollBottom = false
    }
  },

  onReachBottom() {
    this.atScrollBottom = true
  },

  prevPage() {
    if (this.currentPage > 0) {
      this.currentPage--
      this.updatePageContent()
    }
  },

  nextPage() {
    if (this.currentPage < this.totalPages - 1) {
      this.currentPage++
      this.updatePageContent()
    }
  },

  /**
   * 单击切换 UI 显示/隐藏 — 复刻弦电子书 detail.ux onTxtClick
   *
   * 弦电子书逻辑（gestureMode='single', swipeSideClickEnabled=false 默认）：
   *   showSetting=true  → 单击隐藏（showSetting=false），只剩文字
   *   showSetting=false → 单击显示（showSetting=true），恢复遮罩和按钮
   *
   * 隐藏时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部隐藏
   * 显示时：时间、文件名、顶部遮罩、底部遮罩、按钮 UI 全部显示
   */
  onTxtClick() {
    this.showSetting = !this.showSetting
  },

  goSettings() {
    appState.readerPath = this.path
    appState.readerPage = this.currentPage
    appState.contentName = this.contentName
    router.push({
      uri: '/pages/readerSettings',
      params: { path: this.path }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      if (!this.showSetting) {
        this.showSetting = true
        return
      }
      router.back()
    }
  },

  onBackPress() {
    if (!this.showSetting) {
      this.showSetting = true
      return true
    }
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';
</style>
