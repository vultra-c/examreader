<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- Search box (pill-shaped) -->
    <div class="search-box">
      <img src="/common/images/search.png" class="search-icon" @click="doSearch" />
      <div style="flex: 1; height: 54px; justify-content: center; align-items: center;" @click="toggleKeyboard">
        <text class="search-text" show="{{searchText.length > 0}}">{{searchText}}</text>
        <text class="search-ph" show="{{searchText.length == 0}}">输入要搜索的内容</text>
      </div>
    </div>

    <!-- Clear button (separate element to avoid click conflicts) -->
    <div class="clear-btn" show="{{searchText.length > 0}}" @click="clearSearch">
      <text class="clear-icon" static>×</text>
    </div>

    <!-- Results list (hidden while keyboard is open) -->
    <list class="result-list" show="{{hasSearched && !showKeyboard}}">
      <list-item class="result-item" type="result" for="{{results}}" tid="path" @click="onResultClick($item)">
        <div class="result-content">
          <text class="result-name">{{$item.name}}</text>
          <text class="result-snippet">{{$item.snippet}}</text>
        </div>
      </list-item>
    </list>

    <!-- No results hint -->
    <text class="empty-hint" show="{{hasSearched && results.length == 0 && !showKeyboard}}">无结果</text>

    <!-- Input method keyboard -->
    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="5" vibratemode="short" @complete="onComplete" @delete="onDelete"></input-method>

    <!-- Top bar (unchanged) -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">搜索</text>

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import dataManager from '../../common/utils/dataManager.js'
import { getNowTime } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    searchText: '',
    showKeyboard: false,
    results: [],
    hasSearched: false
  },
  protected: {
    scope: 'global',
    searchPath: ''
  },

  onInit() {
    this.nowTime = getNowTime()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getNowTime()
      }
    }, 60000)
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  // Toggle the on-screen keyboard
  toggleKeyboard() {
    this.showKeyboard = !this.showKeyboard
  },

  // Append a character from the input method; space triggers search
  onComplete(e) {
    const content = e.detail.content
    if (content === ' ') {
      if (this.searchText.length > 0) {
        this.doSearch()
      }
      return
    }
    this.searchText = this.searchText + content
  },

  // Remove the last character from the input
  onDelete() {
    if (this.searchText.length > 0) {
      this.searchText = this.searchText.slice(0, -1)
    }
  },

  // Clear the search text and reset state
  clearSearch() {
    this.searchText = ''
    this.hasSearched = false
    this.results = []
  },

  // Run a content search and display results
  async doSearch() {
    const keyword = this.searchText.trim()
    if (keyword.length === 0) {
      prompt.showToast({ message: '请输入搜索内容', duration: 2000 })
      return
    }
    this.showKeyboard = false
    this.hasSearched = true

    let list
    if (this.scope === 'single' && this.searchPath) {
      // 单文件搜索：搜索指定考点中的内容
      const matches = await dataManager.searchContentInFile(this.searchPath, keyword)
      const name = dataManager.getUnifiedNodeName(this.searchPath)
      list = (matches || []).map(m => ({
        name: name,
        path: this.searchPath,
        snippet: m.snippet,
        position: m.position
      }))
    } else {
      // 全局搜索：搜索手环内所有考点内容
      list = await dataManager.searchContent(keyword)
    }

    if (!this.$valid) return
    this.results = list || []
  },

  // Open a result in the reader page
  onResultClick(item) {
    appState.readerPath = item.path

    // 始终设置搜索结果位置，reader 页面会根据自身阅读模式决定是否跳转
    // 分页模式：跳转到关键词所在页
    // 无缝模式：reader 会忽略该位置，直接打开文件
    if (item.position != null && item.position >= 0) {
      appState.searchResultPos = item.position
    }

    router.push({
      uri: '/pages/reader',
      params: { path: item.path }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';

  /* Search input box - pill-shaped, no border */
  .search-box {
    position: absolute;
    left: 6px;
    top: 108px;
    width: 324px;
    height: 54px;
    background-color: #1C1C1E;
    border-radius: 27px;
    flex-direction: row;
    align-items: center;
    padding: 0px 10px;
  }
  .search-icon {
    width: 34px;
    height: 34px;
  }
  /* Both placeholder and input text use the same font-size for consistent vertical alignment */
  .search-text {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    text-align: center;
    lines: 1;
    text-overflow: ellipsis;
  }
  .search-ph {
    font-size: 24px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    lines: 1;
  }

  /* Clear button - circular, positioned over the right side of the search box */
  .clear-btn {
    position: absolute;
    left: 286px;
    top: 112px;
    width: 46px;
    height: 46px;
    background-color: #333333;
    border-radius: 23px;
    justify-content: center;
    align-items: center;
  }
  .clear-icon {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }

  /* Results list */
  .result-list {
    position: absolute;
    left: 6px;
    top: 172px;
    width: 324px;
    height: 308px;
  }

  /* Result item card */
  .result-item {
    width: 100%;
    height: 80px;
    padding: 10px 16px;
    margin-bottom: 8px;
    background-color: #262626;
    border-radius: 24px;
    flex-direction: column;
    justify-content: center;
  }
  .result-content {
    flex-direction: column;
    justify-content: center;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  .result-name {
    font-size: 26px;
    font-weight: bold;
    color: white;
    lines: 1;
    text-overflow: ellipsis;
  }
  .result-snippet {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
    lines: 1;
    text-overflow: ellipsis;
    margin-top: 4px;
  }

  /* Empty hint shown when a search returns nothing */
  .empty-hint {
    position: absolute;
    left: 0px;
    top: 220px;
    width: 336px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
  }
</style>
