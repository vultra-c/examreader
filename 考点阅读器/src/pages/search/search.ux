<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- Search box (pill)：全部绝对定位，不依赖 flex；文字区相对药丸左右对称，占位/输入内容绝对居中 -->
    <div class="search-box">
      <img src="/common/images/search.png" class="search-icon" @click="doSearch" />
      <text class="search-text" show="{{searchText.length > 0}}">{{searchDisplay}}</text>
      <text class="search-ph" show="{{searchText.length == 0}}">输入要搜索的内容</text>
      <div class="search-hit" @click="toggleKeyboard"></div>
    </div>

    <!-- 搜索范围提示：主页=全部考点；子文件夹内=仅该文件夹；考点内=单文件 -->
    <text class="scope-hint" static>范围：{{scopeLabel}}</text>

    <!-- Clear button (separate element to avoid click conflicts) -->
    <div class="clear-btn" show="{{searchText.length > 0}}" @click="clearSearch">
      <text class="clear-icon" static>×</text>
    </div>

    <!-- Results list (hidden while keyboard is open)：同一文件的重复命中归在其文件行下方，分块渲染 -->
    <list class="result-list" show="{{hasSearched && !showKeyboard}}" onscrollbottom="onReachBottom">
      <list-item class="result-item" type="row" for="{{visibleRows}}" tid="id" @click="onResultClick($item)">
        <div class="result-content">
          <text class="result-name">{{$item.line1}}</text>
          <text class="result-snippet">{{$item.line2}}</text>
        </div>
      </list-item>
      <list-item if="{{hasMoreRows}}" type="more" class="result-item" @click="loadMoreRows">
        <div class="result-content">
          <text class="result-snippet">▼ 加载更多 ({{allRows.length - visibleRows.length}})</text>
        </div>
      </list-item>
    </list>

    <!-- No results hint（搜索过程中不显示，避免闪现） -->
    <text class="empty-hint" show="{{hasSearched && !searching && allRows.length == 0 && !showKeyboard}}">无结果</text>

    <!-- Input method keyboard -->
    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="5" vibratemode="short" @complete="onComplete" @delete="onDelete"></input-method>

    <!-- Top bar (unchanged) -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">搜索</text>

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import dataManager from '../../common/utils/dataManager.js'
import { getNowTime } from '../../common/utils/timeUtil.js'

// 结果分块渲染参数：首屏 24 行，滚动追加
const CHUNK_SIZE = 24

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    searchText: '',
    searchDisplay: '',
    showKeyboard: false,
    allRows: [],
    visibleRows: [],
    hasMoreRows: false,
    renderPos: 0,
    hasSearched: false,
    searching: false,
    scopeName: ''
  },
  protected: {
    scope: 'global',
    searchPath: ''
  },

  computed: {
    scopeLabel() {
      if (this.scope === 'single') return '当前考点'
      if (this.scope === 'folder') return this.scopeName || '当前文件夹'
      return '全部考点'
    }
  },

  onInit() {
    this.nowTime = getNowTime()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getNowTime()
      }
    }, 60000)
    // 文件夹范围时显示文件夹名
    if (this.scope === 'folder' && this.searchPath) {
      this.scopeName = dataManager.getNodeName(this.searchPath) || '当前文件夹'
    }
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  // Toggle the on-screen keyboard
  toggleKeyboard() {
    this.showKeyboard = !this.showKeyboard
  },

  // Append a character from the input method; space triggers search
  onComplete(e) {
    const content = e.detail.content
    if (content === ' ') {
      if (this.searchText.length > 0) {
        this.doSearch()
      }
      return
    }
    this.searchText = this.searchText + content
    this.updateSearchDisplay()
  },

  // Remove the last character from the input
  onDelete() {
    if (this.searchText.length > 0) {
      this.searchText = this.searchText.slice(0, -1)
      this.updateSearchDisplay()
    }
  },

  // 输入内容可以继续超过 5 个字符；显示区只显示前 5 个字符和省略号，
  // 明确保留第 5 个字符，省略号追加在其后，不再被容器宽度裁剪。
  updateSearchDisplay() {
    const value = String(this.searchText || '')
    this.searchDisplay = value.length > 5 ? value.substring(0, 5) + '…' : value
  },

  // Clear the search text and reset state
  clearSearch() {
    this.searchText = ''
    this.searchDisplay = ''
    this.hasSearched = false
    this.allRows = []
    this.visibleRows = []
    this.hasMoreRows = false
    this.renderPos = 0
  },

  // 把 dataManager 的分组结果展平为列表行：
  // 每个文件一行（统计命中数），其后紧跟该文件的全部命中行，同文件命中归在一起
  buildRows(groups) {
    const rows = []
    for (let g = 0; g < groups.length; g++) {
      const group = groups[g]
      const matches = group.matches || []
      rows.push({
        id: 'f_' + group.path,
        kind: 'file',
        path: group.path,
        fmt: group.fmt || '',
        type: group.type || '',
        line1: group.name,
        line2: matches.length > 0 ? (matches.length + ' 处匹配') : '文件名匹配',
        match: matches.length > 0 ? matches[0] : null
      })
      for (let i = 0; i < matches.length; i++) {
        const m = matches[i]
        rows.push({
          id: 'm_' + group.path + '_' + i,
          kind: 'match',
          path: group.path,
          fmt: group.fmt || '',
          type: group.type || '',
          line1: m.position >= 0
            ? ('第 ' + (i + 1) + ' 处')
            : ((m.subject || '') + ' · ' + (m.entryTitle || '')),
          line2: m.snippet || '',
          match: m
        })
      }
    }
    return rows
  },

  appendVisibleChunk() {
    const start = this.renderPos
    const end = Math.min(start + CHUNK_SIZE, this.allRows.length)
    const newRows = this.allRows.slice(start, end)
    if (newRows.length > 0) {
      this.visibleRows = this.visibleRows.concat(newRows)
      this.renderPos = end
    }
    this.hasMoreRows = this.renderPos < this.allRows.length
  },

  onReachBottom() {
    if (this.hasMoreRows) {
      this.appendVisibleChunk()
    }
  },

  loadMoreRows() {
    this.appendVisibleChunk()
  },

  // Run a content search and display results
  async doSearch() {
    const keyword = this.searchText.trim()
    if (keyword.length === 0) {
      prompt.showToast({ message: '请输入搜索内容', duration: 2000 })
      return
    }
    this.showKeyboard = false
    this.hasSearched = true
    this.searching = true

    // 范围逻辑：主页=全部内容；文件夹页=该文件夹子树；阅读设置=单文件
    let groups
    if (this.scope === 'single' && this.searchPath) {
      // 单文件搜索（考点阅读设置进入）
      const group = await dataManager.searchContentInFile(this.searchPath, keyword)
      groups = (group && group.matches && group.matches.length > 0) ? [group] : []
    } else if (this.scope === 'folder' && this.searchPath) {
      // 文件夹内搜索：只搜该文件夹子树内的内容
      groups = await dataManager.searchContentInFolder(this.searchPath, keyword)
    } else {
      // 全局搜索（主页进入）
      groups = await dataManager.searchContent(keyword)
    }
    if (!this.$valid) return

    this.searching = false
    this.allRows = this.buildRows(groups || [])
    this.renderPos = 0
    this.visibleRows = []
    this.appendVisibleChunk()
  },

  // 打开文件（无定位信息时使用）
  openFilePlain(row) {
    if (row.fmt === 'json') {
      router.push({ uri: '/pages/jsonReader', params: { path: row.path } })
    } else {
      router.push({ uri: '/pages/reader', params: { path: row.path } })
    }
  },

  // 点击结果行：文件行跳首个命中；命中行跳该命中在文内的具体位置
  onResultClick(row) {
    const match = row.match
    if (!match) {
      this.openFilePlain(row)
      return
    }
    if (row.fmt === 'json' || match.position === -1) {
      // JSON 知识点：定位到具体 科目 → 条目
      router.push({
        uri: '/pages/jsonReader',
        params: {
          path: row.path,
          jumpSubject: match.subject || '',
          jumpIndex: (match.entryIdx != null && match.entryIdx !== undefined) ? match.entryIdx : -1
        }
      })
      return
    }
    // TXT：按字符位置跳转，阅读器按当前模式换算（分页→页码 / 无缝→滚动位置）
    router.push({
      uri: '/pages/reader',
      params: {
        path: row.path,
        targetChar: match.position
      }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';

  .scope-hint {
    position: absolute;
    left: 0px;
    top: 168px;
    width: 336px;
    font-size: 20px;
    color: rgba(255,255,255,0.35);
    text-align: center;
    lines: 1;
    text-overflow: ellipsis;
  }

  .search-box {
    position: absolute;
    left: 6px;
    top: 108px;
    width: 324px;
    height: 54px;
    background-color: #1C1C1E;
    border-radius: 27px;
  }
  .search-icon {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 34px;
    height: 34px;
  }
  /* 文字区 [44,280]，中心 x=162 = 药丸中心(324/2)，左右各留 44px 对称 */
  .search-text {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    line-height: 54px;
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    text-align: center;
    lines: 1;
    text-overflow: ellipsis;
  }
  .search-ph {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    line-height: 54px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    lines: 1;
  }
  /* 透明点击层：盖住文字区且置于最上层，点击弹出/收起键盘；放大镜独立触发搜索 */
  .search-hit {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    background-color: transparent;
  }

  .clear-btn {
    position: absolute;
    left: 286px;
    top: 112px;
    width: 46px;
    height: 46px;
    background-color: #333333;
    border-radius: 23px;
    justify-content: center;
    align-items: center;
  }
  .clear-icon {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }

  .result-list {
    position: absolute;
    left: 6px;
    top: 200px;
    width: 324px;
    height: 280px;
  }

  .result-item {
    width: 100%;
    height: 80px;
    padding: 10px 16px;
    margin-bottom: 8px;
    background-color: #262626;
    border-radius: 24px;
    flex-direction: column;
    justify-content: center;
  }
  .result-content {
    flex-direction: column;
    justify-content: center;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  .result-name {
    font-size: 26px;
    font-weight: bold;
    color: white;
    lines: 1;
    text-overflow: ellipsis;
  }
  .result-snippet {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
    lines: 1;
    text-overflow: ellipsis;
    margin-top: 4px;
  }

  .empty-hint {
    position: absolute;
    left: 0px;
    top: 240px;
    width: 336px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
  }
</style>
