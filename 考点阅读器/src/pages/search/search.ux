<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" style="flex-direction: column;" @swipe="onSwipe">

    <!-- Search box (pill)：全部绝对定位，不依赖 flex；文字区相对药丸左右对称，占位/输入内容绝对居中 -->
    <div class="search-box">
      <img src="/common/images/search.png" class="search-icon" @click="doSearch" />
      <text class="search-text" show="{{searchText.length > 0}}">{{searchDisplay}}</text>
      <text class="search-ph" show="{{searchText.length == 0}}">输入要搜索的内容</text>
      <div class="search-hit" @click="toggleKeyboard"></div>
    </div>

    <!-- 搜索范围提示：主页=全部考点；子文件夹内=仅该文件夹；考点内=单文件 -->
    <text class="scope-hint" static>范围：{{scopeLabel}}</text>

    <!-- Clear button (separate element to avoid click conflicts) -->
    <div class="clear-btn" show="{{searchText.length > 0}}" @click="clearSearch">
      <text class="clear-icon" static>×</text>
    </div>

    <!-- Results list (hidden while keyboard is open) -->
    <list class="result-list" show="{{hasSearched && !showKeyboard}}">
      <list-item class="result-item" type="result" for="{{results}}" tid="id" @click="onResultClick($item)">
        <div class="result-content">
          <text class="result-name">{{$item.name}}</text>
          <text class="result-snippet">{{$item.snippet}}</text>
        </div>
      </list-item>
    </list>

    <!-- No results hint -->
    <text class="empty-hint" show="{{hasSearched && results.length == 0 && !showKeyboard}}">无结果</text>

    <!-- Input method keyboard -->
    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="5" vibratemode="short" @complete="onComplete" @delete="onDelete"></input-method>

    <!-- Top bar (unchanged) -->
    <img static src="/common/images/hd.png" style="position: absolute; left: 0px; top: 0px; width: 336px; height: 102px;" />
    <img static src="/common/images/back.png" @click="goBack" style="position: absolute; left: 6px; top: 6px; width: 72px; height: 72px;" />
    <text style="position: absolute; left: 78px; top: 7px; width: 180px; line-height: 32px; font-weight: bold; font-size: 24px; color: rgba(255,255,255,0.6); text-align: center;">{{nowTime}}</text>
    <text static style="position: absolute; left: 78px; top: 35px; width: 180px; line-height: 42px; font-weight: bold; font-size: 32px; color: white; text-align: center;">搜索</text>

  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'
import dataManager from '../../common/utils/dataManager.js'
import { getNowTime } from '../../common/utils/timeUtil.js'
import appState from '../../common/utils/appState.js'

export default {
  private: {
    nowTime: '00:00',
    timer: null,
    searchText: '',
    searchDisplay: '',
    showKeyboard: false,
    results: [],
    hasSearched: false,
    scopeName: ''
  },
  protected: {
    scope: 'global',
    searchPath: ''
  },

  computed: {
    scopeLabel() {
      if (this.scope === 'single') return '当前考点'
      if (this.scope === 'folder') return this.scopeName || '当前文件夹'
      return '全部考点'
    }
  },

  onInit() {
    this.nowTime = getNowTime()
    this.timer = setInterval(() => {
      if (this.$valid) {
        this.nowTime = getNowTime()
      }
    }, 60000)
    // 文件夹范围时显示文件夹名
    if (this.scope === 'folder' && this.searchPath) {
      this.scopeName = dataManager.getNodeName(this.searchPath) || '当前文件夹'
    }
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  // Toggle the on-screen keyboard
  toggleKeyboard() {
    this.showKeyboard = !this.showKeyboard
  },

  // Append a character from the input method; space triggers search
  onComplete(e) {
    const content = e.detail.content
    if (content === ' ') {
      if (this.searchText.length > 0) {
        this.doSearch()
      }
      return
    }
    this.searchText = this.searchText + content
    this.updateSearchDisplay()
  },

  // Remove the last character from the input
  onDelete() {
    if (this.searchText.length > 0) {
      this.searchText = this.searchText.slice(0, -1)
      this.updateSearchDisplay()
    }
  },

  // 输入内容可以继续超过 5 个字符；显示区只显示前 5 个字符和省略号，
  // 明确保留第 5 个字符，省略号追加在其后，不再被容器宽度裁剪。
  updateSearchDisplay() {
    const value = String(this.searchText || '')
    this.searchDisplay = value.length > 5 ? value.substring(0, 5) + '…' : value
  },

  // Clear the search text and reset state
  clearSearch() {
    this.searchText = ''
    this.searchDisplay = ''
    this.hasSearched = false
    this.results = []
  },

  // Run a content search and display results
  async doSearch() {
    const keyword = this.searchText.trim()
    if (keyword.length === 0) {
      prompt.showToast({ message: '请输入搜索内容', duration: 2000 })
      return
    }
    this.showKeyboard = false
    this.hasSearched = true

    let list
    if (this.scope === 'single' && this.searchPath) {
      // 单文件搜索（考点阅读设置进入）
      const matches = await dataManager.searchContentInFile(this.searchPath, keyword)
      const name = dataManager.getUnifiedNodeName(this.searchPath)
      list = (matches || []).map((m, i) => ({
        id: this.searchPath + '_' + i,
        name: name,
        path: this.searchPath,
        snippet: m.snippet,
        position: m.position,
        fmt: (name || '').toLowerCase().indexOf('.json') === name.length - 5 ? 'json' : ''
      }))
    } else if (this.scope === 'folder' && this.searchPath) {
      // 文件夹内搜索：只搜该文件夹子树内的内容
      list = await dataManager.searchContentInFolder(this.searchPath, keyword)
      list = (list || []).map((item, i) => ({
        name: item.name,
        path: item.path,
        snippet: item.snippet,
        position: item.position,
        type: item.type,
        fmt: item.fmt || '',
        id: item.path + '_' + i
      }))
    } else {
      // 全局搜索
      list = await dataManager.searchContent(keyword)
      if (list && list.length > 0) {
        list = list.map((item, i) => {
          return {
            name: item.name,
            path: item.path,
            snippet: item.snippet,
            position: item.position,
            type: item.type,
            fmt: item.fmt || '',
            id: item.path + '_' + i
          }
        })
      }
    }

    // 全局结果同样带上 fmt（dataManager 已返回），统一映射
    if (!this.$valid) return
    this.results = (list || []).map(item => ({ fmt: '', ...item }))
  },

  // 点击搜索结果：搜索页直接分页，搜索关键词在第几页，传给 reader
  async onResultClick(item) {
    // 从 storage 读取字号
    const fontSizeStr = await new Promise((resolve) => {
      storage.get({ key: 'KD_FONT_SIZE', success: (d) => resolve(d), fail: () => resolve(null) })
    })
    let fontSize = fontSizeStr ? parseInt(fontSizeStr) : 26
    if (isNaN(fontSize)) fontSize = 26

    // JSON 知识点文件：直接打开知识点阅读器（无页码概念）
    if (item.fmt === 'json') {
      router.push({ uri: '/pages/jsonReader', params: { path: item.path } })
      return
    }

    // 直接调用 getReaderPages 拿到和 reader 完全一样的分页
    const pages = await dataManager.getReaderPages(item.path, fontSize)

    // 在分页数组中搜索关键词所在页
    let targetPage = 0
    const keyword = this.searchText.trim().toLowerCase()
    if (pages && pages.length > 0) {
      for (let i = 0; i < pages.length; i++) {
        if (pages[i] && pages[i].toLowerCase().indexOf(keyword) >= 0) {
          targetPage = i
          break
        }
      }
    }

    router.push({
      uri: '/pages/reader',
      params: {
        path: item.path,
        targetPage: targetPage
      }
    })
  },

  goBack() {
    router.back()
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
  @import '../../common/style.css';

  .scope-hint {
    position: absolute;
    left: 0px;
    top: 168px;
    width: 336px;
    font-size: 20px;
    color: rgba(255,255,255,0.35);
    text-align: center;
    lines: 1;
    text-overflow: ellipsis;
  }

  .search-box {
    position: absolute;
    left: 6px;
    top: 108px;
    width: 324px;
    height: 54px;
    background-color: #1C1C1E;
    border-radius: 27px;
  }
  .search-icon {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 34px;
    height: 34px;
  }
  /* 文字区 [44,280]，中心 x=162 = 药丸中心(324/2)，左右各留 44px 对称 */
  .search-text {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    line-height: 54px;
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    text-align: center;
    lines: 1;
    text-overflow: ellipsis;
  }
  .search-ph {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    line-height: 54px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.3);
    text-align: center;
    lines: 1;
  }
  /* 透明点击层：盖住文字区且置于最上层，点击弹出/收起键盘；放大镜独立触发搜索 */
  .search-hit {
    position: absolute;
    left: 44px;
    top: 0px;
    width: 236px;
    height: 54px;
    background-color: transparent;
  }

  .clear-btn {
    position: absolute;
    left: 286px;
    top: 112px;
    width: 46px;
    height: 46px;
    background-color: #333333;
    border-radius: 23px;
    justify-content: center;
    align-items: center;
  }
  .clear-icon {
    font-size: 30px;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }

  .result-list {
    position: absolute;
    left: 6px;
    top: 200px;
    width: 324px;
    height: 280px;
  }

  .result-item {
    width: 100%;
    height: 80px;
    padding: 10px 16px;
    margin-bottom: 8px;
    background-color: #262626;
    border-radius: 24px;
    flex-direction: column;
    justify-content: center;
  }
  .result-content {
    flex-direction: column;
    justify-content: center;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }
  .result-name {
    font-size: 26px;
    font-weight: bold;
    color: white;
    lines: 1;
    text-overflow: ellipsis;
  }
  .result-snippet {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
    lines: 1;
    text-overflow: ellipsis;
    margin-top: 4px;
  }

  .empty-hint {
    position: absolute;
    left: 0px;
    top: 240px;
    width: 336px;
    font-size: 24px;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
  }
</style>
