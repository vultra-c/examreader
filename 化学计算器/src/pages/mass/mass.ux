<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" @swipe="onSwipe">
    <div class="topbar">
      <div class="topbar-back" @click="goBack"><text class="topbar-back-text">‹</text></div>
      <text class="topbar-title">质量计算</text>
    </div>

    <div if="{{!valid}}" style="position:absolute; top:180px; width:336px;">
      <text style="text-align:center; color:rgba(255,255,255,0.35); font-size:24px;">未找到反应数据</text>
    </div>

    <div if="{{valid}}" style="position:absolute; top:88px; left:10px; width:316px;">
      <!-- 选择已知物质（横滚） -->
      <text class="group-header">1. 选择已知质量的物质</text>
      <scroll scroll-x="true" style="width:316px; height:56px;">
        <div style="flex-direction: row;">
          <div class="sel-chip {{knownIdx === $item.idx ? 'sel-on' : ''}}" for="{{selRows}}" @click="onSelect($item)">
            <text class="{{knownIdx === $item.idx ? 'sel-on-t' : 'sel-t'}}">{{$item.text}}</text>
          </div>
        </div>
      </scroll>

      <!-- 输入质量 -->
      <text class="group-header" style="margin-top:6px;">2. 输入已知质量（g）</text>
      <!-- 质量输入沿用考点阅读器同款输入法，数字页可直接输入小数 -->
      <div class="mass-input" @click="toggleKeyboard">
        <text if="{{massStr}}" class="mass-input-t">{{massStr}} g</text>
        <text else class="mass-input-h">点击输入质量（g）</text>
      </div>

      <!-- 计算按钮 -->
      <div class="btn-primary" style="margin-top:6px;height:56px;" @click="onCompute">
        <text class="btn-primary-text">计 算</text>
      </div>

      <!-- 结果 -->
      <text if="{{hasResult}}" class="group-header" style="margin-top:8px;">3. 各物质质量</text>
      <scroll scroll-y="true" style="width:316px;height:150px;" if="{{hasResult}}">
        <div class="mass-row {{$item.known ? 'mass-row-known' : ''}}" for="{{resultRows}}">
          <div style="flex-direction: row; justify-content: space-between; align-items: flex-end;">
            <text class="mass-f">{{$item.text}}</text>
            <text class="mass-value">{{$item.massText}} g</text>
          </div>
          <text style="font-size:18px; color:rgba(255,255,255,0.5); margin-top:2px;">n ≈ {{$item.molText}} mol</text>
        </div>
      </scroll>
    </div>

    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="10"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { computeMasses } from '../../common/logic/stoich.js'
import { fmtNum } from '../../common/logic/parser.js'

export default {
  protected: {
    valid: false,
    selRows: [],
    knownIdx: 0,
    massStr: '',
    showKeyboard: false,
    hasResult: false,
    resultRows: []
  },

  onInit() {
    const r = this.$app.$data.reaction
    if (!r) { this.valid = false; return }
    this.valid = true
    this._rxn = r
    this.knownIdx = this.$app.$data.massKnownIdx || 0

    this.selRows = []
    for (let i = 0; i < r.coefs.length; i++) {
      this.selRows.push({ text: this.renderSub(r.segs[i], r.coefs[i]), idx: i, sid: 's' + i })
    }

  },

  renderSub(segs, coef) {
    let s = ''
    for (const seg of segs) {
      if (seg.t === 'el') s += seg.s
      else if (seg.t === 'num') s += this.subDigit(seg.s)
      else s += seg.s
    }
    return (coef > 1 ? coef : '') + s
  },

  subDigit(num) {
    const map = { '0':'₀','1':'₁','2':'₂','3':'₃','4':'₄','5':'₅','6':'₆','7':'₇','8':'₈','9':'₉' }
    return String(num).split('').map(c => map[c] || c).join('')
  },

  onSelect(item) {
    this.knownIdx = item.idx
    this.hasResult = false
    this.resultRows = []
  },

  toggleKeyboard() {
    this.showKeyboard = !this.showKeyboard
  },

  onInput(e) {
    const value = e && e.detail ? String(e.detail.content || '') : ''
    if (/^[0-9]$/.test(value)) {
      if (this.massStr.replace('.', '').length < 8) {
        if (this.massStr === '0') this.massStr = ''
        this.massStr += value
      }
    } else if (value === '.' && this.massStr.indexOf('.') === -1) {
      this.massStr = this.massStr ? this.massStr + '.' : '0.'
    }
  },

  onDel() {
    this.massStr = this.massStr.slice(0, -1)
  },

  onCompute() {
    const m = parseFloat(this.massStr)
    if (isNaN(m) || m <= 0) { prompt.showToast({ message: '请输入有效质量', duration: 1500 }); return }
    const out = computeMasses(this._rxn, this.knownIdx, m)
    if (!out) { prompt.showToast({ message: '计算失败', duration: 1500 }); return }
    const r = this._rxn
    this.resultRows = []
    for (let i = 0; i < out.length; i++) {
      this.resultRows.push({ text: this.renderSub(r.segs[i], r.coefs[i]), massText: fmtNum(out[i].mass), molText: fmtNum(out[i].mol), known: i === this.knownIdx, rid2: 'q' + i })
    }
    this.hasResult = true
  },

  goBack() { router.back() },
  onSwipe(e) { if (e.direction === 'right') router.back() }
}
</script>

<style>
@import '../../common/style.css';

.sel-chip {
  height: 46px;
  border-radius: 14px;
  background-color: #262626;
  padding: 0 18px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
}
.sel-on { background-color: #0D6EFF; }
.sel-t { font-size: 22px; color: rgba(255,255,255,0.7); }
.sel-on-t { font-size: 22px; font-weight: bold; color: #fff; }

.mass-input {
  width: 316px;
  min-height: 54px;
  background-color: #1a1a1c;
  border-radius: 14px;
  padding: 8px 14px;
  justify-content: center;
  margin-bottom: 6px;
}
.mass-input-t { font-size: 28px; color: #fff; }
.mass-input-h { font-size: 20px; color: rgba(255,255,255,0.35); }



.mass-row {
  background-color: #262626; border-radius: 14px;
  padding: 8px 12px; margin-bottom: 6px; width: 316px;
  flex-direction: column;
}
.mass-row-known { background-color: rgba(13,110,255,0.25); }
.mass-f { font-size: 24px; color: #fff; }
.mass-value { font-size: 26px; color: #fff; font-weight: bold; }
</style>
