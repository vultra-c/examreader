<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 质量计算页（336×480，闪念小抄风格）
  流程：选择已知物质 → 输入质量（数字键盘）→ 计算 → 列出全部物质质量/物质的量。
  支持任选反应物或生成物（含反向推算）。输入区全部位于键盘遮挡区之上。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 无反应数据兜底 -->
    <div if="{{!valid}}" class="none-wrap">
      <img static src="/common/images/empty_state.png" class="none-img" />
      <text class="none-tip">还没有可用的反应方程式</text>
      <div class="btn-main none-btn" @click="goReaction">
        <text class="btn-main-t">去反应计算</text>
      </div>
    </div>

    <!-- 主体元素全部 absolute 顶层挂载，坐标固定 -->
    <!-- 1 · 选已知物质 -->
    <text if="{{valid}}" class="sec-label">选择已知质量的物质</text>
    <scroll if="{{valid}}" scroll-x="true" class="chip-scroll">
      <div class="chip-row">
        <div class="{{knownIdx == $item.idx ? 'chip-on' : 'chip'}}"
             for="{{selRows}}" tid="rid" @click="onSelect($item)">
          <text class="{{knownIdx == $item.idx ? 'chip-t-on' : 'chip-t'}}">{{$item.text}}</text>
        </div>
      </div>
    </scroll>

    <!-- 2 · 输入质量 + 计算（均在键盘遮挡区之上） -->
    <div if="{{valid}}" class="mass-field" @click="toggleKb">
      <text if="{{massStr.length > 0}}" class="mass-field-v">{{massStr}} g</text>
      <text else class="mass-field-h">质量(克)</text>
    </div>
    <div if="{{valid}}" class="btn-main calc-btn" @click="onCompute">
      <text class="btn-main-t">计算</text>
    </div>

    <!-- 3 · 结果（静态 class 行 + div 包裹；known 用文本前缀标记） -->
    <text show="{{valid && hasResult}}" class="sec-label res-label">各物质质量</text>
    <list show="{{valid && hasResult}}" class="res-list">
      <list-item for="{{resultRows}}" tid="rid" type="res" class="res-row">
        <div class="res-line">
          <text class="res-f">{{$item.text}}</text>
          <text class="res-m">{{$item.massText}} g</text>
        </div>
        <text class="res-mol">{{$item.molText}}</text>
      </list-item>
    </list>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">按质量反推</text>
    <text static class="hd-title">质量计算</text>

    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="8"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { computeMasses } from '../../common/logic/stoich.js'
import { fmtNum } from '../../common/logic/parser.js'
import { segsToText } from '../../common/logic/fmt.js'

export default {
  protected: {
    valid: false,
    selRows: [],
    knownIdx: 0,
    massStr: '',
    showKeyboard: false,
    hasResult: false,
    resultRows: []
  },

  onInit() {
    const r = this.$app.$def.reaction
    if (!r || !r.coefs || !r.segs || !Array.isArray(r.coefs) || !Array.isArray(r.segs) || r.coefs.length === 0 || r.coefs.length !== r.segs.length) {
      this.valid = false
      return
    }
    this.valid = true
    this._rxn = r

    const wantIdx = this.$app.$def.massKnownIdx
    this.knownIdx = (typeof wantIdx === 'number' && wantIdx >= 0 && wantIdx < r.coefs.length) ? wantIdx : 0

    const rows = []
    for (let i = 0; i < r.coefs.length; i++) {
      rows.push({ text: segsToText(r.segs[i], r.coefs[i]), idx: i, rid: 's' + i })
    }
    this.selRows = rows
    try {
      this.$app.$def.massKnownIdx = this.knownIdx
    } catch (err) {}
  },

  onSelect(item) {
    this.knownIdx = item.idx
    this.hasResult = false
    this.resultRows = []
    this.showKeyboard = false
  },

  toggleKb() {
    this.showKeyboard = !this.showKeyboard
  },

  onInput(e) {
    const value = e && e.detail ? String(e.detail.content || '') : ''
    if (/^[0-9]$/.test(value)) {
      if (this.massStr.replace('.', '').length < 8) {
        if (this.massStr === '0') this.massStr = ''
        this.massStr += value
      }
    } else if (value === '.' && this.massStr.indexOf('.') === -1) {
      this.massStr = this.massStr ? this.massStr + '.' : '0.'
    }
  },

  onDel() {
    this.massStr = this.massStr.slice(0, -1)
  },

  onCompute() {
    this.showKeyboard = false
    const m = parseFloat(this.massStr)
    if (isNaN(m) || m <= 0) { prompt.showToast({ message: '请输入有效质量', duration: 1500 }); return }

    let out = null
    try {
      out = computeMasses(this._rxn, this.knownIdx, m)
    } catch (err) {
      out = null
    }
    if (!out) { prompt.showToast({ message: '计算失败', duration: 1500 }); return }

    const r = this._rxn
    const rows = []
    for (let i = 0; i < out.length; i++) {
      const isKnown = i === this.knownIdx
      rows.push({
        text: (isKnown ? '● ' : '') + segsToText(r.segs[i], r.coefs[i]),
        massText: fmtNum(out[i].mass),
        molText: 'n ≈ ' + fmtNum(out[i].mol) + ' mol' + (isKnown ? ' · 已知' : ''),
        known: isKnown,
        rid: 'q' + i
      })
    }
    this.resultRows = rows
    this.hasResult = true
  },

  goReaction() {
    router.push({ uri: 'pages/reaction' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKeyboard) this.showKeyboard = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* ---- 无数据兜底 ---- */
.none-wrap {
  position: absolute;
  left: 0px;
  top: 102px;
  width: 336px;
  height: 378px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.none-img {
  width: 96px;
  height: 96px;
}
.none-tip {
  margin-top: 16px;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.4);
}
.none-btn {
  margin-top: 24px;
}

/* ---- 主体（absolute 顶层挂载，坐标固定） ---- */
.sec-label {
  position: absolute;
  left: 16px;
  top: 106px;
  width: 304px;
  font-size: 20px;
  line-height: 24px;
  color: rgba(255, 255, 255, 0.45);
}
.res-label {
  top: 246px;
}

.chip-scroll {
  position: absolute;
  left: 6px;
  top: 134px;
  width: 324px;
  height: 44px;
}
.chip-row {
  flex-direction: row;
}
.chip {
  height: 42px;
  border-radius: 21px;
  background-color: #262626;
  padding: 0 18px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.chip-on {
  height: 42px;
  border-radius: 21px;
  background-color: #0d6eff;
  padding: 0 18px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.chip-t {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.72);
}
.chip-t-on {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

/* ---- 输入质量 + 计算（bottom 242 <= 252 键盘遮挡区之上） ---- */
.mass-field {
  position: absolute;
  left: 6px;
  top: 186px;
  width: 208px;
  height: 56px;
  border-radius: 28px;
  background-color: #262626;
  padding: 0 18px;
  justify-content: center;
}
.mass-field-v {
  font-size: 26px;
  color: #ffffff;
  font-weight: bold;
}
.mass-field-h {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.35);
}
.calc-btn {
  position: absolute;
  left: 222px;
  top: 186px;
  width: 108px;
  height: 56px;
  border-radius: 28px;
}
.calc-btn .btn-main-t {
  font-size: 24px;
}

.res-list {
  position: absolute;
  left: 6px;
  top: 274px;
  width: 324px;
  height: 198px;
}
/* list-item：静态 class + 显式行高/间距（known 行用文本前缀标记，不用动态 class） */
.res-row {
  width: 100%;
  height: 62px;
  border-radius: 24px;
  background-color: #262626;
  padding: 6px 18px;
  margin-bottom: 8px;
  flex-direction: column;
  justify-content: center;
}
.res-line {
  width: 288px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.res-f {
  font-size: 22px;
  color: #ffffff;
}
.res-m {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}
.res-mol {
  font-size: 16px;
  line-height: 20px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 1px;
}
</style>
