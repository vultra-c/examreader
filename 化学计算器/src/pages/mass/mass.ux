<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 质量计算页（336×480）
  流程：选择已知物质 → 输入质量（数字键盘）→ 计算 → 列出全部物质质量/物质的量。
  支持任选反应物或生成物（含反向推算）。输入区全部位于键盘遮挡区之上。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">质量计算</text>
      <div class="hd-hold"></div>
    </div>

    <!-- 无反应数据兜底 -->
    <div if="{{!valid}}" class="none-wrap">
      <text class="none-tip">还没有可用的反应方程式</text>
      <div class="none-btn" @click="goReaction">
        <text class="none-btn-t">去反应计算</text>
      </div>
    </div>

    <div if="{{valid}}" class="body">
      <!-- 1 · 选已知物质 -->
      <text class="sec-label">选择已知质量的物质</text>
      <scroll scroll-x="true" class="chip-scroll">
        <div class="chip-row">
          <div class="{{knownIdx == $item.idx ? 'chip-on' : 'chip'}}"
               for="{{selRows}}" tid="rid" @click="onSelect($item)">
            <text class="{{knownIdx == $item.idx ? 'chip-t-on' : 'chip-t'}}">{{$item.text}}</text>
          </div>
        </div>
      </scroll>

      <!-- 2 · 输入质量 + 计算（同一行，均在键盘区之上） -->
      <div class="row2">
        <div class="mass-field" @click="toggleKb">
          <text if="{{massStr.length > 0}}" class="mass-field-v">{{massStr}} g</text>
          <text else class="mass-field-h">质量(克)</text>
        </div>
        <div class="calc-btn" @click="onCompute">
          <text class="calc-btn-t">计算</text>
        </div>
      </div>

      <!-- 3 · 结果（list + list-item，样式在 list-item 上；show 常驻） -->
      <text show="{{hasResult}}" class="sec-label res-label">各物质质量</text>
      <list show="{{hasResult}}" class="res-list">
        <list-item for="{{resultRows}}" tid="rid" type="res" class="{{$item.known ? 'res-row-known' : 'res-row'}}">
          <div class="res-line">
            <text class="res-f">{{$item.text}}</text>
            <text class="res-m">{{$item.massText}} g</text>
          </div>
          <text class="res-mol">n ≈ {{$item.molText}} mol</text>
        </list-item>
      </list>
    </div>

    <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="8"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { computeMasses } from '../../common/logic/stoich.js'
import { fmtNum } from '../../common/logic/parser.js'

const SUB = { '0': '₀', '1': '₁', '2': '₂', '3': '₃', '4': '₄', '5': '₅', '6': '₆', '7': '₇', '8': '₈', '9': '₉' }

function subDigit(num) {
  return String(num).split('').map(c => SUB[c] || c).join('')
}

function segsToText(segs, coef) {
  let s = ''
  for (let i = 0; i < segs.length; i++) {
    const seg = segs[i]
    if (seg.t === 'num') s += subDigit(seg.s)
    else s += seg.s
  }
  return (coef > 1 ? coef : '') + s
}

export default {
  protected: {
    valid: false,
    selRows: [],
    knownIdx: 0,
    massStr: '',
    showKeyboard: false,
    hasResult: false,
    resultRows: []
  },

  onInit() {
    const r = this.$app.$def.reaction
    if (!r || !r.coefs || !r.segs || !Array.isArray(r.coefs) || !Array.isArray(r.segs) || r.coefs.length === 0 || r.coefs.length !== r.segs.length) {
      this.valid = false
      return
    }
    this.valid = true
    this._rxn = r

    const wantIdx = this.$app.$def.massKnownIdx
    this.knownIdx = (typeof wantIdx === 'number' && wantIdx >= 0 && wantIdx < r.coefs.length) ? wantIdx : 0

    const rows = []
    for (let i = 0; i < r.coefs.length; i++) {
      rows.push({ text: segsToText(r.segs[i], r.coefs[i]), idx: i, rid: 's' + i })
    }
    this.selRows = rows
    try {
      this.$app.$def.massKnownIdx = this.knownIdx
    } catch (err) {}
  },

  onSelect(item) {
    this.knownIdx = item.idx
    this.hasResult = false
    this.resultRows = []
    this.showKeyboard = false
  },

  toggleKb() {
    this.showKeyboard = !this.showKeyboard
  },

  onInput(e) {
    const value = e && e.detail ? String(e.detail.content || '') : ''
    if (/^[0-9]$/.test(value)) {
      if (this.massStr.replace('.', '').length < 8) {
        if (this.massStr === '0') this.massStr = ''
        this.massStr += value
      }
    } else if (value === '.' && this.massStr.indexOf('.') === -1) {
      this.massStr = this.massStr ? this.massStr + '.' : '0.'
    }
  },

  onDel() {
    this.massStr = this.massStr.slice(0, -1)
  },

  onCompute() {
    this.showKeyboard = false
    const m = parseFloat(this.massStr)
    if (isNaN(m) || m <= 0) { prompt.showToast({ message: '请输入有效质量', duration: 1500 }); return }

    let out = null
    try {
      out = computeMasses(this._rxn, this.knownIdx, m)
    } catch (err) {
      out = null
    }
    if (!out) { prompt.showToast({ message: '计算失败', duration: 1500 }); return }

    const r = this._rxn
    const rows = []
    for (let i = 0; i < out.length; i++) {
      rows.push({
        text: segsToText(r.segs[i], r.coefs[i]),
        massText: fmtNum(out[i].mass),
        molText: fmtNum(out[i].mol),
        known: i === this.knownIdx,
        rid: 'q' + i
      })
    }
    this.resultRows = rows
    this.hasResult = true
  },

  goReaction() {
    router.push({ uri: 'pages/reaction' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKeyboard) this.showKeyboard = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 48px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px 0 12px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

/* ---- 无数据兜底 ---- */
.none-wrap {
  width: 336px;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.none-tip {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.45);
}
.none-btn {
  width: 190px;
  height: 52px;
  border-radius: 26px;
  background-color: #0d6eff;
  justify-content: center;
  align-items: center;
  margin-top: 18px;
}
.none-btn-t {
  font-size: 23px;
  font-weight: bold;
  color: #ffffff;
}

/* ---- 主体 ---- */
.body {
  width: 336px;
  flex-direction: column;
  padding: 0 16px;
}

.sec-label {
  width: 304px;
  font-size: 16px;
  line-height: 20px;
  color: rgba(255, 255, 255, 0.45);
  margin: 2px 2px 4px;
}
.res-label {
  margin-top: 10px;
}

.chip-scroll {
  width: 304px;
  height: 42px;
}
.chip-row {
  flex-direction: row;
}
.chip {
  height: 40px;
  border-radius: 20px;
  background-color: #1c1c1e;
  padding: 0 16px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.chip-on {
  height: 40px;
  border-radius: 20px;
  background-color: #0d6eff;
  padding: 0 16px;
  margin-right: 8px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.chip-t {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.72);
}
.chip-t-on {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.row2 {
  width: 304px;
  height: 50px;
  margin-top: 8px;
  flex-direction: row;
  justify-content: space-between;
}
.mass-field {
  width: 190px;
  height: 50px;
  border-radius: 25px;
  background-color: #161618;
  border-width: 1px;
  border-color: #2e2e33;
  padding: 0 14px;
  justify-content: center;
}
.mass-field-v {
  font-size: 25px;
  color: #ffffff;
  font-weight: bold;
}
.mass-field-h {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.35);
}
.calc-btn {
  width: 106px;
  height: 50px;
  border-radius: 25px;
  background-color: #0d6eff;
  justify-content: center;
  align-items: center;
}
.calc-btn-t {
  font-size: 23px;
  font-weight: bold;
  color: #ffffff;
}

.res-list {
  width: 304px;
  height: 168px;
  margin-top: 4px;
}
/* list-item 本身带高度/内边距/间距 */
.res-row {
  width: 100%;
  height: 62px;
  border-radius: 14px;
  background-color: #1c1c1e;
  padding: 6px 14px;
  margin-bottom: 6px;
  flex-direction: column;
  justify-content: center;
}
.res-row-known {
  width: 100%;
  height: 62px;
  border-radius: 14px;
  background-color: rgba(13, 110, 255, 0.28);
  padding: 6px 14px;
  margin-bottom: 6px;
  flex-direction: column;
  justify-content: center;
}
.res-line {
  width: 276px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.res-f {
  font-size: 22px;
  color: #ffffff;
}
.res-m {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}
.res-mol {
  font-size: 15px;
  line-height: 20px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 1px;
}
</style>
