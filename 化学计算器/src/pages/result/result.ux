<!--
  化学工具箱 · 反应结果页（336×480，闪念小抄风格）

  性能要点：整条方程式（含系数与 Unicode 下标）在 JS 里拼成「一个字符串」，
  模板里只有一个 text 节点自动折行 —— 相比逐段多节点渲染大幅减少 VDOM 规模。
  主体全部 absolute 顶层挂载；mr-list 列表行静态 class + 显式行高 + div 包裹。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 无数据兜底 -->
    <text if="{{!valid}}" class="none-tip">未找到反应数据</text>

    <!-- 方程式卡片（小抄深色大圆角卡片） -->
    <div if="{{valid}}" class="eq-card">
      <text class="eq-text">{{eqText}}</text>
      <text if="{{condText}}" class="eq-cond">{{condText}}</text>
      <div class="eq-badge">
        <text class="eq-badge-t">{{rxnType}}</text>
      </div>
    </div>

    <text if="{{valid}}" class="sec-label">相对分子质量 · 点按进入质量计算</text>
    <list if="{{valid}}" class="mr-list">
      <list-item for="{{mrRows}}" tid="rid" type="mr" class="mr-row" @click="onPickMass($item)">
        <div class="mr-content">
          <text class="mr-f">{{$item.text}}</text>
          <text class="mr-v">M = {{$item.mrText}}</text>
        </div>
      </list-item>
    </list>

    <!-- 底部操作 -->
    <div if="{{valid}}" class="btn-ghost foot-back" @click="goBack">
      <text class="btn-ghost-t">返回修改</text>
    </div>
    <div if="{{valid}}" class="btn-main foot-mass" @click="goMass">
      <text class="btn-main-t">质量计算</text>
    </div>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">配平结果</text>
    <text static class="hd-title">反应方程式</text>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { fmtNum } from '../../common/logic/parser.js'
import { segsToText } from '../../common/logic/fmt.js'

export default {
  protected: {
    valid: false,
    eqText: '',
    condText: '',
    rxnType: '',
    mrRows: []
  },

  onInit() {
    const r = this.$app.$def.reaction
    if (!r) { this.valid = false; return }
    this.valid = true

    // 整条方程式单字符串：aX + bY = cZ
    const nR = r.reactants.length
    const parts = []
    for (let i = 0; i < r.coefs.length; i++) {
      if (i === nR) parts.push('=')
      else if (i > 0) parts.push('+')
      parts.push(segsToText(r.segs[i], r.coefs[i]))
    }
    let text = ''
    for (let i = 0; i < parts.length; i++) {
      text += (i > 0 ? ' ' : '') + parts[i]
    }
    this.eqText = text
    this.condText = r.cond ? '条件：' + r.cond : ''

    const rows = []
    for (let i = 0; i < r.coefs.length; i++) {
      rows.push({ text: segsToText(r.segs[i], r.coefs[i]), mrText: fmtNum(r.mr[i]), idx: i, rid: 'm' + i })
    }
    this.mrRows = rows
    this.rxnType = r.type
  },

  onPickMass(item) {
    try {
      this.$app.$def.massKnownIdx = item.idx
    } catch (err) {}
    router.push({ uri: 'pages/mass' })
  },

  goMass() { router.push({ uri: 'pages/mass' }) },
  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.none-tip {
  position: absolute;
  left: 0px;
  top: 220px;
  width: 336px;
  text-align: center;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.35);
}

/* ---- 方程式卡片（小抄深色大圆角卡片，固定高 200） ---- */
.eq-card {
  position: absolute;
  left: 6px;
  top: 108px;
  width: 324px;
  height: 196px;
  border-radius: 36px;
  background-color: #262626;
  padding: 14px 20px;
  flex-direction: column;
  align-items: center;
}
.eq-text {
  width: 284px;
  font-size: 28px;
  line-height: 40px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 3;
  text-overflow: ellipsis;
}
.eq-cond {
  font-size: 20px;
  line-height: 26px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4px;
  text-align: center;
}
.eq-badge {
  padding: 4px 18px;
  border-radius: 15px;
  background-color: rgba(13, 110, 255, 0.22);
  margin-top: 6px;
}
.eq-badge-t {
  font-size: 19px;
  color: #4da3ff;
}

.sec-label {
  position: absolute;
  left: 16px;
  top: 310px;
  width: 304px;
  font-size: 20px;
  line-height: 24px;
  color: rgba(255, 255, 255, 0.45);
}

.mr-list {
  position: absolute;
  left: 6px;
  top: 338px;
  width: 324px;
  height: 74px;
}
/* list-item：静态 class + 显式行高/间距，内容内层 div 包裹 */
.mr-row {
  width: 100%;
  height: 62px;
  border-radius: 24px;
  background-color: #262626;
  padding: 0 18px;
  margin-bottom: 8px;
}
.mr-content {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.mr-f {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}
.mr-v {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.72);
}

/* ---- 底部操作（56 高，bottom <= 472） ---- */
.foot-back {
  position: absolute;
  left: 6px;
  top: 418px;
  width: 158px;
  height: 56px;
  border-radius: 28px;
}
.foot-mass {
  position: absolute;
  left: 172px;
  top: 418px;
  width: 158px;
  height: 56px;
  border-radius: 28px;
}
.foot-back .btn-ghost-t {
  font-size: 24px;
}
.foot-mass .btn-main-t {
  font-size: 24px;
}
</style>
