<!--
  化学工具箱 · 反应结果页（336×480）

  性能要点：整条方程式（含系数与 Unicode 下标）在 JS 里拼成「一个字符串」，
  模板里只有一个 text 节点自动折行 —— 相比逐段多节点渲染大幅减少 VDOM 规模。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">反应方程式</text>
      <div class="hd-hold"></div>
    </div>

    <!-- 无数据兜底 -->
    <text if="{{!valid}}" class="none-tip">未找到反应数据</text>

    <!-- 主体（全部 absolute 顶层挂载，坐标固定，避免 flex 测量导致列表行塌陷） -->
    <div if="{{valid}}" class="eq-card">
      <text class="eq-text">{{eqText}}</text>
      <text if="{{condText}}" class="eq-cond">{{condText}}</text>
      <div class="eq-badge">
        <text class="eq-badge-t">{{rxnType}}</text>
      </div>
    </div>

    <text if="{{valid}}" class="sec-label">相对分子质量 · 点按进入质量计算</text>
    <list if="{{valid}}" class="mr-list">
      <list-item for="{{mrRows}}" tid="rid" type="mr" class="mr-row" @click="onPickMass($item)">
        <div class="mr-content">
          <text class="mr-f">{{$item.text}}</text>
          <text class="mr-v">M = {{$item.mrText}}</text>
        </div>
      </list-item>
    </list>

    <!-- 底部操作 -->
    <div if="{{valid}}" class="foot">
      <div class="foot-btn" @click="goBack">
        <text class="foot-btn-t">返回修改</text>
      </div>
      <div class="foot-btn foot-btn-main" @click="goMass">
        <text class="foot-btn-t-main">质量计算</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { fmtNum } from '../../common/logic/parser.js'
import { segsToText } from '../../common/logic/fmt.js'

export default {
  protected: {
    valid: false,
    eqText: '',
    condText: '',
    rxnType: '',
    mrRows: []
  },

  onInit() {
    const r = this.$app.$def.reaction
    if (!r) { this.valid = false; return }
    this.valid = true

    // 整条方程式单字符串：aX + bY = cZ
    const nR = r.reactants.length
    const parts = []
    for (let i = 0; i < r.coefs.length; i++) {
      if (i === nR) parts.push('=')
      else if (i > 0) parts.push('+')
      parts.push(segsToText(r.segs[i], r.coefs[i]))
    }
    let text = ''
    for (let i = 0; i < parts.length; i++) {
      if (i > 0 && parts[i] !== '=' && parts[i] !== '+') text += ' '
      else if (i > 0) text += ' '
      text += parts[i]
    }
    this.eqText = text
    this.condText = r.cond ? '条件：' + r.cond : ''

    const rows = []
    for (let i = 0; i < r.coefs.length; i++) {
      rows.push({ text: segsToText(r.segs[i], r.coefs[i]), mrText: fmtNum(r.mr[i]), idx: i, rid: 'm' + i })
    }
    this.mrRows = rows
    this.rxnType = r.type
  },

  onPickMass(item) {
    try {
      this.$app.$def.massKnownIdx = item.idx
    } catch (err) {}
    router.push({ uri: 'pages/mass' })
  },

  goMass() { router.push({ uri: 'pages/mass' }) },
  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 66px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 0 12px;
}
.hd-back {
  width: 48px;
  height: 48px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 36px;
  line-height: 40px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 48px;
  height: 48px;
}

.none-tip {
  position: absolute;
  left: 0px;
  top: 200px;
  width: 336px;
  text-align: center;
  font-size: 24px;
  color: rgba(255, 255, 255, 0.35);
}

/* ---- 主体（absolute 顶层挂载，坐标固定） ---- */
.eq-card {
  position: absolute;
  left: 16px;
  top: 68px;
  width: 304px;
  height: 200px;
  border-radius: 20px;
  background-color: #161618;
  border-width: 1px;
  border-color: #2e2e33;
  padding: 12px 14px;
  flex-direction: column;
  align-items: center;
}
.eq-text {
  width: 276px;
  font-size: 26px;
  line-height: 38px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  lines: 3;
  text-overflow: ellipsis;
}
.eq-cond {
  font-size: 19px;
  line-height: 25px;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4px;
  text-align: center;
}
.eq-badge {
  padding: 4px 16px;
  border-radius: 13px;
  background-color: rgba(13, 110, 255, 0.18);
  margin-top: 6px;
}
.eq-badge-t {
  font-size: 18px;
  color: #4da3ff;
}

.sec-label {
  position: absolute;
  left: 18px;
  top: 276px;
  width: 300px;
  font-size: 17px;
  line-height: 20px;
  color: rgba(255, 255, 255, 0.45);
}

.mr-list {
  position: absolute;
  left: 16px;
  top: 300px;
  width: 304px;
  height: 122px;
}
/* list-item：静态 class + 显式行高/间距，内容内层 div 包裹 */
.mr-row {
  width: 100%;
  height: 50px;
  border-radius: 14px;
  background-color: #1c1c1e;
  padding: 0 14px;
  margin-bottom: 6px;
}
.mr-content {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.mr-f {
  font-size: 22px;
  color: #ffffff;
}
.mr-v {
  font-size: 21px;
  color: rgba(255, 255, 255, 0.72);
}

.foot {
  position: absolute;
  left: 16px;
  top: 428px;
  width: 304px;
  height: 48px;
  flex-direction: row;
  justify-content: space-between;
}
.foot-btn {
  width: 147px;
  height: 48px;
  border-radius: 24px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.foot-btn-main {
  background-color: #0d6eff;
}
.foot-btn-t {
  font-size: 24px;
  color: rgba(255, 255, 255, 0.8);
}
