<import name="formula-text" src="../../components/FormulaText/FormulaText.ux"></import>

<template>
  <div class="page" @swipe="onSwipe">
    <!-- 标题栏 -->
    <div class="topbar">
      <div class="topbar-back" @click="goBack"><text class="topbar-back-text">‹</text></div>
      <text class="topbar-title">反应方程式</text>
    </div>

    <list class="body-list">
      <list-item type="warn" class="li-full" show="{{!valid}}">
        <text class="empty-tip">未找到反应数据</text>
      </list-item>

      <list-item type="eq" class="li-full" show="{{valid}}">
        <div class="equation-box">
          <div class="eq-line">
            <block for="{{eqParts}}">
              <text if="{{$item.op}}" class="eq-op">{{$item.op}}</text>
              <formula-text segs="{{$item.segs}}" coef="{{$item.coef}}"></formula-text>
            </block>
          </div>
          <text class="cond-text">{{condText}}</text>
          <div class="type-badge">
            <text class="type-badge-text">{{rxnType}}</text>
          </div>
        </div>
      </list-item>

      <list-item type="mrhdr" class="li-full" show="{{valid}}">
        <text class="group-header">相对分子质量</text>
      </list-item>
      <list-item type="mrrow" for="{{mrRows}}" show="{{valid}}">
        <div class="mr-row" @click="onPickMass($item)">
          <formula-text segs="{{$item.segs}}" coef="{{$item.coef}}"></formula-text>
          <text class="mr-value">M = {{$item.mrText}}</text>
        </div>
      </list-item>

      <list-item type="btns" class="li-full" show="{{valid}}">
        <div style="flex-direction: row; justify-content: space-between; width: 316px;">
          <div class="btn-secondary" @click="goBack">
            <text class="btn-secondary-text">重新输入</text>
          </div>
          <div class="btn-secondary" style="background-color:#0D6EFF;" @click="goMass">
            <text class="btn-secondary-text" style="color:#ffffff; font-weight:bold;">质量计算 →</text>
          </div>
        </div>
      </list-item>
      <list-item type="pad2" class="li-full" show="{{valid}}">
        <div style="height: 30px;"></div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import { fmtNum } from '../../common/logic/parser.js'

export default {
  protected: {
    valid: false,
    eqParts: [],
    mrRows: [],
    rxnType: '',
    condText: ''
  },

  onInit() {
    const r = this.$app.$data.reaction
    if (!r) { this.valid = false; return }
    this.valid = true

    const nR = r.reactants.length
    const parts = []
    for (let i = 0; i < r.coefs.length; i++) {
      let op = ''
      if (i > 0) op = i === nR ? '=' : '+'
      parts.push({ segs: r.segs[i], coef: r.coefs[i], op, pid: 'p' + i })
    }
    this.eqParts = parts

    this.mrRows = []
    for (let i = 0; i < r.coefs.length; i++) {
      this.mrRows.push({ segs: r.segs[i], coef: r.coefs[i], mrText: fmtNum(r.mr[i]), idx: i, mid: 'm' + i })
    }

    this.rxnType = r.type
    this.condText = r.cond ? ('条件：' + r.cond) : '—'
  },

  onPickMass(item) {
    this.$app.$data.massKnownIdx = item.idx
    router.push({ uri: 'pages/mass' })
  },

  goMass() { router.push({ uri: 'pages/mass' }) },
  goBack() { router.back() },

  onSwipe(e) {
    if (e.direction === 'right') router.back()
  }
}
</script>

<style>
@import '../../common/style.css';
.li-full { width: 316px; }
</style>
