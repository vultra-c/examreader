<template>
  <div class="page" @swipe="onSwipe">
    <!-- 标题栏 -->
    <div class="topbar">
      <div class="topbar-back" @click="goBack"><text class="topbar-back-text">‹</text></div>
      <text class="topbar-title">反应方程式</text>
    </div>

    <div if="{{!valid}}" style="position:absolute; top:180px; width:336px;">
      <text style="text-align:center; color:rgba(255,255,255,0.35); font-size:24px;">未找到反应数据</text>
    </div>

    <div if="{{valid}}" style="position:absolute; top:88px; left:10px; width:316px;">
      <!-- 方程式 -->
      <div class="equation-box">
        <div class="eq-line">
          <block for="{{eqParts}}">
            <text if="{{$item.op}}" class="eq-op">{{$item.op}}</text>
            <text class="eq-formula" style="font-size:30px;color:#fff;margin:0 2px;">{{$item.text}}</text>
          </block>
        </div>
        <text class="cond-text">{{condText}}</text>
        <div class="type-badge">
          <text class="type-badge-text">{{rxnType}}</text>
        </div>
      </div>

      <!-- 相对分子质量 -->
      <text class="group-header">相对分子质量</text>
      <scroll scroll-y="true" style="width:316px;height:180px;">
        <div class="mr-row" for="{{mrRows}}" @click="onPickMass($item)">
          <text class="mr-formula">{{$item.text}}</text>
          <text class="mr-value">M = {{$item.mrText}}</text>
        </div>
      </scroll>

      <!-- 操作按钮 -->
      <div style="flex-direction: row; justify-content: space-between; width: 316px; margin-top: 8px;">
        <div class="btn-secondary" @click="goBack">
          <text class="btn-secondary-text">重新输入</text>
        </div>
        <div class="btn-secondary" style="background-color:#0D6EFF;" @click="goMass">
          <text class="btn-secondary-text" style="color:#ffffff; font-weight:bold;">质量计算 →</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fmtNum } from '../../common/logic/parser.js'

export default {
  protected: {
    valid: false,
    eqParts: [],
    mrRows: [],
    rxnType: '',
    condText: ''
  },

  onInit() {
    const r = this.$app.$data.reaction
    if (!r) { this.valid = false; return }
    this.valid = true

    const nR = r.reactants.length
    const parts = []
    for (let i = 0; i < r.coefs.length; i++) {
      let op = ''
      if (i > 0) op = i === nR ? '=' : '+'
      parts.push({ text: this.renderSub(r.segs[i], r.coefs[i]), op, pid: 'p' + i })
    }
    this.eqParts = parts

    this.mrRows = []
    for (let i = 0; i < r.coefs.length; i++) {
      this.mrRows.push({ text: this.renderSub(r.segs[i], r.coefs[i]), mrText: fmtNum(r.mr[i]), idx: i, mid: 'm' + i })
    }

    this.rxnType = r.type
    this.condText = r.cond ? ('条件：' + r.cond) : '—'
  },

  // 渲染化学式（数字下标用普通数字展示，Vela text 不支持真实下标，用 Unicode 下标）
  renderSub(segs, coef) {
    let s = ''
    for (const seg of segs) {
      if (seg.t === 'el') s += seg.s
      else if (seg.t === 'num') s += this.subDigit(seg.s)
      else s += seg.s
    }
    return (coef > 1 ? coef : '') + s
  },

  subDigit(num) {
    const map = { '0':'₀','1':'₁','2':'₂','3':'₃','4':'₄','5':'₅','6':'₆','7':'₇','8':'₈','9':'₉' }
    return String(num).split('').map(c => map[c] || c).join('')
  },

  onPickMass(item) {
    this.$app.$data.massKnownIdx = item.idx
    router.push({ uri: 'pages/mass' })
  },

  goMass() { router.push({ uri: 'pages/mass' }) },
  goBack() { router.back() },

  onSwipe(e) {
    if (e.direction === 'right') router.back()
  }
}
</script>

<style>
@import '../../common/style.css';
</style>
