  width: 336px;
  height: 66px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 16px 0 18px;
}
.hd-title {
  font-size: 34px;
  line-height: 42px;
  font-weight: bold;
  color: #ffffff;
}
.hd-btn {
  min-width: 96px;
  height: 44px;
  border-radius: 22px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
  padding: 0 16px;
}
.hd-btn-t {
  font-size: 22px;
  color: rgba(255, 255, 255, 0.75);
}
.hd-btn-t-on {
  font-size: 22px;
  font-weight: bold;
  color: #0d84ff;
}

/* ---- 模式切换 ---- */
.seg {
  width: 304px;
  height: 52px;
  margin: 10px 16px 0;
  border-radius: 26px;
  background-color: #1a1a1c;
  flex-direction: row;
}
.seg-cell {
  width: 152px;
  height: 52px;
  border-radius: 26px;
  background-color: #1a1a1c;
  justify-content: center;
  align-items: center;
}
.seg-cell-on {
  width: 152px;
  height: 52px;
  border-radius: 26px;
  background-color: #0d6eff;
  justify-content: center;
  align-items: center;
}
.seg-t {
  font-size: 25px;
  color: rgba(255, 255, 255, 0.55);
}
.seg-t-on {
  font-size: 25px;
  font-weight: bold;
  color: #ffffff;
}

/* ---- 输入卡片 ---- */
.input-card {
  width: 304px;
  height: 90px;
  margin: 10px 16px 0;
  border-radius: 22px;
  background-color: #161618;
  border-width: 1px;
  border-color: #2e2e33;
  padding: 10px 16px;
  justify-content: center;
}
.input-empty {
  flex-direction: column;
}
.input-ph-main {
  font-size: 23px;
  line-height: 31px;
  color: rgba(255, 255, 255, 0.6);
}
.input-ph-sub {
  font-size: 18px;
  line-height: 25px;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 3px;
}
.input-value {
  width: 272px;
  font-size: 26px;
  line-height: 34px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}
.input-caret {
  font-size: 26px;
  color: #0d84ff;
}

/* ---- 主操作 ---- */
.act {
  width: 304px;
  height: 58px;
  margin: 10px 16px 0;
  border-radius: 29px;
  background-color: #0d6eff;
  justify-content: center;
  align-items: center;
}
.act-t {
  font-size: 27px;
  font-weight: bold;
  color: #ffffff;
}

/* ---- 四宫格 ---- */
.grid {
  width: 304px;
  height: 126px;
  margin: 10px 16px 0;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-between;
}
.g-card {
  width: 147px;
  height: 58px;
  border-radius: 18px;
  background-color: #1c1c1e;
  flex-direction: row;
  align-items: center;
  padding-left: 9px;
}
.g-icon {
  width: 40px;
  height: 40px;
  border-radius: 13px;
  background-color: rgba(13, 110, 255, 0.22);
  justify-content: center;
  align-items: center;
  margin-right: 8px;
}
.g-icon-alt {
  background-color: rgba(48, 176, 122, 0.22);
}
.g-icon-warn {
  background-color: rgba(255, 159, 10, 0.2);
}
.g-icon-t {
  font-size: 22px;
  font-weight: bold;
  color: #4da3ff;
}
.g-icon-t-alt {
  font-size: 22px;
  font-weight: bold;
  color: #35d08e;
}
.g-icon-t-warn {
  font-size: 22px;
  font-weight: bold;
  color: #ffb340;
}
.g-copy {
  width: 88px;
  flex-direction: column;
}
.g-title {
  font-size: 20px;
  line-height: 26px;
  font-weight: bold;
  color: #ffffff;
}
.g-sub {
  font-size: 14px;
  line-height: 19px;
  color: rgba(255, 255, 255, 0.4);
  lines: 1;
  text-overflow: ellipsis;
}

/* ---- 结果/目录面板 ---- */
.panel {
  width: 304px;
  height: 184px;
  margin: 10px 16px 0;
  border-radius: 20px;
  background-color: #141416;
  border-width: 1px;
  border-color: #2a2a30;
  flex-direction: column;
  padding: 10px 12px;
}
.panel-hd {
  width: 280px;
  height: 30px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.panel-hd-t {
  font-size: 21px;
  font-weight: bold;
  color: #ffffff;
}
