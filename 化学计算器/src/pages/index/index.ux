<!--
  化学工具箱 · 主页（336×480）
  闪念小抄 UI 风格：hd.png 顶栏 + 双行居中标题 + 112px 大圆角功能卡片列表。
  右滑 / 返回键退出应用。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 功能卡片列表（分块无需，4 项一次渲染） -->
    <list class="list" id="menuList">
      <list-item for="{{menu}}" tid="id" class="item" type="menu" @click="go($item)">
        <div class="item-content">
          <text class="itemtext">{{$item.title}}</text>
          <text class="itemtext2">{{$item.sub}}</text>
        </div>
        <img static src="/common/images/enter.png" class="arrow" />
      </list-item>
    </list>

    <!-- 顶栏（闪念小抄同款：底图 + 返回 + 双行居中标题） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="exitApp" />
    <text static class="hd-sub">离线化学计算</text>
    <text static class="hd-title">化学工具箱</text>

  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'

export default {
  private: {
    menu: [
      { id: 'm1', uri: 'pages/reaction', title: '反应计算', sub: '输入反应物，自动推导并配平' },
      { id: 'm2', uri: 'pages/element', title: '元素查询', sub: '按元素或名称查找方程式' },
      { id: 'm3', uri: 'pages/mass', title: '质量计算', sub: '已知一种质量，推算全部物质' },
      { id: 'm4', uri: 'pages/catalog', title: '常用物质表', sub: '浏览常见物质，点选填入' }
    ]
  },

  go(item) {
    if (item && item.uri) {
      router.push({ uri: item.uri })
    }
  },
  exitApp() {
    app.terminate()
  },
  onSwipe(e) {
    if (e && e.direction === 'right') {
      app.terminate()
    }
  },
  onBackPress() {
    app.terminate()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';
</style>
