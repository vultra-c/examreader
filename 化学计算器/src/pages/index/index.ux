<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" @swipe="onSwipe">
    <!-- 标题栏 -->
    <div class="topbar">
      <text class="topbar-title">化学工具箱</text>
      <text class="topbar-sub" style="margin-left:8px;">离线反应推导</text>
    </div>

    <!-- 输入显示（点击弹出键盘） -->
    <div class="input-box" @click="toggleKb">
      <text if="{{inputStr}}" class="input-text">{{inputStr}}</text>
      <text else class="input-hint">点击输入（空格=+ 或分隔元素）</text>
    </div>

    <!-- 模式切换 -->
    <div class="tab-row">
      <div class="tab {{mode === 'formula' ? 'tab-on' : ''}}" @click="setMode('formula')">
        <text class="{{mode === 'formula' ? 'ton' : 'toff'}}">化学式</text>
      </div>
      <div class="tab {{mode === 'name' ? 'tab-on' : ''}}" @click="setMode('name')">
        <text class="{{mode === 'name' ? 'ton' : 'toff'}}">名称</text>
      </div>
      <div class="tab {{mode === 'element' ? 'tab-on' : ''}}" @click="setMode('element')">
        <text class="{{mode === 'element' ? 'ton' : 'toff'}}">元素</text>
      </div>
    </div>

    <!-- 操作按钮（键盘打开时也可见） -->
    <div class="action-btn" @click="onAction">
      <text class="action-btn-t">{{mode === 'element' ? '查询元素' : '开始推导配平'}}</text>
    </div>

    <!-- 化学式模式提示 -->
    <div if="{{mode === 'formula' && !showKb}}" class="tip-area">
      <text class="tip-text">支持：Fe+CuSO4、Ca(OH)2、盐酸+烧碱（空格=+，点击输入框弹键盘）</text>
    </div>

    <!-- 名称模式：常用物质目录 -->
    <div if="{{mode === 'name' && !showKb}}" class="content-area">
      <scroll scroll-y="true" style="width:316px;height:100%;">
        <div class="ni" for="{{catalog}}" @click="pickName($item)">
          <text class="nt">{{$item}}</text>
        </div>
      </scroll>
    </div>

    <!-- 元素模式：查询结果 -->
    <div if="{{mode === 'element' && !showKb}}" class="content-area">
      <div if="{{elemSearched}}" style="flex-direction: column;">
        <text class="res-hint" if="{{elementResults.length == 0}}">没有找到同时含有这些元素的方程式</text>
        <scroll scroll-y="true" style="width:316px;height:100%;" if="{{elementResults.length > 0}}">
          <div class="eq-item" for="{{elementResults}}" @click="openEquation($item)">
            <text class="eq-text">{{$item.text}}</text>
            <text class="eq-type">{{$item.type}}</text>
          </div>
        </scroll>
      </div>
      <div if="{{!elemSearched}}" style="flex-direction: column;">
        <text class="tip-text">输入 1-3 个元素（空格分隔），如：Fe O / Na C O / Cu</text>
      </div>
    </div>

    <!-- 输入法（考点阅读器同款，中文+英文+日文） -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="60"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { splitInputTokens, resolveToken } from '../../common/logic/parser.js'
import { solveReaction } from '../../common/logic/reactions.js'
import { NAME_MAP, CATALOG, formulaName } from '../../common/logic/substances.js'
import { parseElementQuery, searchEquations, buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'

export default {
  private: {
    mode: 'formula',
    inputStr: '',
    showKb: false,
    catalog: [],
    elemSearched: false,
    elementResults: []
  },

  onInit() {
    const seen = {}; const list = []
    for (const g of CATALOG) {
      for (const f of g.items) {
        if (seen[f]) continue; seen[f] = true
        const n = formulaName(f)
        list.push(n && n !== f ? n : f)
      }
    }
    this.catalog = list
  },

  setMode(m) {
    this.mode = m
    this.showKb = false
    this.elemSearched = false
    if (m !== 'element') this.elementResults = []
  },

  toggleKb() {
    this.showKb = !this.showKb
  },

  // 输入法 complete 事件（逐字符）
  onInput(e) {
    if (!e || !e.detail) return
    const ch = e.detail.content
    if (this.mode === 'element') {
      if (ch === ' ' || ch === '，' || ch === ',' || ch === '+' || ch === '。') {
        if (!this.inputStr.endsWith(' ')) this.inputStr += ' '
      } else if (/^[A-Za-z0-9]$/.test(ch)) {
        this.inputStr += ch
      }
    } else if (this.mode === 'name') {
      // 中文/英文名称直接输入
      this.inputStr += ch
    } else {
      // 化学式模式：空格=+，字母智能大小写，数字与括号直接输入
      if (ch === ' ') {
        if (!this.inputStr || this.inputStr.endsWith('+')) return
        this.inputStr += '+'
      } else if (/^[A-Za-z]$/.test(ch)) {
        if (this.inputStr.length > 140) return
        const last = this.inputStr.split(/[+()\[\]]/).pop() || ''
        const needUpper = last === '' || /[0-9]$/.test(last)
        this.inputStr += needUpper ? ch.toUpperCase() : ch.toLowerCase()
      } else if (/^[0-9()\[\]]$/.test(ch)) {
        if (this.inputStr.length > 140) return
        this.inputStr += ch
      } else {
        this.inputStr += ch
      }
    }
  },

  onDel() {
    this.inputStr = this.inputStr.slice(0, -1)
  },

  pickName(name) {
    if (!this.inputStr || this.inputStr.endsWith('+')) {
      this.inputStr += name
    } else {
      this.inputStr += '+' + name
    }
    prompt.showToast({ message: '已加入', duration: 800 })
  },

  onAction() {
    if (this.mode === 'element') {
      this.doElementSearch()
    } else {
      this.calc()
    }
  },

  calc() {
    if (!this.inputStr) { prompt.showToast({ message: '请先输入反应物', duration: 1500 }); return }
    const tokens = splitInputTokens(this.inputStr)
    if (!tokens.length) { prompt.showToast({ message: '无有效反应物', duration: 1500 }); return }
    const formulas = []
    for (const t of tokens) {
      const r = resolveToken(t, NAME_MAP)
      if (!r.ok) { prompt.showToast({ message: r.error, duration: 2000 }); return }
      formulas.push(r.formula)
    }
    const res = solveReaction(formulas)
    if (!res.ok) { prompt.showToast({ message: res.error, duration: 2500 }); return }
    this.$app.$data.reaction = res.reaction
    router.push({ uri: 'pages/result' })
  },

  doElementSearch() {
    const q = parseElementQuery(this.inputStr)
    if (!q.ok) { prompt.showToast({ message: q.error, duration: 2000 }); return }
    const hits = searchEquations(q.elems, 50)
    this.elementResults = hits.map((entry, i) => ({
      text: equationText(entry),
      type: entry.t,
      entry: entry,
      rid: 'e' + i
    }))
    this.elemSearched = true
    this.showKb = false
    if (hits.length === 0) {
      prompt.showToast({ message: '未找到含这些元素的方程式', duration: 2000 })
    }
  },

  openEquation(item) {
    const reaction = buildReactionFromBank(item.entry)
    this.$app.$data.reaction = reaction
    router.push({ uri: 'pages/result' })
  },

  onSwipe(e) {
    if (e.direction === 'right') router.back()
  }
}
</script>

<style>
@import '../../common/style.css';

.topbar { position: absolute; top: 0px; left: 0px; width: 336px; height: 56px; flex-direction: row; align-items: center; padding-left: 12px; }
.topbar-title { font-size: 30px; font-weight: bold; color: #ffffff; }
.topbar-sub { font-size: 18px; color: rgba(255,255,255,0.45); margin-top: 2px; }

.input-box {
  position: absolute;
  top: 62px;
  left: 10px;
  width: 316px;
  min-height: 54px;
  background-color: #1a1a1c;
  border-radius: 16px;
  padding: 8px 14px;
  justify-content: center;
}
.input-text { font-size: 28px; color: #fff; lines: 2; text-overflow: ellipsis; }
.input-hint { font-size: 20px; color: rgba(255,255,255,0.35); }

.tab-row {
  position: absolute;
  top: 124px;
  left: 10px;
  width: 316px;
  flex-direction: row;
  justify-content: space-between;
}
.tab { width: 100px; height: 40px; border-radius: 12px; background-color: #262626; justify-content: center; align-items: center; }
.tab-on { background-color: #0D6EFF; }
.ton { font-size: 22px; font-weight: bold; color: #fff; }
.toff { font-size: 22px; color: rgba(255,255,255,0.6); }

.action-btn {
  position: absolute;
  top: 172px;
  left: 10px;
  width: 316px;
  height: 44px;
  background-color: #0D6EFF;
  border-radius: 16px;
  justify-content: center;
  align-items: center;
}
.action-btn-t { font-size: 24px; font-weight: bold; color: #fff; }

.content-area {
  position: absolute;
  top: 224px;
  left: 10px;
  width: 316px;
  height: 240px;
}

.tip-area {
  position: absolute;
  top: 224px;
  left: 10px;
  width: 316px;
}
.tip-text { font-size: 19px; color: rgba(255,255,255,0.35); line-height: 30px; }

.ni {
  background-color: #262626; border-radius: 12px;
  padding: 9px 14px; margin-bottom: 6px; width: 316px;
}
.nt { font-size: 23px; color: #fff; }

.res-hint { font-size: 20px; color: rgba(255,255,255,0.4); text-align: center; margin-top: 20px; }
.eq-item {
  background-color: #262626; border-radius: 12px;
  padding: 10px 12px; margin-bottom: 6px; width: 316px;
  flex-direction: column;
}
.eq-text { font-size: 22px; color: #fff; }
.eq-type { font-size: 18px; color: #4da3ff; margin-top: 4px; }
</style>
