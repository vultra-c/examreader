<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page home-page" @swipe="onSwipe">
    <!-- 顶部标题与计算器图形 -->
    <div class="home-header">
      <text class="home-title">计算器</text>
      <div class="calculator-mark">
        <div class="calculator-screen"></div>
        <div class="calculator-dots">
          <div class="calculator-dot"></div>
          <div class="calculator-dot"></div>
          <div class="calculator-dot"></div>
          <div class="calculator-dot"></div>
        </div>
      </div>
    </div>

    <!-- 设计图中的两项主导航：反应推导 / 方程查询 -->
    <div class="main-tabs">
      <div class="main-tab" @click="setMainMode('reaction')">
        <text class="{{mode === 'reaction' ? 'main-tab-on' : 'main-tab-off'}}">反应计算</text>
        <div if="{{mode === 'reaction'}}" class="main-tab-line"></div>
      </div>
      <div class="main-tab" @click="setMainMode('element')">
        <text class="{{mode === 'element' ? 'main-tab-on' : 'main-tab-off'}}">方程计算</text>
        <div if="{{mode === 'element'}}" class="main-tab-line"></div>
      </div>
    </div>
    <div class="tabs-divider"></div>

    <!-- 输入卡片：同一输入法可输入化学式、中文名称或元素符号 -->
    <div class="home-input-card" @click="toggleKb">
      <div if="{{!inputStr && mode === 'reaction'}}" class="input-copy">
        <text class="input-placeholder-large">输入两种反应物，用+隔开</text>
        <text class="input-placeholder-small">例如：铁+氧气 或 Fe+O₂</text>
      </div>
      <div if="{{!inputStr && mode === 'element'}}" class="input-copy">
        <text class="input-placeholder-large">输入元素，查询含有它们的方程式</text>
        <text class="input-placeholder-small">例如：Fe O 或 Na C O</text>
      </div>
      <text if="{{inputStr}}" class="home-input-value">{{inputStr}}</text>
      <text if="{{showKb}}" class="home-input-caret">|</text>
    </div>

    <!-- 主操作按钮 -->
    <div class="hero-action" @click="onAction">
      <text class="hero-flask">⚗</text>
      <text class="hero-action-text">{{mode === 'element' ? '查询方程' : '计算反应'}}</text>
    </div>

    <!-- 设计图下方四个快捷卡片 -->
    <div if="{{!showReference && !(mode === 'element' && elemSearched)}}" class="feature-grid">
      <div class="feature-card" @click="openMass(false)">
        <text class="feature-icon">⚖</text>
        <div class="feature-copy">
          <text class="feature-title">质量计算</text>
          <text class="feature-subtitle">已知质量，求未知</text>
        </div>
      </div>
      <div class="feature-card" @click="openMass(true)">
        <text class="feature-icon">↻</text>
        <div class="feature-copy">
          <text class="feature-title">反向计算</text>
          <text class="feature-subtitle">由生成物求反应物</text>
        </div>
      </div>
      <div class="feature-card" @click="openElementMode">
        <text class="feature-icon equation-icon">X=?</text>
        <div class="feature-copy">
          <text class="feature-title">方程计算</text>
          <text class="feature-subtitle">输入元素查方程</text>
        </div>
      </div>
      <div class="feature-card" @click="toggleReference">
        <text class="feature-icon">▱</text>
        <div class="feature-copy">
          <text class="feature-title">参考资料</text>
          <text class="feature-subtitle">化合价 · 元素表</text>
        </div>
      </div>
    </div>

    <!-- 元素方程查询结果，替换快捷卡片区域 -->
    <div if="{{mode === 'element' && elemSearched && !showReference}}" class="query-panel">
      <div class="panel-heading">
        <text class="panel-heading-text">匹配方程式</text>
        <text class="panel-heading-count">{{elementResults.length}} 条</text>
      </div>
      <text if="{{elementResults.length === 0}}" class="panel-empty">没有找到同时含有这些元素的方程式</text>
      <scroll if="{{elementResults.length > 0}}" scroll-y="true" class="query-scroll">
        <div class="query-item" for="{{elementResults}}" @click="openEquation($item)">
          <text class="query-text">{{$item.text}}</text>
          <text class="query-type">{{$item.type}}</text>
        </div>
      </scroll>
    </div>

    <!-- 参考资料：沿用已有本地物质目录，不新增网络资源 -->
    <div if="{{showReference}}" class="reference-panel">
      <div class="panel-heading">
        <text class="panel-heading-text">常用物质</text>
        <text class="panel-close" @click="toggleReference">×</text>
      </div>
      <scroll scroll-y="true" class="reference-scroll">
        <div class="reference-item" for="{{catalog}}" @click="pickName($item)">
          <text class="reference-name">{{$item}}</text>
        </div>
      </scroll>
    </div>

    <!-- 与原应用一致的同款输入法；输入页不再自绘键盘 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="60"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { splitInputTokens, resolveToken } from '../../common/logic/parser.js'
import { solveReaction } from '../../common/logic/reactions.js'
import { NAME_MAP, CATALOG, formulaName } from '../../common/logic/substances.js'
import { parseElementQuery, searchEquations, buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'

export default {
  private: {
    mode: 'reaction',
    inputStr: '',
    showKb: false,
    catalog: [],
    elemSearched: false,
    elementResults: [],
    showReference: false
  },

  onInit() {
    const seen = {}
    const list = []
    for (const group of CATALOG) {
      for (const formula of group.items) {
        if (seen[formula]) continue
        seen[formula] = true
        const name = formulaName(formula)
        list.push(name && name !== formula ? name + '  ' + formula : formula)
      }
    }
    this.catalog = list
  },

  setMainMode(nextMode) {
    this.mode = nextMode
    this.inputStr = ''
    this.showKb = false
    this.elemSearched = false
    this.elementResults = []
    this.showReference = false
  },

  toggleKb() {
    this.showReference = false
    this.showKb = !this.showKb
  },

  // 输入法返回原始字符；化学式保留用户主动选择的大写字母。
  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch) return

    if (this.mode === 'element') {
      if (ch === ' ' || ch === '+' || ch === '，' || ch === ',' || ch === '、') {
        if (this.inputStr && !this.inputStr.endsWith(' ')) this.inputStr += ' '
      } else if (/^[A-Za-z0-9]+$/.test(ch)) {
        // 不调用 toLowerCase：元素查询同样允许用户输入 Fe、O 等大小写形式。
        this.inputStr += ch
      }
      return
    }

    if (ch === ' ' || ch === '+' || ch === '＋') {
      if (this.inputStr && !this.inputStr.endsWith('+')) this.inputStr += '+'
      return
    }

    if (/^[A-Za-z]$/.test(ch)) {
      if (this.inputStr.length >= 140) return
      const tail = this.inputStr.split(/[+()\[\]]/).pop() || ''
      // 仅对输入法给出的“小写首字母”做便捷补大写；用户点出的主动大写原样保留。
      const needUpper = tail === '' || /[0-9]$/.test(tail)
      const value = needUpper && ch === ch.toLowerCase() ? ch.toUpperCase() : ch
      this.inputStr += value
      return
    }

    if (/^[0-9()\[\]]$/.test(ch) || /[^\x00-\x7F]/.test(ch)) {
      if (this.inputStr.length < 140) this.inputStr += ch
    }
  },

  onDel() {
    if (this.inputStr.length > 0) this.inputStr = this.inputStr.slice(0, -1)
  },

  pickName(displayName) {
    const raw = String(displayName || '')
    const splitAt = raw.indexOf('  ')
    const name = splitAt >= 0 ? raw.substring(0, splitAt) : raw
    if (!name) return
    if (!this.inputStr || this.inputStr.endsWith('+')) {
      this.inputStr += name
    } else {
      this.inputStr += '+' + name
    }
    this.showReference = false
    prompt.showToast({ message: '已加入 ' + name, duration: 900 })
  },

  onAction() {
    this.showReference = false
    if (this.mode === 'element') {
      this.doElementSearch()
    } else {
      this.calc()
    }
  },

  calc() {
    if (!this.inputStr) {
      prompt.showToast({ message: '请先输入反应物', duration: 1500 })
      return
    }
    const tokens = splitInputTokens(this.inputStr)
    if (!tokens.length) {
      prompt.showToast({ message: '无有效反应物', duration: 1500 })
      return
    }
    const formulas = []
    for (const token of tokens) {
      const resolved = resolveToken(token, NAME_MAP)
      if (!resolved.ok) {
        prompt.showToast({ message: resolved.error, duration: 2000 })
        return
      }
      formulas.push(resolved.formula)
    }
    const result = solveReaction(formulas)
    if (!result.ok) {
      prompt.showToast({ message: result.error, duration: 2500 })
      return
    }
    this.$app.$data.reaction = result.reaction
    router.push({ uri: 'pages/result' })
  },

  doElementSearch() {
    const query = parseElementQuery(this.inputStr)
    if (!query.ok) {
      prompt.showToast({ message: query.error, duration: 2000 })
      return
    }
    const hits = searchEquations(query.elems, 50)
    this.elementResults = hits.map((entry, index) => ({
      text: equationText(entry),
      type: entry.t,
      entry: entry,
      rid: 'e' + index
    }))
    this.elemSearched = true
    this.showKb = false
    if (hits.length === 0) {
      prompt.showToast({ message: '未找到含这些元素的方程式', duration: 2000 })
    }
  },

  openElementMode() {
    this.setMainMode('element')
    this.showKb = true
  },

  openEquation(item) {
    const reaction = buildReactionFromBank(item.entry)
    this.$app.$data.reaction = reaction
    router.push({ uri: 'pages/result' })
  },

  openMass(reverse) {
    const reaction = this.$app.$data.reaction
    if (!reaction) {
      prompt.showToast({ message: '请先计算一条反应方程式', duration: 1800 })
      return
    }
    if (reverse) this.$app.$data.massKnownIdx = reaction.reactants.length
    router.push({ uri: 'pages/mass' })
  },

  toggleReference() {
    this.showKb = false
    this.showReference = !this.showReference
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb) {
        this.showKb = false
      } else {
        router.back()
      }
    }
  }
}
</script>

