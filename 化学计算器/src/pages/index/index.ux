<!--
  化学工具箱 · 主页（336×480）
  风格对齐考点阅读器：顶部标题栏 + 功能列表，点击进入对应计算界面。
  右滑 / 返回键退出应用。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="exitApp"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">化学工具箱</text>
      <div class="hd-hold"></div>
    </div>

    <!-- 副标题 -->
    <text class="sub-tip">离线化学计算 · 反应 · 配平 · 计量</text>

    <!-- 功能列表 -->
    <div class="menu">
      <div class="menu-item" @click="goReaction">
        <div class="mi-badge mi-b-blue"><text class="mi-badge-t">反</text></div>
        <div class="mi-copy">
          <text class="mi-title">反应计算</text>
          <text class="mi-sub">输入反应物，自动推导并配平方程式</text>
        </div>
        <text class="mi-arrow">›</text>
      </div>

      <div class="menu-item" @click="goElement">
        <div class="mi-badge mi-b-green"><text class="mi-badge-t">元</text></div>
        <div class="mi-copy">
          <text class="mi-title">元素查询</text>
          <text class="mi-sub">按元素或物质名称查找方程式</text>
        </div>
        <text class="mi-arrow">›</text>
      </div>

      <div class="menu-item" @click="goMass">
        <div class="mi-badge mi-b-orange"><text class="mi-badge-t">质</text></div>
        <div class="mi-copy">
          <text class="mi-title">质量计算</text>
          <text class="mi-sub">已知一种物质质量，推算全部物质</text>
        </div>
        <text class="mi-arrow">›</text>
      </div>

      <div class="menu-item" @click="goCatalog">
        <div class="mi-badge mi-b-purple"><text class="mi-badge-t">表</text></div>
        <div class="mi-copy">
          <text class="mi-title">常用物质表</text>
          <text class="mi-sub">浏览常见物质，点选填入反应计算</text>
        </div>
        <text class="mi-arrow">›</text>
      </div>
    </div>

    <!-- 底部说明 -->
    <text class="foot-tip">支持化学式（Fe+O2）与中文名（铁+氧气）</text>
  </div>
</template>

<script>
import router from '@system.router'
import app from '@system.app'

export default {
  goReaction() {
    router.push({ uri: 'pages/reaction' })
  },
  goElement() {
    router.push({ uri: 'pages/element' })
  },
  goMass() {
    router.push({ uri: 'pages/mass' })
  },
  goCatalog() {
    router.push({ uri: 'pages/catalog' })
  },
  exitApp() {
    app.terminate()
  },
  onSwipe(e) {
    if (e && e.direction === 'right') {
      app.terminate()
    }
  },
  onBackPress() {
    app.terminate()
    return true
  }
}
</script>

