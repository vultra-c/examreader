<template>
  <div class="page" @swipe="onSwipe">
    <!-- 标题栏 -->
    <div class="topbar">
      <text class="topbar-title">化学计算器</text>
    </div>

    <!-- 输入显示 -->
    <div class="input-box">
      <text if="{{inputStr}}" class="input-text">{{inputStr}}</text>
      <text else class="input-hint">输入反应物，用+分隔</text>
    </div>

    <!-- 模式切换 -->
    <div class="tab-row">
      <div class="tab {{mode === 'formula' ? 'tab-on' : ''}}" @click="setFormula">
        <text class="{{mode === 'formula' ? 'ton' : 'toff'}}">化学式</text>
      </div>
      <div class="tab {{mode === 'name' ? 'tab-on' : ''}}" @click="setName">
        <text class="{{mode === 'name' ? 'ton' : 'toff'}}">名称</text>
      </div>
    </div>

    <!-- 化学式键盘 -->
    <div if="{{mode === 'formula'}}" class="kb-area">
      <div class="kr"><text class="kk" for="{{r1}}" @click="letter($item)">{{$item}}</text></div>
      <div class="kr"><text class="kk" for="{{r2}}" @click="letter($item)">{{$item}}</text></div>
      <div class="kr">
        <text class="kk fn {{shift ? 'w60' : ''}}" @click="toggleShift">{{shift ? '⇪' : '⇧'}}</text>
        <text class="kk" for="{{r3}}" @click="letter($item)">{{$item}}</text>
        <text class="kk fn" @click="del()">⌫</text>
      </div>
      <div class="kr">
        <text class="kk fn" @click="char('(')">(</text>
        <text class="kk fn" @click="char(')')">)</text>
        <text class="kk blue" @click="plus()">+</text>
        <text class="kk fn w64" @click="clear()">清空</text>
      </div>
      <div class="kr"><text class="kk" for="{{r5}}" @click="digit($item)">{{$item}}</text></div>
    </div>

    <!-- 名称目录 -->
    <div if="{{mode === 'name'}}" class="catalog-area">
      <scroll scroll-y="true" style="width:316px;height:188px;">
        <div class="ni" for="{{catalog}}" @click="pick($item)">
          <text class="nt">{{$item}}</text>
        </div>
      </scroll>
    </div>

    <!-- 计算按钮 -->
    <div class="calc-btn" @click="calc()">
      <text class="calc-btn-t">开始推导配平</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { splitInputTokens, resolveToken } from '../../common/logic/parser.js'
import { solveReaction } from '../../common/logic/reactions.js'
import { NAME_MAP, CATALOG, formulaName } from '../../common/logic/substances.js'

export default {
  private: {
    mode: 'formula',
    inputStr: '',
    shift: false,
    expectUpper: true,
    catalog: []
  },

  onInit() {
    this.r1 = ['Q','W','E','R','T','Y','U','I','O','P']
    this.r2 = ['A','S','D','F','G','H','J','K','L']
    this.r3 = ['Z','X','C','V','B','N','M']
    this.r5 = ['1','2','3','4','5','6','7','8','9','0']
    const seen = {}; const list = []
    for (const g of CATALOG) {
      for (const f of g.items) {
        if (seen[f]) continue; seen[f] = true
        const n = formulaName(f)
        list.push(n && n !== f ? n : f)
      }
    }
    this.catalog = list
  },

  setFormula() { this.mode = 'formula' },
  setName() { this.mode = 'name' },
  toggleShift() { this.shift = !this.shift },

  letter(ch) {
    let o = this.shift ? ch.toUpperCase() : (this.expectUpper ? ch.toUpperCase() : ch.toLowerCase())
    this.shift = false
    if (this.inputStr.length > 140) return
    const last = this.inputStr.split('+').pop() || ''
    if (this.inputStr.length > 0 && !/^[A-Za-z0-9()\[\]]+$/.test(last)) o = '+' + o
    this.inputStr += o
    this.expectUpper = false
  },

  del() {
    this.inputStr = this.inputStr.slice(0, -1)
    this.expectUpper = true
  },

  char(c) {
    if (this.inputStr.length > 140) return
    this.inputStr += c
    this.expectUpper = true
  },

  digit(d) {
    if (this.inputStr.length > 140) return
    this.inputStr += d
    this.expectUpper = true
  },

  plus() {
    if (!this.inputStr || this.inputStr.endsWith('+')) return
    this.inputStr += '+'
    this.expectUpper = true
  },

  clear() {
    this.inputStr = ''
    this.expectUpper = true
  },

  pick(name) {
    if (!this.inputStr || this.inputStr.endsWith('+')) {
      this.inputStr += name
    } else {
      this.inputStr += '+' + name
    }
    prompt.showToast({ message: '已加入', duration: 800 })
  },

  calc() {
    if (!this.inputStr) { prompt.showToast({ message: '请先输入反应物', duration: 1500 }); return }
    const tokens = splitInputTokens(this.inputStr)
    if (!tokens.length) { prompt.showToast({ message: '无有效反应物', duration: 1500 }); return }
    const formulas = []
    for (const t of tokens) {
      const r = resolveToken(t, NAME_MAP)
      if (!r.ok) { prompt.showToast({ message: r.error, duration: 2000 }); return }
      formulas.push(r.formula)
    }
    const res = solveReaction(formulas)
    if (!res.ok) { prompt.showToast({ message: res.error, duration: 2500 }); return }
    this.$app.$data.reaction = res.reaction
    router.push({ uri: 'pages/result' })
  },

  onSwipe(e) {
    if (e.direction === 'right') router.back()
  }
}
</script>

<style>
@import '../../common/style.css';

/* 输入显示（绝对定位：标题栏下方） */
.input-box {
  position: absolute;
  top: 88px;
  left: 10px;
  width: 316px;
  min-height: 60px;
  background-color: #1a1a1c;
  border-radius: 16px;
  padding: 10px 14px;
  justify-content: center;
}

.input-text { font-size: 30px; color: #fff; lines: 2; text-overflow: ellipsis; }
.input-hint { font-size: 22px; color: rgba(255,255,255,0.35); }

/* 模式切换 */
.tab-row {
  position: absolute;
  top: 156px;
  left: 10px;
  width: 316px;
  flex-direction: row;
  justify-content: space-between;
}
.tab { width: 153px; height: 44px; border-radius: 14px; background-color: #262626; justify-content: center; align-items: center; }
.tab-on { background-color: #0D6EFF; }
.ton { font-size: 24px; font-weight: bold; color: #fff; }
.toff { font-size: 24px; color: rgba(255,255,255,0.6); }

/* 化学式键盘 */
.kb-area {
  position: absolute;
  top: 208px;
  left: 10px;
  width: 316px;
}
.kr { flex-direction: row; justify-content: center; margin-bottom: 5px; width: 316px; }
.kk {
  width: 28px; height: 34px; border-radius: 8px;
  background-color: #2c2c2e; margin-left: 2px; margin-right: 2px;
  justify-content: center; align-items: center;
  font-size: 21px; color: #fff;
}
.fn { background-color: #3a3a3c; font-size: 20px; color: #0D9EFF; width: 40px; }
.w60 { width: 56px; }
.w64 { width: 64px; }
.blue { background-color: #0D6EFF; width: 56px; font-size: 24px; font-weight: bold; }

/* 名称目录 */
.catalog-area {
  position: absolute;
  top: 208px;
  left: 10px;
  width: 316px;
  height: 188px;
}
.ni {
  background-color: #262626; border-radius: 12px;
  padding: 9px 14px; margin-bottom: 6px; width: 316px;
}
.nt { font-size: 23px; color: #fff; }

/* 计算按钮 */
.calc-btn {
  position: absolute;
  top: 410px;
  left: 10px;
  width: 316px;
  height: 54px;
  background-color: #0D6EFF;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
}
.calc-btn-t { font-size: 26px; font-weight: bold; color: #fff; }
</style>
