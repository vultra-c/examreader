<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 主页（336×480 竖屏）

  设计原则（针对手环端点击失灵/卡顿问题的根治）：
  1. 全页唯一布局体系：根节点固定 336×480，内部全部纵向流式排列，
     不存在任何「透明遮罩/绝对定位层」压在按钮上 —— 点击区域即所见区域。
  2. 所有可点元素都有显式宽高和背景色（部分机型上无背景的 hit-area 不稳定）。
  3. 键盘由共享 InputMethod 组件承载，hide prop 直接驱动显隐；
     打开时覆盖下半屏属预期行为，任何主动作执行前都会先收起键盘。
  4. 节点数控制：常用物质目录懒构建（首次打开面板才生成 120 行数据）。
-->

<template>
  <div class="screen" @swipe="onSwipe">

    <!-- 顶栏：标题 + 常用物质入口 -->
    <div class="hd">
      <text class="hd-title">化学工具箱</text>
      <div class="hd-btn" @click="toggleReference">
        <text class="{{referenceOpen ? 'hd-btn-t-on' : 'hd-btn-t'}}">{{referenceOpen ? '关闭' : '物质表'}}</text>
      </div>
    </div>

    <!-- 模式切换：反应计算 / 元素查询 -->
    <div class="seg">
      <div class="{{mode == 'reaction' ? 'seg-cell-on' : 'seg-cell'}}" @click="setMode('reaction')">
        <text class="{{mode == 'reaction' ? 'seg-t-on' : 'seg-t'}}">反应计算</text>
      </div>
      <div class="{{mode == 'element' ? 'seg-cell-on' : 'seg-cell'}}" @click="setMode('element')">
        <text class="{{mode == 'element' ? 'seg-t-on' : 'seg-t'}}">元素查询</text>
      </div>
    </div>

    <!-- 输入卡片：点击弹出/收起键盘 -->
    <div class="input-card" @click="toggleKb">
      <div if="{{inputStr.length == 0}}" class="input-empty">
        <text class="input-ph-main">{{mode == 'reaction' ? '输入反应物，用 + 连接' : '输入元素，如 Fe O'}}</text>
        <text class="input-ph-sub">{{mode == 'reaction' ? '例：铁+氧气 或 Fe+O₂' : '含全部输入元素的方程式'}}</text>
      </div>
      <text if="{{inputStr.length > 0}}" class="input-value">{{inputStr}}</text>
      <text if="{{showKb}}" class="input-caret">_</text>
    </div>

    <!-- 主操作 -->
    <div class="act" @click="onAction">
      <text class="act-t">{{mode == 'reaction' ? '计算反应' : '查询方程'}}</text>
    </div>

    <!-- 功能区 A：元素查询结果（替换下方网格） -->
    <div if="{{elemSearched && !referenceOpen}}" class="panel">
      <div class="panel-hd">
        <text class="panel-hd-t">匹配方程式</text>
        <text class="panel-hd-n">{{elementResults.length}} 条</text>
      </div>
      <text if="{{elementResults.length == 0}}" class="panel-none">没有同时含这些元素的方程式</text>
      <scroll if="{{elementResults.length > 0}}" scroll-y="true" class="panel-list">
        <div class="eq-item" for="{{elementResults}}" tid="rid" @click="openEquation($item)">
          <text class="eq-item-text">{{$item.text}}</text>
          <text class="eq-item-type">{{$item.type}}</text>
        </div>
      </scroll>
    </div>

    <!-- 功能区 B：常用物质目录 -->
    <div if="{{referenceOpen}}" class="panel">
      <div class="panel-hd">
        <text class="panel-hd-t">常用物质（点选加入）</text>
        <text class="panel-close" @click="toggleReference">×</text>
      </div>
      <scroll scroll-y="true" class="panel-list">
        <div class="ref-item" for="{{catalogRows}}" tid="rid" @click="pickName($item)">
          <text class="ref-item-t">{{$item.label}}</text>
        </div>
      </scroll>
    </div>

    <!-- 功能区 C：四宫格快捷入口（默认态） -->
    <div if="{{!elemSearched && !referenceOpen}}" class="grid">
      <div class="g-card" @click="openMass(false)">
        <div class="g-icon"><text class="g-icon-t">质</text></div>
        <div class="g-copy">
          <text class="g-title">质量计算</text>
          <text class="g-sub">已知质量求各物</text>
        </div>
      </div>
      <div class="g-card" @click="openMass(true)">
        <div class="g-icon g-icon-alt"><text class="g-icon-t-alt">逆</text></div>
        <div class="g-copy">
          <text class="g-title">反向计算</text>
          <text class="g-sub">由生成物反推</text>
        </div>
      </div>
      <div class="g-card" @click="gotoElementMode">
        <div class="g-icon"><text class="g-icon-t">元</text></div>
        <div class="g-copy">
          <text class="g-title">元素查询</text>
          <text class="g-sub">按元素找方程</text>
        </div>
      </div>
      <div class="g-card" @click="clearAll">
        <div class="g-icon g-icon-warn"><text class="g-icon-t-warn">清</text></div>
        <div class="g-copy">
          <text class="g-title">清空重置</text>
          <text class="g-sub">重新开始输入</text>
        </div>
      </div>
    </div>

    <!-- 共享输入法：与考点阅读器同款，hide 直接驱动 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="60"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { splitInputTokens, resolveToken } from '../../common/logic/parser.js'
import { solveReaction } from '../../common/logic/reactions.js'
import { NAME_MAP, CATALOG, formulaName } from '../../common/logic/substances.js'
import { parseElementQuery, searchEquations, buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'

export default {
  private: {
    mode: 'reaction',        // reaction=反应推导 element=元素查方程
    inputStr: '',
    showKb: false,
    elemSearched: false,
    elementResults: [],
    referenceOpen: false,
    catalogRows: []
  },

  setMode(next) {
    if (this.mode === next) return
    this.mode = next
    this.inputStr = ''
    this.showKb = false
    this.elemSearched = false
    this.elementResults = []
  },

  toggleKb() {
    this.referenceOpen = false
    this.showKb = !this.showKb
  },

  /** 输入法回传单字符；按模式过滤，非法字符静默丢弃 */
  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch || this.inputStr.length >= 120) return

    if (this.mode === 'element') {
      // 元素查询：仅接受字母/数字，分隔符统一折叠为单个空格
      if (/^[A-Za-z0-9]+$/.test(ch)) {
        this.inputStr += ch
      } else if (this.inputStr && this.inputStr.slice(-1) !== ' ') {
        this.inputStr += ' '
      }
      return
    }

    // 反应计算：加号去重；字母自动处理大小写（新段首/数字后补大写，
    // 其余小写 —— 与化学式书写规则一致，用户通过大写键主动输入的大写原样保留）
    if (ch === ' ' || ch === '+') {
      if (this.inputStr && this.inputStr.slice(-1) !== '+') this.inputStr += '+'
      return
    }
    if (/^[A-Za-z]$/.test(ch)) {
      const seg = this.inputStr.split(/[+()[\]]/).pop() || ''
      const needUpper = seg === '' || /[0-9]$/.test(seg)
      const lower = ch.toLowerCase()
      const upper = ch.toUpperCase()
      this.inputStr += (needUpper && ch === lower) ? upper : ch
      return
    }
    if (/^[0-9()[\]]$/.test(ch)) {
      this.inputStr += ch
    }
  },

  onDel() {
    if (this.inputStr.length > 0) this.inputStr = this.inputStr.slice(0, -1)
  },

  onAction() {
    this.showKb = false
    if (this.mode === 'element') this.doElementSearch()
    else this.calcReaction()
  },

  calcReaction() {
    const raw = this.inputStr.trim()
    if (!raw) { prompt.showToast({ message: '请先输入反应物', duration: 1500 }); return }
    const tokens = splitInputTokens(raw)
    if (!tokens.length) { prompt.showToast({ message: '无有效反应物', duration: 1500 }); return }

    const formulas = []
    for (let i = 0; i < tokens.length; i++) {
      const resolved = resolveToken(tokens[i], NAME_MAP)
      if (!resolved.ok) { prompt.showToast({ message: resolved.error, duration: 2200 }); return }
      formulas.push(resolved.formula)
    }
    const result = solveReaction(formulas)
    if (!result.ok) { prompt.showToast({ message: result.error, duration: 2600 }); return }

    this.$app.$data.reaction = result.reaction
    router.push({ uri: 'pages/result' })
  },

  doElementSearch() {
    const query = parseElementQuery(this.inputStr)
    if (!query.ok) { prompt.showToast({ message: query.error, duration: 2000 }); return }

    let hits = []
    try {
      hits = searchEquations(query.elems, 50)
    } catch (err) {
      hits = []
    }
    const rows = []
    for (let i = 0; i < hits.length; i++) {
      rows.push({ text: equationText(hits[i]), type: hits[i].t, entry: hits[i], rid: 'e' + i })
    }
    this.elementResults = rows
    this.elemSearched = true
    this.showKb = false
    if (rows.length === 0) prompt.showToast({ message: '未找到匹配方程式', duration: 1800 })
  },

  gotoElementMode() {
    this.setMode('element')
    this.referenceOpen = false
    this.elemSearched = false
    this.elementResults = []
    this.showKb = true
  },

  openEquation(item) {
    this.$app.$data.reaction = buildReactionFromBank(item.entry)
    router.push({ uri: 'pages/result' })
  },

  openMass(reverse) {
    const reaction = this.$app.$data.reaction
    if (!reaction) {
      prompt.showToast({ message: '请先计算一条方程式', duration: 1600 })
      return
    }
    this.$app.$data.massKnownIdx = reverse ? reaction.reactants.length : 0
    router.push({ uri: 'pages/mass' })
  },

  /** 首次打开物质表才构建 120 行目录数据（懒加载，降低首帧负担） */
  toggleReference() {
    this.showKb = false
    this.referenceOpen = !this.referenceOpen
    if (this.referenceOpen && this.catalogRows.length === 0) {
      const seen = {}
      const rows = []
      let n = 0
      for (let g = 0; g < CATALOG.length; g++) {
        const items = CATALOG[g].items
        for (let i = 0; i < items.length; i++) {
          const f = items[i]
          if (seen[f]) continue
          seen[f] = true
          const name = formulaName(f)
          rows.push({ label: name && name !== f ? name + ' ' + f : f, rid: 'c' + (n++) })
        }
      }
      this.catalogRows = rows
    }
  },

  pickName(item) {
    const label = String(item.label || '')
    const cut = label.indexOf(' ')
    const name = cut > 0 ? label.substring(0, cut) : label
    if (!name) return
    if (!this.inputStr || this.inputStr.slice(-1) === '+') this.inputStr += name
    else if (this.inputStr.length + name.length < 120) this.inputStr += '+' + name
    prompt.showToast({ message: '已加入 ' + name, duration: 800 })
  },

  /** 一键清空：输入、结果、面板、键盘全部复位 */
  clearAll() {
    this.inputStr = ''
    this.showKb = false
    this.elemSearched = false
    this.elementResults = []
    this.referenceOpen = false
    prompt.showToast({ message: '已清空', duration: 800 })
  },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb || this.referenceOpen) {
        this.showKb = false
        this.referenceOpen = false
      } else {
        router.back()
      }
    }
  },

  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

/* ---- 顶栏 ---- */
