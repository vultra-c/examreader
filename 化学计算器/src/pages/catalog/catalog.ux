<!--
  化学工具箱 · 常用物质表（336×480，闪念小抄风格）
  渲染方案：完全对齐考点阅读器（真机已验证）的 list 模式 + 小抄深色卡片：
  - list 使用 absolute 定位、显式宽高，挂为页面顶层子节点（不参与 flex 流测量）
  - list-item 声明静态 class + 显式高度/间距，内容统一用内层 div 包裹
  - 同 type 的 list-item DOM 结构完全一致，禁止内部 if 混用
  - for 变量 $item，tid 唯一
-->
<template>
  <div class="page" @swipe="onSwipe">
    <!-- 列表（absolute 顶层挂载，分块加载） -->
    <list class="cat-list" if="{{visibleRows.length > 0}}" onscrollbottom="onReachBottom">
      <list-item for="{{visibleRows}}" tid="rid" type="row" class="cat-item" @click="onRowClick($item)">
        <div class="cat-content">
          <text class="cat-main">{{$item.main}}</text>
          <text class="cat-sub">{{$item.sub}}</text>
        </div>
      </list-item>
      <list-item if="{{hasMore}}" type="more" class="cat-item" @click="onReachBottom">
        <div class="cat-content cat-content-center">
          <text class="cat-more">▼ 还有 {{total - visibleRows.length}} 条，上滑加载更多</text>
        </div>
      </list-item>
    </list>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">点选自动填入</text>
    <text static class="hd-title">常用物质表</text>
  </div>
</template>

<script>
import router from '@system.router'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

// 在模块加载时一次性构建全部行数据（同步，无异步）
const ALL_ROWS = []
;(function buildAllRows() {
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    ALL_ROWS.push({ kind: 'title', rid: 't' + g, main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      ALL_ROWS.push({
        kind: 'item',
        rid: 'c' + (n++),
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
})()

// 分块渲染：首屏 24 行，滚动到底追加 24 行（Vela 文档：长列表应分页避免首屏卡顿）
const CHUNK = 24

export default {
  private: {
    total: ALL_ROWS.length,
    visibleRows: ALL_ROWS.slice(0, CHUNK),
    renderPos: CHUNK,
    hasMore: ALL_ROWS.length > CHUNK
  },

  onReachBottom() {
    if (!this.hasMore) return
    const end = Math.min(this.renderPos + CHUNK, this.total)
    this.visibleRows = this.visibleRows.concat(ALL_ROWS.slice(this.renderPos, end))
    this.renderPos = end
    this.hasMore = this.renderPos < this.total
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) { /* ignore */ }
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* 列表：absolute 顶层挂载，显式宽高（顶栏 102px 之下） */
.cat-list {
  position: absolute;
  left: 0px;
  top: 102px;
  width: 336px;
  height: 378px;
  padding: 0px 6px;
}

/* list-item：小抄深色卡片风；静态 class + 显式行高/间距，内容内层 div 包裹 */
.cat-item {
  width: 100%;
  height: 72px;
  padding: 0 22px;
  margin-bottom: 8px;
  border-radius: 30px;
  background-color: #262626;
}
.cat-content {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.cat-content-center {
  justify-content: center;
}
.cat-main {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.cat-sub {
  font-size: 24px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
  lines: 1;
}
.cat-more {
  font-size: 20px;
  color: rgba(255, 255, 255, 0.35);
}
</style>
