<!--
  化学工具箱 · 常用物质表（336×480）
  按类别浏览常见物质；点选后写入 $app.$data.pendingFormula 并返回，
  反应计算页会在 onShow 时自动拼入输入框。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>

    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <scroll scroll-y="true" class="list">
      <div class="group" for="{{groups}}" tid="gid">
        <text class="group-title">{{$item.group}}</text>
        <div class="item" for="{{$item.items}}" tid="iid" @click="pick($item)">
          <text class="item-name">{{$item.label}}</text>
          <text class="item-formula">{{$item.formula}}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

export default {
  private: {
    groups: []
  },

  onInit() {
    const groups = []
    for (let g = 0; g < CATALOG.length; g++) {
      const cat = CATALOG[g]
      const items = []
      for (let i = 0; i < cat.items.length; i++) {
        const f = cat.items[i]
        const name = formulaName(f)
        items.push({
          formula: f,
          label: name && name !== f ? name : f,
          rid: 'c' + g + '_' + i
        })
      }
      groups.push({ group: cat.group, items, gid: 'g' + g })
    }
    this.groups = groups
  },

  pick(item) {
    this.$app.$data.pendingFormula = item.formula
    prompt.showToast({ message: '已选 ' + item.formula, duration: 800 })
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px 16px 0 12px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

.list {
  width: 304px;
  flex: 1;
  margin: 8px 16px 0;
}

.group {
  width: 304px;
  flex-direction: column;
  margin-bottom: 8px;
}
.group-title {
  font-size: 18px;
  font-weight: bold;
  color: #4da3ff;
  margin: 2px 4px 6px;
}
.item {
  width: 304px;
  height: 48px;
  border-radius: 13px;
  background-color: #1c1c1e;
  margin-bottom: 6px;
  padding: 0 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.item-name {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.item-formula {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}
</style>
