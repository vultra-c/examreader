<!--
  化学工具箱 · 常用物质表（336×480）
  渲染方案：完全对齐考点阅读器（真机已验证）的 list 模式：
  - list 使用 absolute 定位、显式宽高，挂为页面顶层子节点（不参与 flex 流测量）
  - list-item 声明静态 class + 显式高度/间距，内容统一用内层 div 包裹
  - 同 type 的 list-item DOM 结构完全一致，禁止内部 if 混用
  - for 变量 $item，tid 唯一
-->
<template>
  <div class="screen" @swipe="onSwipe">
    <!-- 顶栏（流式） -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>
    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <!-- 列表（absolute 顶层挂载，分块加载） -->
    <list class="cat-list" if="{{visibleRows.length > 0}}" onscrollbottom="onReachBottom">
      <list-item for="{{visibleRows}}" tid="rid" type="row" class="cat-item" @click="onRowClick($item)">
        <div class="cat-content">
          <text class="cat-main">{{$item.main}}</text>
          <text class="cat-sub">{{$item.sub}}</text>
        </div>
      </list-item>
      <list-item if="{{hasMore}}" type="more" class="cat-item" @click="onReachBottom">
        <div class="cat-content cat-content-center">
          <text class="cat-more">▼ 还有 {{total - visibleRows.length}} 条，上滑加载更多</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

// 在模块加载时一次性构建全部行数据（同步，无异步）
const ALL_ROWS = []
;(function buildAllRows() {
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    ALL_ROWS.push({ kind: 'title', rid: 't' + g, main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      ALL_ROWS.push({
        kind: 'item',
        rid: 'c' + (n++),
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
})()

// 分块渲染：首屏 24 行，滚动到底追加 24 行（Vela 文档：长列表应分页避免首屏卡顿）
const CHUNK = 24

export default {
  private: {
    total: ALL_ROWS.length,
    visibleRows: ALL_ROWS.slice(0, CHUNK),
    renderPos: CHUNK,
    hasMore: ALL_ROWS.length > CHUNK
  },

  onReachBottom() {
    if (!this.hasMore) return
    const end = Math.min(this.renderPos + CHUNK, this.total)
    this.visibleRows = this.visibleRows.concat(ALL_ROWS.slice(this.renderPos, end))
    this.renderPos = end
    this.hasMore = this.renderPos < this.total
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) { /* ignore */ }
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 16px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

/* 列表：absolute 顶层挂载，显式宽高（与考点阅读器一致的真机可用模式） */
.cat-list {
  position: absolute;
  left: 0px;
  top: 80px;
  width: 336px;
  height: 400px;
  padding: 0px 16px;
}

/* list-item：静态 class + 显式高度/间距，内容由内层 div 包裹 */
.cat-item {
  width: 100%;
  height: 52px;
  padding: 0 14px;
  margin-bottom: 7px;
  border-radius: 13px;
  background-color: #1c1c1e;
}
.cat-content {
  width: 100%;
  height: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.cat-content-center {
  justify-content: center;
}
.cat-main {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.cat-sub {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
  lines: 1;
}
.cat-more {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.35);
}
</style>
