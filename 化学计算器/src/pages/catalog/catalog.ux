<!--
  化学工具箱 · 常用物质表（336×480）
  渲染方案：scroll + div for，内容容器显式声明 flex-direction: column。
  依据小米 Vela 开发文档：flex-direction 默认值为 row，此前版本未显式声明列方向，
  导致全部行横向排布、屏幕上只露出第一行；而 list-item 组件要求同 type 的
  DOM 结构完全一致，标题行/物质行混用 if 会触发渲染错误。
  本页改用普通 div 渲染，无上述限制，且已在设备上验证可渲染。
-->
<template>
  <div class="screen" @swipe="onSwipe">
    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>
    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <!-- 列表：scroll + div for，显式列方向；分块加载（依据开发文档：超过10项应分页/懒加载） -->
    <scroll class="scroll-area" scroll-y="true" onscrollbottom="onReachBottom">
      <div class="list-content">
        <div for="{{visibleRows}}" tid="rid" class="row-wrap" @click="onRowClick($item)">
          <div if="{{$item.kind === 'title'}}" class="title-row">
            <text class="title-text">{{$item.main}}</text>
          </div>
          <div if="{{$item.kind === 'item'}}" class="item-row">
            <text class="item-main">{{$item.main}}</text>
            <text class="item-sub">{{$item.sub}}</text>
          </div>
        </div>
        <div if="{{hasMore}}" class="more-hint">
          <text class="more-hint-t">▼ 还有 {{total - visibleRows.length}} 条，上滑加载更多</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

// 在模块加载时一次性构建全部行数据（同步，无异步）
const ALL_ROWS = []
;(function buildAllRows() {
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    ALL_ROWS.push({ kind: 'title', rid: 't' + g, main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      ALL_ROWS.push({
        kind: 'item',
        rid: 'c' + (n++),
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
})()

// 分块渲染：首屏 24 行，滚动到底追加 24 行（Vela 文档：长列表应分页避免首屏卡顿）
const CHUNK = 24

function appendChunk(visible, pos) {
  const end = Math.min(pos + CHUNK, ALL_ROWS.length)
  const added = ALL_ROWS.slice(pos, end)
  return { rows: visible.concat(added), pos: end }
}

export default {
  private: {
    total: ALL_ROWS.length,
    visibleRows: ALL_ROWS.slice(0, CHUNK),
    renderPos: CHUNK,
    hasMore: ALL_ROWS.length > CHUNK
  },

  onReachBottom() {
    if (!this.hasMore) return
    const r = appendChunk(this.visibleRows, this.renderPos)
    this.visibleRows = r.rows
    this.renderPos = r.pos
    this.hasMore = this.renderPos < this.total
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) { /* ignore */ }
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 16px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

.scroll-area {
  width: 336px;
  height: 408px;
  margin-top: 6px;
}

/* 关键：内容容器显式列方向（Vela 默认 row） */
.list-content {
  flex-direction: column;
}

.more-hint {
  width: 336px;
  height: 40px;
  justify-content: center;
  align-items: center;
}
.more-hint-t {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.35);
}

.row-wrap {
  width: 336px;
  flex-direction: column;
}

.title-row {
  width: 304px;
  height: 36px;
  margin: 6px 16px 0 16px;
  justify-content: center;
}
.title-text {
  font-size: 18px;
  font-weight: bold;
  color: #4da3ff;
}

.item-row {
  width: 304px;
  height: 48px;
  margin: 0 16px 6px 16px;
  border-radius: 13px;
  background-color: #1c1c1e;
  padding-left: 14px;
  padding-right: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.item-main {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.item-sub {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}
</style>
