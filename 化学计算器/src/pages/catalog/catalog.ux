<!--
  化学工具箱 · 常用物质表（336×480）
  使用 list + list-item 组件，与 element.ux / index.ux 保持一致的可靠渲染模式。
  数据在模块加载时一次性同步构建，页面渲染时直接使用，无异步/定时器依赖。
-->
<template>
  <div class="screen" @swipe="onSwipe">
    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>
    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>
    <!-- 列表：与 element.ux / index.ux 同款 list 组件 -->
    <list class="scroll-area" if="{{allRows.length > 0}}">
      <list-item for="{{allRows}}" tid="rid" type="{{item.type}}" class="row-wrap" @click="onRowClick($item)">
        <div if="{{item.kind === 'title'}}" class="title-row">
          <text class="title-text">{{item.main}}</text>
        </div>
        <div if="{{item.kind === 'item'}}" class="item-row">
          <text class="item-main">{{item.main}}</text>
          <text class="item-sub">{{item.sub}}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

// 在模块加载时一次性构建全部行数据（同步，无异步）
const ALL_ROWS = []
;(function buildAllRows() {
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    ALL_ROWS.push({ kind: 'title', rid: 't' + g, type: 'title', main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      ALL_ROWS.push({
        kind: 'item',
        rid: 'c' + (n++),
        type: 'item',
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
})()

export default {
  private: {
    allRows: ALL_ROWS
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) { /* ignore */ }
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 16px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

.scroll-area {
  width: 336px;
  height: 400px;
  margin-top: 8px;
}

.row-wrap {
  width: 336px;
  flex-direction: column;
}

.title-row {
  width: 304px;
  height: 36px;
  margin: 6px 16px 0 16px;
  justify-content: center;
}
.title-text {
  font-size: 18px;
  font-weight: bold;
  color: #4da3ff;
}

.item-row {
  width: 304px;
  height: 48px;
  margin: 0 16px 6px 16px;
  border-radius: 13px;
  background-color: #1c1c1e;
  padding-left: 14px;
  padding-right: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.item-main {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.item-sub {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}
</style>
