<!--
  化学工具箱 · 常用物质表（336×480）
  渲染方案：list + list-item，样式（高度/内边距/间距）直接声明在 list-item 元素上，
  与考点阅读器（已验证可用）完全一致：
  - list-item 必须有显式高度，否则行会塌陷成细线
  - 同 type 的 list-item DOM 结构必须完全一致，禁止内部 if 混用
  - for 循环变量为 $item
  标题行与物质行共用同一结构（两个 text），仅内容不同，通过 kind 字段区分点击行为。
-->
<template>
  <div class="screen" @swipe="onSwipe">
    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>
    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <!-- 列表：list + list-item，样式在 list-item 上；分块加载 -->
    <list class="catalog-list" if="{{visibleRows.length > 0}}" onscrollbottom="onReachBottom">
      <list-item for="{{visibleRows}}" tid="rid" type="row" class="row-row" @click="onRowClick($item)">
        <text class="row-main">{{$item.main}}</text>
        <text class="row-sub">{{$item.sub}}</text>
      </list-item>
      <list-item if="{{hasMore}}" type="more" class="more-row" @click="onReachBottom">
        <text class="more-text">▼ 还有 {{total - visibleRows.length}} 条，上滑加载更多</text>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

// 在模块加载时一次性构建全部行数据（同步，无异步）
const ALL_ROWS = []
;(function buildAllRows() {
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    ALL_ROWS.push({ kind: 'title', rid: 't' + g, main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      ALL_ROWS.push({
        kind: 'item',
        rid: 'c' + (n++),
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
})()

// 分块渲染：首屏 24 行，滚动到底追加 24 行（Vela 文档：长列表应分页避免首屏卡顿）
const CHUNK = 24

export default {
  private: {
    total: ALL_ROWS.length,
    visibleRows: ALL_ROWS.slice(0, CHUNK),
    renderPos: CHUNK,
    hasMore: ALL_ROWS.length > CHUNK
  },

  onReachBottom() {
    if (!this.hasMore) return
    const end = Math.min(this.renderPos + CHUNK, this.total)
    this.visibleRows = this.visibleRows.concat(ALL_ROWS.slice(this.renderPos, end))
    this.renderPos = end
    this.hasMore = this.renderPos < this.total
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) { /* ignore */ }
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 16px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

/* 列表：显式高度 */
.catalog-list {
  width: 336px;
  height: 392px;
  margin-top: 6px;
}

/* list-item 本身带高度/内边距/间距（关键：样式在 list-item 上，行才不会塌陷） */
.row-row {
  width: 100%;
  height: 52px;
  padding: 0 14px;
  margin-bottom: 7px;
  border-radius: 13px;
  background-color: #1c1c1e;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.row-main {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.row-sub {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
  lines: 1;
}

.more-row {
  width: 100%;
  height: 44px;
  justify-content: center;
  align-items: center;
}
.more-text {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.35);
}
</style>
