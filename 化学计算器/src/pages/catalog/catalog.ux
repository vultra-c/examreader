<!--
  化学工具箱 · 常用物质表（336×480）
  按类别浏览常见物质；点选后写入 $app.$def.pendingFormula 并返回，
  反应计算页会在 onShow 时自动拼入输入框。
  列表组件与考点阅读器同款 list/list-item（scroll 纵向列表在本机不可靠）。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>

    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <list class="list">
      <list-item type="{{$item.kind}}" for="{{rows}}" tid="rid" @click="onRowClick($item)">
        <div class="{{$item.kind === 'title' ? 'row-title' : 'row-item'}}">
          <text if="{{$item.kind === 'title'}}" class="row-title-t">{{$item.text}}</text>
          <text if="{{$item.kind === 'item'}}" class="row-item-name">{{$item.label}}</text>
          <text if="{{$item.kind === 'item'}}" class="row-item-f">{{$item.formula}}</text>
        </div>
      </list-item>
    </list>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

export default {
  private: {
    rows: []
  },

  onInit() {
    const rows = []
    let rid = 0
    for (let g = 0; g < CATALOG.length; g++) {
      const cat = CATALOG[g]
      rows.push({ kind: 'title', text: cat.group, rid: 't' + g })
      for (let i = 0; i < cat.items.length; i++) {
        const f = cat.items[i]
        const name = formulaName(f)
        rows.push({
          kind: 'item',
          formula: f,
          label: name && name !== f ? name : f,
          rid: 'c' + (rid++)
        })
      }
    }
    this.rows = rows
  },

  onRowClick(item) {
    if (!item || item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) {
      prompt.showToast({ message: '选择失败', duration: 1200 })
      return
    }
    prompt.showToast({ message: '已选 ' + item.formula, duration: 800 })
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px 16px 0 12px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

.list {
  width: 304px;
  height: 410px;
  margin: 8px 16px 0;
}

.row-title {
  width: 304px;
  height: 34px;
  flex-direction: row;
  align-items: center;
}
.row-title-t {
  font-size: 18px;
  font-weight: bold;
  color: #4da3ff;
  margin-left: 4px;
}
.row-item {
  width: 304px;
  height: 48px;
  border-radius: 13px;
  background-color: #1c1c1e;
  margin-bottom: 6px;
  padding: 0 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.row-item-name {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.row-item-f {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}
</style>
