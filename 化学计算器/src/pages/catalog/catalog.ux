<!--
  化学工具箱 · 常用物质表（336×480）
  可靠性原则（本机实测教训）：
  1. 本机 setTimeout 定时器链不可靠（键盘显隐曾因此失效），数据装载绝不依赖定时器。
     改用 onReady（页面模板就绪后的官方钩子）同步装载；onShow 再兜底一次；
     若两者都未生效，空态文案「点此重试」可手动触发——三重保险。
  2. 结构同构：与设备上已验证可用的元素查询列表完全同构——
     screen 纵向 flex 流、list 固定宽高、list-item 静态 type、单一 div 子节点、
     模板表达式零运算符（== 而非 ===）。
  3. 分块渲染：首屏 CHUNK 行，「加载更多」行 / onscrollbottom 追加；
     整表数据模块级缓存，会话内二次进入瞬时呈现。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">常用物质表</text>
      <div class="hd-hold"></div>
    </div>

    <text class="sub-tip">点选物质，自动填入「反应计算」输入框</text>

    <!-- 列表：与元素查询页同款 list/list-item -->
    <list show="{{rows.length > 0}}" class="list" onscrollbottom="onReachBottom">
      <list-item type="catrow" for="{{rows}}" tid="rid" @click="onRowClick($item)">
        <div class="row">
          <text class="row-main">{{$item.main}}</text>
          <text class="row-sub">{{$item.sub}}</text>
        </div>
      </list-item>
    </list>

    <!-- 空态兜底：装载未生效时可手动重试（不依赖任何定时器/事件时序） -->
    <text if="{{rows.length == 0}}" class="retry-tap" @click="loadData">物质表加载中…点此重试</text>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { CATALOG, formulaName } from '../../common/logic/substances.js'

const CHUNK = 26

// 模块级缓存：整表只在首次进入时构建一次
let allRows = []
let built = false

function buildAllRows() {
  if (built) return
  const arr = []
  let n = 0
  for (let g = 0; g < CATALOG.length; g++) {
    const cat = CATALOG[g]
    arr.push({ kind: 'title', rid: 't' + g, main: '【' + cat.group + '】', sub: '' })
    for (let i = 0; i < cat.items.length; i++) {
      const f = cat.items[i]
      const nm = formulaName(f)
      arr.push({
        kind: 'item',
        rid: 'c' + (n++),
        formula: f,
        main: (nm && nm !== f) ? nm : f,
        sub: f
      })
    }
  }
  allRows = arr
  built = true
}

export default {
  private: {
    rows: [],
    pos: 0
  },

  // 首选装载点：onInit 在首次渲染前同步执行，首帧即有数据，彻底消除时序问题。
  onInit() {
    this.loadData()
  },

  // 兑底一：页面模板渲染完成后触发
  onReady() {
    this.loadData()
  },

  // 数据装载：幂等，可被 onInit/onReady/onShow/重试行安全地多次调用
  loadData() {
    if (this.rows.length > 0) return
    try {
      buildAllRows()
      this.pos = 0
      this.appendChunk()
    } catch (err) {
      prompt.showToast({ message: '加载失败', duration: 1500 })
    }
  },
  appendChunk() {
    if (!allRows.length) buildAllRows()
    if (this.pos >= allRows.length) return
    const base = this.rows.filter(function (r) { return r.kind !== 'more' })
    const next = allRows.slice(this.pos, this.pos + CHUNK)
    this.pos += next.length
    const rows = base.concat(next)
    if (this.pos < allRows.length) {
      rows.push({ kind: 'more', rid: 'more', main: '▼ 点此加载更多', sub: '' })
    }
    this.rows = rows
  },

  onReachBottom() {
    this.appendChunk()
  },

  onRowClick(item) {
    if (!item) return
    if (item.kind === 'more') {
      this.appendChunk()
      return
    }
    if (item.kind !== 'item') return
    try {
      this.$app.$def.pendingFormula = item.formula
    } catch (err) {
      prompt.showToast({ message: '选择失败', duration: 1200 })
      return
    }
    prompt.showToast({ message: '已选 ' + item.formula, duration: 800 })
    router.back()
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') router.back()
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* 纵向 flex 流：与元素查询页同构 */
.screen {
  width: 336px;
  height: 480px;
  background-color: #000000;
  flex-direction: column;
}

.hd {
  width: 336px;
  height: 52px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 16px;
}
.hd-back {
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
.hd-back-t {
  font-size: 34px;
  line-height: 38px;
  margin-top: -4px;
  color: #ffffff;
  font-weight: bold;
}
.hd-title {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
}
.hd-hold {
  width: 46px;
  height: 46px;
}

.sub-tip {
  width: 336px;
  text-align: center;
  font-size: 16px;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 2px;
}

/* 列表固定尺寸（非绝对定位），与元素页 .panel-list 同思路 */
.list {
  width: 304px;
  height: 400px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 8px;
}

/* 空态重试行 */
.retry-tap {
  width: 336px;
  text-align: center;
  font-size: 20px;
  color: #4da3ff;
  margin-top: 180px;
}

/* 所有行共用同一张卡片：标题行显示【分组名】，物质行左名称右化学式 */
.row {
  width: 304px;
  height: 48px;
  border-radius: 13px;
  background-color: #1c1c1e;
  margin-bottom: 6px;
  padding-left: 14px;
  padding-right: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.row-main {
  font-size: 20px;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.row-sub {
  font-size: 20px;
  font-weight: bold;
  color: rgba(255, 255, 255, 0.55);
}
</style>
