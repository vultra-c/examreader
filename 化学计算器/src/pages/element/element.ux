<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 元素查询页（336×480，闪念小抄风格）
  输入一个或多个元素（Fe O / 铁 氧 / 氧气 铁），
  本地检索同时含这些元素的方程式；支持中文名与英文符号混输。
  输入卡与「查询方程」按钮位于键盘遮挡区之上；结果区全部 absolute 顶层挂载。
-->
<template>
  <div class="page" @swipe="onSwipe">

    <!-- 输入卡（小抄深色大圆角卡片） -->
    <div class="input-card" @click="toggleKb">
      <text if="{{inputStr.length == 0}}" class="input-ph">输入元素或名称，空格分隔：Fe O / 铁 氧</text>
      <div if="{{inputStr.length > 0}}" class="value-row">
        <text class="input-value">{{inputStr}}</text>
        <text if="{{showKb}}" class="input-caret">_</text>
      </div>
    </div>

    <!-- 操作行（均在键盘遮挡区之上） -->
    <div class="btn-ghost btn-clear" @click="clearAll">
      <text class="btn-ghost-t">清空</text>
    </div>
    <div class="btn-main btn-search" @click="onSearch">
      <text class="btn-main-t">查询方程</text>
    </div>

    <!-- 结果区（小抄风格深色面板 + 80px 结果卡片；全部 absolute 顶层挂载） -->
    <div show="{{searched}}" class="panel-bg"></div>
    <text show="{{searched}}" class="panel-hd-t">匹配方程式</text>
    <text show="{{searched}}" class="panel-hd-n">{{elementResults.length}} 条</text>
    <text show="{{searched && elementResults.length == 0}}" class="panel-none">没有同时含这些元素的方程式</text>
    <list show="{{searched && elementResults.length > 0}}" class="eq-list" onscrollbottom="onReachBottom">
      <list-item for="{{visibleResults}}" tid="rid" type="eq" class="eq-item" @click="openEquation($item)">
        <div class="eq-content">
          <text class="eq-item-text">{{$item.text}}</text>
          <text class="eq-item-type">{{$item.type}}</text>
        </div>
      </list-item>
      <list-item if="{{hasMoreRes}}" type="more" class="eq-more" @click="onReachBottom">
        <div class="eq-more-content">
          <text class="more-text">▼ 还有 {{elementResults.length - visibleResults.length}} 条，上滑加载</text>
        </div>
      </list-item>
    </list>
    <text if="{{!searched}}" class="panel-idle">点击输入框输入，如：Fe O 或 铁 氧</text>

    <!-- 顶栏（闪念小抄同款） -->
    <img static src="/common/images/hd.png" class="hd-bg" />
    <img static src="/common/images/back.png" class="hd-back" @click="goBack" />
    <text static class="hd-sub">按元素检索</text>
    <text static class="hd-title">元素查询</text>

    <!-- 共享输入法 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="8"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { parseElementQuery, searchEquations, buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'
import { NAME_MAP } from '../../common/logic/substances.js'

// 分块渲染：首屏 15 条，滚动到底追加 15 条（Vela 文档：长列表应分页避免首屏卡顿）
const RES_CHUNK = 15

export default {
  private: {
    inputStr: '',
    showKb: false,
    searched: false,
    elementResults: [],
    visibleResults: [],
    renderPos: 0,
    hasMoreRes: false
  },

  toggleKb() {
    this.showKb = !this.showKb
  },

  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch || this.inputStr.length >= 40) return

    // 中文名称：直接追加（铁、氧气、碳酸钙 …）
    if (/[\u4e00-\u9fa5]/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 字母/数字：原样追加
    if (/^[A-Za-z0-9]$/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 分隔符：空格 / 加号 / 逗号（含全角）→ 折叠为单个空格
    if (/^[ +，,＋]$/.test(ch)) {
      if (this.inputStr && this.inputStr.slice(-1) !== ' ') this.inputStr += ' '
      return
    }
    // 其他符号按分隔处理
    if (this.inputStr && this.inputStr.slice(-1) !== ' ') this.inputStr += ' '
  },

  onDel() {
    if (this.inputStr.length > 0) {
      this.inputStr = this.inputStr.slice(0, -1)
    }
  },

  clearAll() {
    this.inputStr = ''
    this.showKb = false
    this.searched = false
    this.elementResults = []
    this.visibleResults = []
    this.renderPos = 0
    this.hasMoreRes = false
  },

  onReachBottom() {
    if (!this.hasMoreRes || !this.elementResults.length) return
    const end = Math.min(this.renderPos + RES_CHUNK, this.elementResults.length)
    this.visibleResults = this.visibleResults.concat(this.elementResults.slice(this.renderPos, end))
    this.renderPos = end
    this.hasMoreRes = this.renderPos < this.elementResults.length
  },

  onSearch() {
    this.showKb = false
    let query = null
    try {
      query = parseElementQuery(this.inputStr, NAME_MAP)
    } catch (err) {
      prompt.showToast({ message: '查询出错', duration: 2000 })
      return
    }
    if (!query.ok) { prompt.showToast({ message: query.error, duration: 2000 }); return }

    let hits = []
    try {
      hits = searchEquations(query.elems, 50)
    } catch (err) {
      hits = []
    }
    const rows = []
    for (let i = 0; i < hits.length; i++) {
      rows.push({ text: equationText(hits[i]), type: hits[i].t, entry: hits[i], rid: 'e' + i })
    }
    this.elementResults = rows
    this.visibleResults = rows.slice(0, RES_CHUNK)
    this.renderPos = Math.min(RES_CHUNK, rows.length)
    this.hasMoreRes = rows.length > RES_CHUNK
    this.searched = true
    if (rows.length === 0) prompt.showToast({ message: '未找到匹配方程式', duration: 1800 })
  },

  openEquation(item) {
    try {
      this.$app.$def.reaction = buildReactionFromBank(item.entry)
    } catch (err) {
      prompt.showToast({ message: '打开失败', duration: 1500 })
      return
    }
    router.push({ uri: 'pages/result' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb) this.showKb = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

<style>
@import '../../common/style.css';

/* ---- 输入卡（键盘遮挡区之上） ---- */
.input-card {
  position: absolute;
  left: 6px;
  top: 104px;
  width: 324px;
  height: 76px;
  border-radius: 36px;
  background-color: #262626;
  padding: 10px 20px;
  justify-content: center;
}
.input-ph {
  font-size: 22px;
  line-height: 28px;
  color: rgba(255, 255, 255, 0.38);
}
.value-row {
  width: 284px;
  flex-direction: row;
}
.input-value {
  width: 266px;
  font-size: 26px;
  line-height: 32px;
  color: #ffffff;
  lines: 2;
  text-overflow: ellipsis;
}
.input-caret {
  font-size: 26px;
  color: #0d84ff;
}

/* ---- 操作行（bottom <= 252） ---- */
.btn-clear {
  position: absolute;
  left: 6px;
  top: 188px;
  width: 86px;
  height: 56px;
  border-radius: 28px;
}
.btn-search {
  position: absolute;
  left: 100px;
  top: 188px;
  width: 230px;
  height: 56px;
  border-radius: 28px;
}
.btn-clear .btn-ghost-t {
  font-size: 24px;
}
.btn-search .btn-main-t {
  font-size: 26px;
}

/* ---- 结果区（小抄深色面板 + 结果卡片；absolute 顶层挂载，list 不参与 flex 测量） ---- */
.panel-bg {
  position: absolute;
  left: 6px;
  top: 258px;
  width: 324px;
  height: 216px;
  border-radius: 36px;
  background-color: #262626;
}
.panel-hd-t {
  position: absolute;
  left: 26px;
  top: 266px;
  width: 180px;
  font-size: 24px;
  line-height: 30px;
  font-weight: bold;
  color: #ffffff;
}
.panel-hd-n {
  position: absolute;
  left: 214px;
  top: 268px;
  width: 96px;
  font-size: 20px;
  line-height: 26px;
  text-align: right;
  color: #4da3ff;
}
.panel-none {
  position: absolute;
  left: 26px;
  top: 340px;
  width: 284px;
  text-align: center;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.4);
}
.eq-list {
  position: absolute;
  left: 6px;
  top: 302px;
  width: 324px;
  height: 166px;
  padding: 0px 12px;
}
/* list-item：小抄搜索结果风（80px 卡片）；静态 class + 显式行高，内容 div 包裹 */
.eq-item {
  width: 100%;
  height: 62px;
  padding: 6px 16px;
  margin-bottom: 7px;
  border-radius: 24px;
  background-color: #333333;
}
.eq-content {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
}
.eq-item-text {
  width: 100%;
  font-size: 21px;
  line-height: 26px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}
.eq-item-type {
  font-size: 16px;
  line-height: 20px;
  color: #4da3ff;
  margin-top: 1px;
}
.eq-more {
  width: 100%;
  height: 44px;
  margin-bottom: 7px;
}
.eq-more-content {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}
.more-text {
  font-size: 17px;
  color: rgba(255, 255, 255, 0.35);
}
.panel-idle {
  position: absolute;
  left: 0px;
  top: 340px;
  width: 336px;
  text-align: center;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.3);
}
</style>
