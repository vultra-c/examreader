  width: 304px;
  height: 50px;
  margin: 8px 16px 0;
  flex-direction: row;
  justify-content: space-between;
}
.btn-clear {
  width: 86px;
  height: 50px;
  border-radius: 25px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
}
