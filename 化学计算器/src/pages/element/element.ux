<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<!--
  化学工具箱 · 元素查询页（336×480）
  输入一个或多个元素（Fe O / 铁 氧 / 氧气 铁），
  本地检索同时含这些元素的方程式；支持中文名与英文符号混输。
  输入卡与「查询方程」按钮均位于键盘遮挡区之上。
-->
<template>
  <div class="screen" @swipe="onSwipe">

    <!-- 顶栏 -->
    <div class="hd">
      <div class="hd-back" @click="goBack"><text class="hd-back-t">‹</text></div>
      <text class="hd-title">元素查询</text>
      <div class="hd-hold"></div>
    </div>

    <!-- 输入卡 -->
    <div class="input-card" @click="toggleKb">
      <text if="{{inputStr.length == 0}}" class="input-ph">输入元素或名称，空格分隔：Fe O / 铁 氧</text>
      <div if="{{inputStr.length > 0}}" class="value-row">
        <text class="input-value">{{inputStr}}</text>
        <text if="{{showKb}}" class="input-caret">_</text>
      </div>
    </div>

    <!-- 操作行 -->
    <div class="act-row">
      <div class="btn-clear" @click="clearAll">
        <text class="btn-clear-t">清空</text>
      </div>
      <div class="btn-search" @click="onSearch">
        <text class="btn-search-t">查询方程</text>
      </div>
    </div>

    <!-- 结果面板 -->
    <div if="{{searched}}" class="panel">
      <div class="panel-hd">
        <text class="panel-hd-t">匹配方程式</text>
        <text class="panel-hd-n">{{elementResults.length}} 条</text>
      </div>
      <text if="{{elementResults.length == 0}}" class="panel-none">没有同时含这些元素的方程式</text>
      <scroll if="{{elementResults.length > 0}}" scroll-y="true" class="panel-list">
        <div class="eq-item" for="{{elementResults}}" tid="rid" @click="openEquation($item)">
          <text class="eq-item-text">{{$item.text}}</text>
          <text class="eq-item-type">{{$item.type}}</text>
        </div>
      </scroll>
    </div>
    <text if="{{!searched}}" class="panel-idle">点击输入框输入，如：Fe O 或 铁 氧</text>

    <!-- 共享输入法 -->
    <input-method hide="{{!showKb}}" keyboardtype="QWERTY" screentype="rect" maxlength="8"
      vibratemode="short" @complete="onInput" @delete="onDel"></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { parseElementQuery, searchEquations, buildReactionFromBank, equationText } from '../../common/logic/elementQuery.js'
import { NAME_MAP } from '../../common/logic/substances.js'

export default {
  private: {
    inputStr: '',
    showKb: false,
    searched: false,
    elementResults: []
  },

  toggleKb() {
    this.showKb = !this.showKb
  },

  onInput(e) {
    if (!e || !e.detail) return
    const ch = String(e.detail.content || '')
    if (!ch || this.inputStr.length >= 40) return

    // 中文名称：直接追加（铁、氧气、碳酸钙 …）
    if (/[\u4e00-\u9fa5]/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 字母/数字：原样追加
    if (/^[A-Za-z0-9]$/.test(ch)) {
      this.inputStr += ch
      return
    }
    // 分隔符：空格 / 加号 / 逗号（含全角）→ 折叠为单个空格
    if (/^[ +，,＋]$/.test(ch)) {
      if (this.inputStr && this.inputStr.slice(-1) !== ' ') this.inputStr += ' '
      return
    }
    // 其他符号按分隔处理
    if (this.inputStr && this.inputStr.slice(-1) !== ' ') this.inputStr += ' '
  },

  onDel() {
    if (this.inputStr.length > 0) {
      this.inputStr = this.inputStr.slice(0, -1)
    }
  },

  clearAll() {
    this.inputStr = ''
    this.showKb = false
    this.searched = false
    this.elementResults = []
  },

  onSearch() {
    this.showKb = false
    const query = parseElementQuery(this.inputStr, NAME_MAP)
    if (!query.ok) { prompt.showToast({ message: query.error, duration: 2000 }); return }

    let hits = []
    try {
      hits = searchEquations(query.elems, 50)
    } catch (err) {
      hits = []
    }
    const rows = []
    for (let i = 0; i < hits.length; i++) {
      rows.push({ text: equationText(hits[i]), type: hits[i].t, entry: hits[i], rid: 'e' + i })
    }
    this.elementResults = rows
    this.searched = true
    if (rows.length === 0) prompt.showToast({ message: '未找到匹配方程式', duration: 1800 })
  },

  openEquation(item) {
    this.$app.$data.reaction = buildReactionFromBank(item.entry)
    router.push({ uri: 'pages/result' })
  },

  goBack() { router.back() },

  onSwipe(e) {
    if (e && e.direction === 'right') {
      if (this.showKb) this.showKb = false
      else router.back()
    }
  },
  onBackPress() {
    router.back()
    return true
  }
}
</script>

